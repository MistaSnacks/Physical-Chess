---
// Nav.astro — Roda Quest header. Highlights the active screen via
// aria-current so theme.css can style it. The right-hand slot is a player
// chip once a session exists (filled by src/lib/nav.js), else "Log in".

interface Props {
  active?: 'home' | 'journey' | 'movements' | 'music' | 'culture' | 'graduation' | 'batizado' | 'me' | 'family' | 'coach' | 'who';
}

const { active } = Astro.props;

const LINKS = [
  { id: 'journey', href: '/journey', label: 'My Journey' },
  { id: 'movements', href: '/learn/movements', label: 'Movements' },
  { id: 'music', href: '/learn/music', label: 'Music' },
  { id: 'batizado', href: '/batizado', label: 'Batizado' },
];
---

<header class="quest-nav" data-quest-enter>
  <a class="quest-nav__brand" href="/">
    <span class="quest-nav__mark">
      <svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <circle cx="13" cy="4" r="2" fill="none" stroke="#FFF6E5" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M4 20l4-5 3 1 2-5 4 2 3-4" fill="none" stroke="#FFF6E5" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M8 15l-1 6" fill="none" stroke="#FFF6E5" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    <span class="quest-nav__wordmark">PHYSICAL CHESS</span>
  </a>

  <nav class="quest-nav__links" aria-label="Roda Quest screens">
    {
      LINKS.map((link) => (
        <a class="quest-nav__link" href={link.href} aria-current={active === link.id ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="quest-nav__session" data-nav-session>
    <a class="quest-nav__cta" href="/login" data-nav-login>Log in</a>
    <a class="quest-nav__chip" href="/who" data-nav-chip hidden>
      <span class="quest-nav__chip-avatar" data-nav-avatar></span>
      <span class="quest-nav__chip-name" data-nav-name></span>
    </a>
    <a class="quest-nav__coach" href="/coach" data-nav-coach hidden>Coach</a>
  </div>
</header>

<script>
  import '../../lib/nav.js';
</script>
