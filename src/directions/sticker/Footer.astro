---
// Footer.astro — Sticker Roda footer. ACE contact block + credit line.
import { CONTACT } from '../../data/batizado.js';
---

<footer class="sr-footer">
  <div class="sr-footer__inner wrap">
    <div class="sr-footer__brand">
      <span class="sr-footer__badge" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24">
          <circle cx="12" cy="5" r="2.6" fill="var(--color-white)" />
          <path d="M12 8 L12 14 M12 10 L6 7 M12 10 L18 13 M12 14 L7 20 M12 14 L17 19" fill="none" stroke="var(--color-white)" stroke-width="2.4" stroke-linecap="round" />
        </svg>
      </span>
      <p class="sr-footer__name">Physical Chess</p>
    </div>

    <div class="sr-footer__contact">
      <p><a href={`tel:${CONTACT.phone.replace(/[^0-9+]/g, '')}`}>{CONTACT.phone}</a></p>
      <p><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
      <p class="sr-footer__age">{CONTACT.ageLine}</p>
    </div>

    <div class="sr-footer__meta">
      <p>A program by ACE &amp; ABADÁ-Capoeira Brooklyn.</p>
      <p class="sr-footer__credit">Video: SoChlo Productions</p>
    </div>
  </div>
</footer>
