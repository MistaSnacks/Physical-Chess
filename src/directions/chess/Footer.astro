---
// Footer.astro — ACE contact block styled as a closing scoresheet line.
import { CONTACT } from '../../data/batizado.js';
---

<footer class="chess-footer">
  <div class="wrap chess-footer__inner">
    <div class="chess-footer__brand">PHYSICAL CHESS</div>
    <div class="chess-footer__contact">
      <a href="tel:9177768150">{CONTACT.phone}</a>
      <span class="chess-footer__dot" aria-hidden="true">&middot;</span>
      <a href="mailto:info@the-ace.org">{CONTACT.email}</a>
      <span class="chess-footer__dot" aria-hidden="true">&middot;</span>
      <span>{CONTACT.ageLine}</span>
    </div>
    <div class="chess-footer__credit">Video: SoChlo Productions</div>
  </div>
</footer>
