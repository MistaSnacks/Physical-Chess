---
// Footer.astro — black caption bar with the ACE contact info, matching the
// dashboard's corda-meter black bar language (SPEC §5.3).
import { CONTACT } from '../../data/batizado.js';
---

<footer class="cx-footer">
  <div class="cx-footer__inner wrap">
    <p class="cx-footer__title">PHYSICAL CHESS</p>
    <p class="cx-footer__line">
      A project of ACE / Abadá Capoeira Brooklyn · {CONTACT.ageLine}
    </p>
    <p class="cx-footer__line">
      <a class="cx-footer__link" href={`tel:${CONTACT.phone.replace(/[^\d+]/g, '')}`}>{CONTACT.phone}</a>
      <span aria-hidden="true"> · </span>
      <a class="cx-footer__link" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
    </p>
  </div>
</footer>
