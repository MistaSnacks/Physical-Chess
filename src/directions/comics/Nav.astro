---
// Nav.astro — Axé Comics masthead: logo lockup + "ISSUE #4 · MAYA" /
// "LOG OUT" chips (top row, per Paper EF-0), plus a second row of
// chapter-tab links to the five screens (comic-strip register, not shown
// literally in the Paper mock — extrapolated per SPEC §2).
//
// Props:
//   active — 'home' | 'dashboard' | 'movements' | 'music' | 'batizado'

interface Props {
  active: 'home' | 'dashboard' | 'movements' | 'music' | 'batizado';
}

import Halftone from './Halftone.astro';

const { active } = Astro.props;

const TABS = [
  { id: 'home', label: 'Home', href: '/comics/' },
  { id: 'dashboard', label: 'My Journey', href: '/comics/dashboard' },
  { id: 'movements', label: 'Movements', href: '/comics/movements' },
  { id: 'music', label: 'Music', href: '/comics/music' },
  { id: 'batizado', label: 'Batizado', href: '/comics/batizado' },
];
---

<header class="cx-nav">
  <div class="cx-nav__top wrap">
    <Halftone width={320} height={110} class="cx-nav-halftone" />
    <a class="cx-nav__brand" href="/comics/" aria-label="Physical Chess home">
      <span class="cx-nav__mark" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <circle cx="13" cy="4" r="2" fill="none" stroke="#FFFFFF" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M4 20l4-5 3 1 2-5 4 2 3-4" fill="none" stroke="#FFFFFF" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M8 15l-1 6" fill="none" stroke="#FFFFFF" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="cx-nav__word">PHYSICAL CHESS</span>
    </a>
    <div class="cx-nav__right">
      <span class="cx-chip cx-chip--outline cx-nav__issue">ISSUE #4 · MAYA</span>
      <a class="cx-chip cx-chip--dark" href="/">LOG OUT</a>
    </div>
  </div>
  <nav class="cx-nav__tabs wrap" aria-label="Screens">
    {
      TABS.map((tab, i) => (
        <a
          class:list={['cx-tab', { 'cx-tab--active': tab.id === active }]}
          href={tab.href}
          style={`--cx-tab-tilt:${i % 2 === 0 ? '-1' : '1'}deg;`}
          aria-current={tab.id === active ? 'page' : undefined}
        >
          {tab.label}
        </a>
      ))
    }
  </nav>
</header>
