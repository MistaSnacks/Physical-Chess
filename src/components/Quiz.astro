---
// Quiz.astro — unstyled quiz markup + logic. One question shown at a time.
//
// Dispatches CustomEvents on the root `[data-quiz]` element (bubbles: true):
//   'quiz:correct' — detail: { id, index }        (a right answer was picked)
//   'quiz:wrong'   — detail: { id, index }         (a wrong answer was picked)
//   'quiz:done'    — detail: { score, total }      (last question answered)
//
// State is exposed via data attributes so each direction's theme.css /
// motion.js can react without owning the logic:
//   [data-quiz]                     data-state="active|correct|wrong|done"
//                                    data-index="<current question index>"
//                                    data-total="<question count>"
//                                    data-score="<correct answers so far>"
//   [data-quiz-question]            one per question; only the current one
//                                    is visible (others get [hidden])
//   [data-quiz-choice]               data-selected="true" once picked
//                                    data-correct="true|false" after answering
//   [data-quiz-next]                 advances to the next question / finish
//
// Class hooks only (no styling): .quiz, .quiz__question, .quiz__prompt,
// .quiz__choices, .quiz__choice, .quiz__feedback, .quiz__next, .quiz__done.
//
// Props:
//   questions — [{ id, prompt, choices: string[], correctIndex }]
//   title     — optional heading

interface QuizQuestion {
  id: string;
  prompt: string;
  choices: string[];
  correctIndex: number;
}

interface Props {
  questions: QuizQuestion[];
  title?: string;
  class?: string;
}

const { questions, title, class: className } = Astro.props;
---

<div
  class:list={['quiz', className]}
  data-quiz
  data-state="active"
  data-index="0"
  data-total={questions.length}
  data-score="0"
>
  {title && <h3 class="quiz__title">{title}</h3>}

  {
    questions.map((q, qIndex) => (
      <fieldset
        class="quiz__question"
        data-quiz-question
        data-question-id={q.id}
        data-question-index={qIndex}
        hidden={qIndex !== 0}
      >
        <legend class="quiz__prompt">{q.prompt}</legend>
        <div class="quiz__choices" role="radiogroup">
          {q.choices.map((choice, cIndex) => (
            <button
              type="button"
              class="quiz__choice"
              data-quiz-choice
              data-choice-index={cIndex}
              data-is-correct={cIndex === q.correctIndex}
              role="radio"
              aria-checked="false"
            >
              {choice}
            </button>
          ))}
        </div>
        <p class="quiz__feedback" data-quiz-feedback aria-live="polite"></p>
        <button type="button" class="quiz__next" data-quiz-next hidden>
          {qIndex === questions.length - 1 ? 'Finish' : 'Next question'}
        </button>
      </fieldset>
    ))
  }

  <div class="quiz__done" data-quiz-done hidden>
    <p class="quiz__done-message" data-quiz-score></p>
  </div>
</div>

<script>
  function initQuiz(root) {
    if (root.dataset.quizInit === 'true') return;
    root.dataset.quizInit = 'true';

    const questionEls = Array.from(root.querySelectorAll('[data-quiz-question]'));
    const doneEl = root.querySelector('[data-quiz-done]');
    const scoreEl = root.querySelector('[data-quiz-score]');
    const total = questionEls.length;
    let score = 0;

    function showQuestion(index) {
      questionEls.forEach((el, i) => {
        el.hidden = i !== index;
      });
      root.dataset.index = String(index);
      root.dataset.state = 'active';
    }

    function finish() {
      questionEls.forEach((el) => (el.hidden = true));
      if (doneEl) doneEl.hidden = false;
      if (scoreEl) scoreEl.textContent = `${score} / ${total} correct`;
      root.dataset.state = 'done';
      root.dispatchEvent(
        new CustomEvent('quiz:done', { detail: { score, total }, bubbles: true })
      );
    }

    questionEls.forEach((questionEl, qIndex) => {
      const id = questionEl.getAttribute('data-question-id') || '';
      const choices = Array.from(questionEl.querySelectorAll('[data-quiz-choice]'));
      const feedbackEl = questionEl.querySelector('[data-quiz-feedback]');
      const nextEl = questionEl.querySelector('[data-quiz-next]');
      let answered = false;

      choices.forEach((choiceEl) => {
        choiceEl.addEventListener('click', () => {
          if (answered) return;
          answered = true;

          const isCorrect = choiceEl.getAttribute('data-is-correct') === 'true';
          choices.forEach((c) => {
            c.setAttribute('aria-checked', c === choiceEl ? 'true' : 'false');
            c.dataset.selected = c === choiceEl ? 'true' : 'false';
            c.dataset.correct = c.getAttribute('data-is-correct') === 'true' ? 'true' : 'false';
            c.disabled = true;
          });

          if (isCorrect) {
            score += 1;
            root.dataset.score = String(score);
            root.dataset.state = 'correct';
            if (feedbackEl) feedbackEl.textContent = 'Correct!';
            root.dispatchEvent(
              new CustomEvent('quiz:correct', { detail: { id, index: qIndex }, bubbles: true })
            );
          } else {
            root.dataset.state = 'wrong';
            if (feedbackEl) feedbackEl.textContent = 'Not quite — try the next one.';
            root.dispatchEvent(
              new CustomEvent('quiz:wrong', { detail: { id, index: qIndex }, bubbles: true })
            );
          }

          if (nextEl) nextEl.hidden = false;
        });
      });

      if (nextEl) {
        nextEl.addEventListener('click', () => {
          const isLast = qIndex === total - 1;
          if (isLast) {
            finish();
          } else {
            showQuestion(qIndex + 1);
          }
        });
      }
    });

    showQuestion(0);
  }

  function init() {
    document.querySelectorAll('[data-quiz]').forEach((root) => initQuiz(root));
  }

  document.addEventListener('astro:page-load', init);
  init();
</script>
