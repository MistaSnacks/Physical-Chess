---
// turma.astro — weekly leaderboard + community berimbau (SPEC §4.7).
import { ClientRouter } from 'astro:transitions';
import Base from '../layouts/Base.astro';
import Nav from '../directions/quest/Nav.astro';
import Footer from '../directions/quest/Footer.astro';
import '../directions/quest/tokens.css';
import '../directions/quest/theme.css';
---

<Base title="Turma — Physical Chess" direction="quest">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <Nav active="journey" />
    <main class="quest-screen">
      <p class="quest-screen__eyebrow" data-quest-enter>Your turma</p>
      <h1 class="quest-screen__title" data-quest-enter>This week’s roda</h1>
      <p class="quest-screen__sub" data-quest-enter>Apelidos only. XP this week. Fill the berimbau together.</p>
      <div data-root></div>
    </main>
    <Footer />
  </div>
  <script>
    import '../directions/quest/motion.js';
    import { requireSession } from '../lib/auth-guard.js';
    import { store } from '../lib/store.js';
    import { getCoach } from '../lib/repo/coachRepo.js';
    import { weekXp } from '../lib/coach.js';
    import { avatarSvg } from '../lib/avatar.js';
    import { programByKey } from '../content/programs.js';

    function esc(s) {
      return String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    }

    async function init() {
      const s = await requireSession({ player: true });
      if (!s) return;
      const player = store.get().player;
      const account = store.get().session.account;
      const events = store.get().events;
      const program = player.program;
      const prog = programByKey(program);
      const root = document.querySelector('[data-root]');
      if (!program) {
        root.innerHTML = '<section class="quest-card quest-card--note">You are not in a program yet. Ask a grown-up to add the invite code.</section>';
        return;
      }
      const coach = await getCoach();
      const board = await coach.leaderboard({ program });
      const myXp = weekXp(events);
      const optedOut = account.leaderboardOptIn === false;
      const entries = (board.entries || []).slice(0, 10);
      const mine = entries.find((e) => e.playerId === player.id || e.apelido === player.apelido);
      if (!mine && !optedOut) entries.push({ apelido: player.apelido, avatar: player.avatar, xp: myXp, you: true });
      const target = board.target || 2500;
      const pct = Math.min(100, Math.round((board.communityXp / target) * 100));
      const dash = 2 * Math.PI * 54;
      const offset = dash * (1 - pct / 100);

      root.innerHTML = `
        <section class="quest-card quest-berimbau" data-quest-enter>
          <h2 class="quest-card__title">${esc(prog?.name || 'Turma')}</h2>
          <p class="quest-card__body">${esc(board.goalLabel || 'Fill the berimbau by Batizado')}</p>
          <svg class="quest-berimbau__svg" viewBox="0 0 140 140" aria-hidden="true">
            <circle cx="70" cy="70" r="54" fill="none" stroke="#1E5A46" stroke-width="12"/>
            <circle cx="70" cy="70" r="54" fill="none" stroke="#FFB238" stroke-width="12" stroke-linecap="round"
              stroke-dasharray="${dash}" stroke-dashoffset="${offset}" transform="rotate(-90 70 70)"/>
            <path d="M48 28c18 8 28 40 22 84" fill="none" stroke="#FFF6E5" stroke-width="4" stroke-linecap="round"/>
            <circle cx="48" cy="28" r="10" fill="#B9F26B"/>
          </svg>
          <p class="quest-berimbau__n">${board.communityXp} / ${target} XP this month</p>
        </section>
        ${optedOut ? '<section class="quest-card quest-card--note" data-quest-enter>Your family turned the leaderboard off. You still help fill the berimbau. A grown-up can turn names back on in Family settings.</section>' : ''}
        ${optedOut ? '' : `<section class="quest-card" data-quest-enter>
          <h2 class="quest-card__title">Top of the week</h2>
          <ol class="quest-lb">${entries.map((e, i) => {
            const you = e.you || e.playerId === player.id || e.apelido === player.apelido;
            return `<li class="quest-lb__row ${you ? 'is-you' : ''}">
              <span class="quest-lb__rank">${i + 1}</span>
              <span class="quest-lb__ava">${avatarSvg(e.avatar, 40)}</span>
              <span class="quest-lb__name">${esc(e.apelido)}${you ? ' · you' : ''}</span>
              <span class="quest-lb__xp">${e.xp} XP</span>
            </li>`;
          }).join('')}</ol>
        </section>`}
      `;
    }
    document.addEventListener('astro:page-load', init);
    init();
  </script>
</Base>
