---
// journey.astro — "My Journey". The map is the dashboard: SVG trail through
// four modules, HUD, and a gate. Node/dot/gate state is painted at runtime
// from the live snapshot (WP3).
import { ClientRouter } from 'astro:transitions';
import Base from '../layouts/Base.astro';
import Nav from '../directions/quest/Nav.astro';
import Footer from '../directions/quest/Footer.astro';
import YouTube from '../components/YouTube.astro';
import Hud from '../components/quest/Hud.astro';
import LevelUp from '../components/quest/LevelUp.astro';
import PatchUnlock from '../components/quest/PatchUnlock.astro';
import { MODULES } from '../content/modules.js';
import { wix, yt } from '../data/media.js';
import { MODULE_STOPS, GATE_PROGRESS, DESKTOP_TRAIL, MOBILE_TRAIL, lessonTrailItems } from '../lib/map.js';

import '../directions/quest/tokens.css';
import '../directions/quest/theme.css';

const allLessons = lessonTrailItems();
const CHECK = '<svg width="46" height="46" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7" fill="none" stroke="#0B2E24" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const LOCK = '<svg width="40" height="40" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2" fill="none" stroke="#7FA894" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 11V7a4 4 0 0 1 8 0v4" fill="none" stroke="#7FA894" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const GATE = '<svg width="60" height="60" viewBox="0 0 24 24"><path d="M6 3h12l2 7-8 11L4 10z" fill="none" stroke="#0B2E24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 10h16M9 3l3 7 3-7M9 10l3 11 3-11" fill="none" stroke="#0B2E24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---

<Base title="My Journey — Physical Chess" direction="quest">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <div class="quest-stagelight quest-stagelight--b" aria-hidden="true"></div>
    <svg class="quest-stars" aria-hidden="true">
      <circle cx="52%" cy="9%" r="3" fill="#FFF6E5" />
      <circle cx="66%" cy="17%" r="2" fill="#FFF6E5" />
      <circle cx="80%" cy="7%" r="2.5" fill="#FFF6E5" />
      <circle cx="92%" cy="14%" r="3" fill="#FFF6E5" />
      <circle cx="97%" cy="4%" r="2" fill="#FFF6E5" />
      <circle cx="42%" cy="47%" r="2" fill="#FFF6E5" />
      <circle cx="86%" cy="58%" r="2" fill="#FFF6E5" />
      <circle cx="57%" cy="96%" r="2.5" fill="#FFF6E5" />
      <circle cx="76%" cy="89%" r="2" fill="#FFF6E5" />
      <circle cx="33%" cy="78%" r="2" fill="#FFF6E5" />
    </svg>

    <Nav active="journey" />

    <main class="quest-map-wrap" data-quest-map>
      <div class="quest-map-header">
        <p class="quest-map-header__eyebrow" data-quest-enter>Level <span data-bind="level.level">1</span> · Corda <span data-corda-label>Crua</span></p>
        <h1 class="quest-map-header__title" data-quest-enter>Road to the Roda</h1>
        <p class="quest-map-header__sub" data-quest-enter>
          <span data-bind="lessonsDone">0</span> of <span data-bind="lessonsTotal">0</span> lessons cleared across the roda. Keep moving, capoeirista.
        </p>
      </div>

      <div class="quest-map-body">
      <div class="quest-map-left">
      <Hud />

      <div class="quest-map-mobile" aria-label="Curriculum map">
        <svg class="quest-map-mobile__svg" viewBox="0 0 350 1080" preserveAspectRatio="none" aria-hidden="true">
          <path class="quest-trail-path quest-trail-path--dashed" d={MOBILE_TRAIL} />
          <path class="quest-trail-path quest-trail-path--glow" d={MOBILE_TRAIL} pathLength="100" stroke-dasharray="4 100" />
          <path class="quest-trail-path quest-trail-path--cleared" d={MOBILE_TRAIL} pathLength="100" stroke-dasharray="4 100" />
          <path class="quest-trail-guide" d={MOBILE_TRAIL} data-quest-trail-guide />
        </svg>

        <div class="quest-map-mobile__dots" aria-hidden="true">
          {allLessons.map((item) => (
            <span
              class="quest-lesson-dot quest-lesson-dot--mobile quest-lesson-dot--open"
              data-quest-lesson-dot
              data-lesson-id={item.lesson.id}
              data-path-progress={item.progress}
              data-stars="0"
            >
              <span class="quest-lesson-dot__pips">
                <span data-pip></span><span data-pip></span><span data-pip></span>
              </span>
            </span>
          ))}
        </div>

        {MODULES.map((mod) => (
          <a
            class="quest-map-mobile__node quest-map-mobile__node--open"
            href={`/learn/${mod.id}`}
            data-quest-node
            data-module-id={mod.id}
            data-map-progress={MODULE_STOPS[mod.id]}
            data-label-base={mod.title}
          >
            <span class="quest-map-mobile__flag">NEXT UP</span>
            <span class="quest-map-mobile__halo">
              <span class="quest-map-mobile__circle">
                <img class="quest-map-mobile__photo" src={wix(mod.photoKey, 180, 180)} alt="" loading="lazy" />
                <span class="quest-map-mobile__check" set:html={CHECK} />
                <span class="quest-node__lock" set:html={LOCK} />
                <span class="quest-node__badge" data-node-badge></span>
              </span>
            </span>
            <span class="quest-map-mobile__copy">
              <span class="quest-map-mobile__label" data-node-label>{mod.title}</span>
              <span class="quest-map-mobile__tag" data-node-tag></span>
            </span>
          </a>
        ))}

        <div class="quest-map-mobile__gate quest-gate--dim" data-quest-node data-map-progress={GATE_PROGRESS} data-gate>
          <div class="quest-map-mobile__gate-shape" set:html={GATE} />
          <span class="quest-map-mobile__gate-label" data-gate-label>CORDA CRUA-AMARELA</span>
        </div>
      </div>

      <a class="quest-nextup" href="/journey" data-nextup data-quest-enter hidden>
        <span class="quest-nextup__play">
          <svg width="20" height="20" viewBox="0 0 24 24"><path d="M6 3l14 9-14 9z" fill="#FFB238" /></svg>
        </span>
        <span class="quest-nextup__text">
          <span class="quest-nextup__eyebrow">NEXT UP</span>
          <span class="quest-nextup__title" data-nextup-title></span>
        </span>
      </a>

      <article class="quest-latest" data-quest-enter>
        <div class="quest-latest__copy">
          <span class="quest-latest__eyebrow">LATEST FROM THE RODA</span>
          <span class="quest-latest__title">Brooklyn in motion</span>
        </div>
        <YouTube id={yt('acb2024')} title="Abadá Capoeira Brooklyn 2024" />
      </article>
      </div>

      <div class="quest-trail-area">
        <svg class="quest-trail-svg" viewBox="0 0 960 720" preserveAspectRatio="none" aria-hidden="true">
          <path class="quest-trail-path quest-trail-path--dashed" d={DESKTOP_TRAIL} />
          <path class="quest-trail-path quest-trail-path--glow" d={DESKTOP_TRAIL} pathLength="100" stroke-dasharray="4 100" />
          <path class="quest-trail-path quest-trail-path--cleared" d={DESKTOP_TRAIL} pathLength="100" stroke-dasharray="4 100" />
          <path class="quest-trail-guide" d={DESKTOP_TRAIL} data-quest-trail-guide />
        </svg>

        <div class="quest-lesson-dots" aria-hidden="true">
          {allLessons.map((item) => (
            <span
              class="quest-lesson-dot quest-lesson-dot--open"
              data-quest-lesson-dot
              data-lesson-id={item.lesson.id}
              data-path-progress={item.progress}
              data-stars="0"
            >
              <span class="quest-lesson-dot__pips">
                <span data-pip></span><span data-pip></span><span data-pip></span>
              </span>
            </span>
          ))}
        </div>

        {MODULES.map((mod) => (
          <a
            class="quest-node quest-node--open"
            href={`/learn/${mod.id}`}
            data-quest-node
            data-module-id={mod.id}
            data-map-progress={MODULE_STOPS[mod.id]}
            data-label-base={mod.title}
          >
            <span class="quest-node__flag">
              <span class="quest-node__flag-text">NEXT UP</span>
              <svg class="quest-node__flag-tail" width="22" height="14" viewBox="0 0 22 14"><path d="M0 0h22L11 14z" fill="#FFF6E5" /></svg>
            </span>
            <span class="quest-node__halo">
              <span class="quest-node__circle">
                <img class="quest-node__photo" src={wix(mod.photoKey, 240, 240)} alt="" loading="lazy" />
                <span class="quest-node__check" set:html={CHECK} />
                <span class="quest-node__lock" set:html={LOCK} />
                <span class="quest-node__badge" data-node-badge></span>
              </span>
            </span>
            <span class="quest-node__label" data-node-label>{mod.title}</span>
          </a>
        ))}

        <div class="quest-gate quest-gate--dim" data-quest-node data-map-progress={GATE_PROGRESS} data-gate>
          <div class="quest-gate__shape" set:html={GATE} />
          <span class="quest-gate__label" data-gate-label>CORDA CRUA-AMARELA</span>
        </div>
      </div>
      </div>
    </main>

    <Footer />
    <LevelUp />
    <PatchUnlock />
  </div>
</Base>

<script>
  import '../directions/quest/motion.js';
  import { requireSession } from '../lib/auth-guard.js';
  import { bindDom } from '../lib/store.js';
  import { bindMap, bindHud } from '../lib/map.js';

  async function init() {
    const s = await requireSession({ player: true });
    if (!s) return;
    bindDom();
    bindHud();
    bindMap();
    if (s.isDemo && !document.querySelector('.quest-demo-badge')) {
      const b = document.createElement('div');
      b.className = 'quest-demo-badge';
      b.textContent = 'Demo';
      document.body.appendChild(b);
    }
  }
  document.addEventListener('astro:page-load', init);
  init();
</script>
