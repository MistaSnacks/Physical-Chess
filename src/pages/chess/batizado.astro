---
// batizado.astro — Graduation / Batizado. Countdown, the six ceremony
// moments (verbatim copy) laid on a board grid, cordas as promotions,
// a ≥12-photo gallery on alternating squares, and the three Batizado
// videos (SPEC §2 row 5, §4.3).
import Base from '../../layouts/Base.astro';
import { ClientRouter } from 'astro:transitions';
import Nav from '../../directions/chess/Nav.astro';
import Footer from '../../directions/chess/Footer.astro';
import Countdown from '../../components/Countdown.astro';
import Gallery from '../../components/Gallery.astro';
import YouTube from '../../components/YouTube.astro';
import { INTRO, MOMENTS, CORDAS, BATIZADO_DATE, BATIZADO_DATE_TBC } from '../../data/batizado.js';
import { STUDENT } from '../../data/student.js';
import { wix, yt } from '../../data/media.js';
import { pieceInner } from '../../directions/chess/pieces.js';
import '../../directions/chess/tokens.css';
import '../../directions/chess/theme.css';

const promo = CORDAS.map((c) => ({
  ...c,
  isCurrent: c.id === STUDENT.corda,
  isNext: c.id === STUDENT.nextCorda,
}));

const galleryPhotos = [
  'guindasteTubarao',
  'cocoTubarao',
  'kidsParents',
  'voltaDoMundo',
  'toroMindinha',
  'trocaDeCordas',
  'voltaAdults',
  'celebration2018',
  'cordsTable2018',
  'batizado2019a',
  'batizado2019b',
  'groupFoto2019',
  'xampuGasparzinho',
  'batizado2022',
];

const videos = [
  { key: 'batizado2026', label: 'Batizado 2026' },
  { key: 'batizado2025', label: 'Batizado 2025' },
  { key: 'batizado2024', label: 'Batizado 2024' },
];
---

<Base title="Graduation / Batizado — Physical Chess" direction="chess">
  <Fragment slot="head">
    <ClientRouter />
  </Fragment>

  <Nav active="batizado" />

  <section class="chess-section">
    <div class="chess-section__head chess-fade-up">
      <p class="chess-eyebrow">Graduation</p>
      <h1 class="chess-h2">Batizado 2026.</h1>
      <p class="chess-lede">{INTRO}</p>
      <div class="chess-countdown" style="margin-top:20px;">
        <Countdown target={BATIZADO_DATE} dateTbc={BATIZADO_DATE_TBC} />
      </div>
    </div>

    <div class="chess-fade-up" style="margin-bottom:56px;">
      <h2 class="chess-h3" style="margin-bottom:20px;">The Six Moments</h2>
      <div class="chess-moments-board">
        {
          MOMENTS.map((moment, i) => (
            <>
              <div class="chess-moment-cell chess-moment-cell--photo">
                <img src={wix(moment.photoKey, 500, 500)} alt={moment.title} loading="lazy" width="500" height="500" />
              </div>
              <div class:list={['chess-moment-cell', 'chess-moment-cell--caption', i % 2 === 0 && 'chess-moment-cell--dark']}>
                <span class="chess-moment-cell__num">{i + 1}.</span>
                <h3 class="chess-moment-cell__title">{moment.title}</h3>
                <p class="chess-moment-cell__copy">{moment.copy}</p>
              </div>
            </>
          ))
        }
      </div>
    </div>

    <div class="chess-fade-up" style="margin-bottom:56px;">
      <h2 class="chess-h3" style="margin-bottom:20px;">Cordas — The Promotions</h2>
      <div class="chess-promo-track">
        {
          promo.map((c) => (
            <div
              class:list={[
                'chess-promo-track__item',
                c.isCurrent && 'chess-promo-track__item--current',
                c.isNext && 'chess-promo-track__item--next',
              ]}
            >
              <div
                class="chess-promo-track__icon"
                set:html={`<svg width="${c.isNext ? 54 : 40}" height="${c.isNext ? 54 : 40}" viewBox="0 0 24 24" fill="${c.isCurrent || c.isNext ? '#F3EEE4' : '#0F0F0F'}">${pieceInner(c.pieceMapping)}</svg>`}
              />
              <div class="chess-promo-track__label">
                {c.label}
                {c.isCurrent ? ' · YOU' : c.isNext ? ' · NEXT' : ''}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="chess-fade-up" style="margin-bottom:56px;">
      <h2 class="chess-h3" style="margin-bottom:20px;">From the Roda</h2>
      <Gallery photos={galleryPhotos} width={400} height={400} eager={4} class="chess-gallery-board" />
    </div>

    <div class="chess-fade-up">
      <h2 class="chess-h3" style="margin-bottom:20px;">Batizado Media</h2>
      <div class="chess-video-row">
        {
          videos.map((v) => (
            <div class="chess-video-card">
              <span class="chess-video-card__label">{v.label}</span>
              <div class="chess-frame">
                <YouTube id={yt(v.key)} title={`${v.label} — Abadá Capoeira NYC`} />
              </div>
              <p class="chess-media-credit">Video: SoChlo Productions</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Footer />

  <script>
    import '../../directions/chess/motion.js';
  </script>
</Base>
