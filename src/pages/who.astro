---
// who.astro — "Who's playing?" (SPEC §5.2). Player cards with level from
// each child's snapshot. Grown-ups link is gated with a 2-digit math check.
import { ClientRouter } from 'astro:transitions';
import Base from '../layouts/Base.astro';
import Nav from '../directions/quest/Nav.astro';
import Footer from '../directions/quest/Footer.astro';
import PlayerCard from '../components/quest/PlayerCard.astro';
import '../directions/quest/tokens.css';
import '../directions/quest/theme.css';
---

<Base title="Who's playing? — Physical Chess" direction="quest">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <div class="quest-stagelight quest-stagelight--b" aria-hidden="true"></div>
    <Nav active="who" />
    <main id="main" class="quest-screen quest-who">
      <p class="quest-screen__eyebrow" data-quest-enter>Family</p>
      <h1 class="quest-screen__title" data-quest-enter>Who's playing?</h1>
      <p class="quest-screen__sub" data-quest-enter>Choose your card to open your map. Your next quest is waiting.</p>
      <div class="quest-players quest-who__players" data-players data-quest-enter aria-busy="true">
        <PlayerCard />
      </div>
      <p class="quest-empty" data-empty hidden>No players yet. A grown-up can add the first card.</p>
      <p class="quest-who__grownups" data-quest-enter>
        <button class="quest-btn quest-btn--ghost" type="button" data-grownups>Grown-up controls</button>
      </p>
    </main>
    <Footer />
  </div>
  <script>
    import '../directions/quest/motion.js';
    import { requireSession } from '../lib/auth-guard.js';
    import { selectPlayer, snapshotsForSession } from '../lib/actions.js';
    import { playerCardEl } from '../lib/player-card.js';
    import { requireGrownUp } from '../lib/grown-up-gate.js';

    async function init() {
      const s = await requireSession();
      if (!s) return;
      const main = document.querySelector('main');
      if (main.dataset.wp4Bound) return;
      main.dataset.wp4Bound = '1';
      const grid = document.querySelector('[data-players]');
      const add = grid.querySelector('[data-add-player]');
      const next = new URLSearchParams(location.search).get('next') || '/journey';
      const cards = await snapshotsForSession();
      grid.querySelectorAll('[data-player]').forEach((n) => n.remove());
      const empty = document.querySelector('[data-empty]');
      if (empty) empty.hidden = cards.length > 0;
      for (const { player, snapshot } of cards) {
        const el = playerCardEl(player, {
          snapshot,
          onClick: async () => { await selectPlayer(player.id); location.href = next; },
        });
        grid.insertBefore(el, add);
      }
      grid.setAttribute('aria-busy', 'false');
      document.querySelector('[data-grownups]')?.addEventListener('click', async () => {
        if (await requireGrownUp()) location.href = '/family';
      });
    }
    document.addEventListener('astro:page-load', init);
    init();
  </script>
</Base>
