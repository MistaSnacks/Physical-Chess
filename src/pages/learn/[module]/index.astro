---
// learn/[module]/index.astro — module hub. Level rail grouped by
// module.groups, live snapshot state, progress ring, Next up. Music gets
// the instrument field guide + glossary teaser; culture gets maps,
// manifestations, and animals; graduation gets the gate.
import { ClientRouter } from 'astro:transitions';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../directions/quest/Nav.astro';
import Footer from '../../../directions/quest/Footer.astro';
import { MODULES, LESSONS, INSTRUMENTS, GLOSSARY } from '../../../content/index.js';
import { PHOTOS, wix } from '../../../data/media.js';
import '../../../directions/quest/tokens.css';
import '../../../directions/quest/theme.css';

export function getStaticPaths() {
  return MODULES.map((m) => ({ params: { module: m.id }, props: { mod: m } }));
}

const { mod } = Astro.props;
const lessons = LESSONS.filter((l) => l.moduleId === mod.id);
const grouped = mod.groups.map((g) => ({
  ...g,
  lessons: lessons.filter((l) => l.group === g.id),
})).filter((g) => g.lessons.length);
const leftover = lessons.filter((l) => !mod.groups.some((g) => g.id === l.group));
if (leftover.length) grouped.push({ id: 'more', title: 'More', lessons: leftover });
const numberFor = Object.fromEntries(lessons.map((l, i) => [l.id, i + 1]));

const photo = mod.photoKey && PHOTOS[mod.photoKey]
  ? { src: wix(mod.photoKey, 1200, 640), caption: PHOTOS[mod.photoKey].caption }
  : null;

const CULTURE_MAPS = ['mapAfrica', 'mapBrazil', 'mapSlaveTrade'];
const CULTURE_MANIFEST = ['sambaDeRoda', 'jongoDrum', 'puxadaDeRede'];
const CULTURE_ANIMALS = ['animalGiraffe', 'animalGorilla', 'animalLizard', 'animalFrog', 'animalSnake', 'animalArmadillo'];

function fig(key) {
  const p = PHOTOS[key];
  if (!p) return null;
  return { key, src: wix(key, 720, 480), caption: p.caption };
}

const navActive = mod.id === 'graduation' ? 'batizado' : mod.id === 'culture' ? 'music' : mod.id;
const glossaryTeaser = GLOSSARY.slice(0, 6);
---

<Base title={`${mod.title} — Physical Chess`} direction="quest">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <div class="quest-stagelight quest-stagelight--b" aria-hidden="true"></div>
    <Nav active={navActive} />

    <main class="quest-hub" data-hub data-module={mod.id} data-locked-reason={mod.lockedReason || ''}>
      <div class="quest-detail">
        <aside class="quest-rail" data-quest-enter>
          <a class="quest-rail__back" href="/journey">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="#FFF6E5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Back to map
          </a>
          <h1 class="quest-rail__title">{mod.title}</h1>
          <p class="quest-rail__eyebrow" data-hub-count>Lessons</p>

          {grouped.map((g) => (
            <div class="quest-rail__group">
              <p class="quest-rail__group-title">{g.title}</p>
              <div class="quest-rail__list">
                {g.lessons.map((l) => (
                  <a class="quest-rail__item" href={`/learn/${mod.id}/${l.id}`} data-rail-lesson={l.id} data-lesson-link data-summary={l.summary}>
                    <span class="quest-rail__item-icon" data-rail-icon>{l.type === 'quiz' ? '?' : numberFor[l.id]}</span>
                    <span class="quest-rail__item-body">
                      <span class="quest-rail__item-title">{l.title}</span>
                      <span class="quest-rail__item-meta">
                        {l.minutes} min · {l.type}
                        <span class="quest-rail__stars" data-rail-stars></span>
                      </span>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </aside>

        <section class="quest-panel" data-quest-enter>
          <div class="quest-hub-hero">
            <div class="quest-hub-ring-wrap" aria-hidden="true">
              <svg class="quest-hub-ring" viewBox="0 0 120 120">
                <circle cx="60" cy="60" r="52" class="quest-hub-ring__track" />
                <circle cx="60" cy="60" r="52" class="quest-hub-ring__fill" data-hub-ring />
              </svg>
              <span class="quest-hub-ring__label" data-hub-percent>0%</span>
            </div>
            <div class="quest-hub-hero__copy">
              <span class="quest-panel__eyebrow">{mod.title}</span>
              <h2 class="quest-panel__title" data-hub-heading>{mod.title}</h2>
              <p class="quest-panel__summary" data-hub-summary>
                {mod.lockedReason || 'Pick a lesson from the rail. Stars only go up.'}
              </p>
              <p class="quest-hub-stars" data-hub-stars hidden></p>
            </div>
          </div>

          {photo && (
            <figure class="quest-hub-photo">
              <img src={photo.src} alt={photo.caption} loading="lazy" width="1200" height="640" />
            </figure>
          )}

          <div class="quest-btn-row">
            <a class="quest-btn quest-btn--lime" data-hub-next hidden href="/journey">Next up</a>
          </div>
          <p class="quest-hub-lock" data-hub-lock hidden></p>

          {mod.id === 'graduation' && (
            <div class="quest-hub-gate" data-hub-gate data-state="locked">
              <svg class="quest-hub-gate__icon" width="48" height="48" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 11h16v10H4z" fill="none" stroke="currentColor" stroke-width="2"/>
                <path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              <p class="quest-hub-gate__title" data-gate-title>The golden gate</p>
              <p class="quest-hub-gate__sub" data-gate-sub>It opens when your coach records your corda at Batizado.</p>
            </div>
          )}
        </section>
      </div>

      {mod.id === 'music' && (
        <>
          <section class="quest-section quest-section--instruments">
            <p class="quest-section__eyebrow" data-quest-enter>Music · Field guide</p>
            <h2 class="quest-section__title" data-quest-enter>Meet the roda's rhythm section.</h2>
            <div class="quest-instruments">
              {INSTRUMENTS.map((inst) => (
                <article class="quest-instrument-card" data-quest-enter>
                  <div class="quest-instrument-card__photo">
                    <img src={wix(inst.photoKey, 480, 360)} alt={PHOTOS[inst.photoKey]?.caption || inst.name} loading="lazy" />
                    <span class="quest-instrument-card__level">Rhythm find</span>
                  </div>
                  <span class="quest-instrument-card__name">{inst.name}</span>
                  <p class="quest-instrument-card__blurb">{inst.blurb}</p>
                </article>
              ))}
            </div>
          </section>
          <section class="quest-section">
            <p class="quest-section__eyebrow" data-quest-enter>Culture · Portuguese for the roda</p>
            <h2 class="quest-section__title" data-quest-enter>Six words every student learns.</h2>
            <div class="quest-words">
              {glossaryTeaser.map((w, i) => (
                <article class="quest-word-card" data-quest-enter>
                  <span class="quest-word-card__number">{String(i + 1).padStart(2, '0')}</span>
                  <p class="quest-word-card__word">{w.word}</p>
                  <p class="quest-word-card__meaning">{w.meaning}</p>
                </article>
              ))}
            </div>
          </section>
        </>
      )}

      {mod.id === 'culture' && (
        <>
          <section class="quest-section">
            <p class="quest-section__eyebrow" data-quest-enter>History · Maps</p>
            <h2 class="quest-section__title" data-quest-enter>Africa to Brazil.</h2>
            <div class="quest-hub-gallery">
              {CULTURE_MAPS.map(fig).filter(Boolean).map((f) => (
                <figure class="quest-hub-tile" data-quest-enter>
                  <img src={f.src} alt={f.caption} loading="lazy" />
                  <figcaption>{f.caption}</figcaption>
                </figure>
              ))}
            </div>
          </section>
          <section class="quest-section">
            <p class="quest-section__eyebrow" data-quest-enter>Manifestations</p>
            <h2 class="quest-section__title" data-quest-enter>Cousins of the roda.</h2>
            <div class="quest-hub-gallery">
              {CULTURE_MANIFEST.map(fig).filter(Boolean).map((f) => (
                <figure class="quest-hub-tile" data-quest-enter>
                  <img src={f.src} alt={f.caption} loading="lazy" />
                  <figcaption>{f.caption}</figcaption>
                </figure>
              ))}
            </div>
          </section>
          <section class="quest-section">
            <p class="quest-section__eyebrow" data-quest-enter>Animals of the ginga</p>
            <h2 class="quest-section__title" data-quest-enter>The menagerie on the maps.</h2>
            <div class="quest-hub-gallery quest-hub-gallery--animals">
              {CULTURE_ANIMALS.map(fig).filter(Boolean).map((f) => (
                <figure class="quest-hub-tile" data-quest-enter>
                  <img src={f.src} alt={f.caption} loading="lazy" />
                  <figcaption>{f.caption}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        </>
      )}
    </main>

    <div class="quest-toast" data-toast role="status" aria-live="polite"></div>
    <Footer />
  </div>
</Base>

<script>
  import '../../../directions/quest/motion.js';
  import { requireSession } from '../../../lib/auth-guard.js';
  import { paintLessonRail, setHubRing, toast } from '../../../lib/lesson-ui.js';

  async function init() {
    const main = document.querySelector('[data-hub]');
    if (!main || main.dataset.init === '1') return;
    main.dataset.init = '1';
    const s = await requireSession({ player: true });
    if (!s) return;

    const moduleId = main.dataset.module;
    const snap = s.snapshot;
    const modState = snap.modules[moduleId];
    const locked = Boolean(modState?.locked);
    const nextUp = snap.nextUp;
    const firstOpen = Array.from(main.querySelectorAll('[data-rail-lesson]')).find((el) => snap.lessons[el.dataset.railLesson]?.status !== 'done');
    const currentId = locked ? null : (nextUp?.moduleId === moduleId ? nextUp.lessonId : firstOpen?.dataset.railLesson);

    paintLessonRail(snap, { currentId, moduleId, lockLinks: locked });
    setHubRing(modState?.percent || 0);
    document.querySelector('.quest-rail__item--current')?.scrollIntoView({ inline: 'center', block: 'nearest' });

    const count = main.querySelector('[data-hub-count]');
    if (count) count.textContent = `${modState?.completed || 0} of ${modState?.total || 0} cleared`;

    const summary = main.querySelector('[data-hub-summary]');
    const heading = main.querySelector('[data-hub-heading]');
    const starsEl = main.querySelector('[data-hub-stars]');
    const next = main.querySelector('[data-hub-next]');
    const lockMsg = main.querySelector('[data-hub-lock]');

    if (starsEl && modState) {
      starsEl.hidden = false;
      starsEl.textContent = `${modState.stars} / ${modState.maxStars} stars`;
    }

    if (locked) {
      if (heading) heading.textContent = 'Still locked';
      if (summary) summary.textContent = modState.lockedReason || main.dataset.lockedReason || 'Finish the module before this one.';
      if (lockMsg) {
        lockMsg.hidden = false;
        lockMsg.textContent = modState.lockedReason || 'This module is locked.';
      }
      if (next) next.hidden = true;
      main.querySelectorAll('[data-lesson-link]').forEach((a) => {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          toast(modState.lockedReason || 'This module is locked.');
        });
      });
    } else if (currentId && next) {
      const row = main.querySelector(`[data-rail-lesson="${currentId}"]`);
      const lessonTitle = row?.querySelector('.quest-rail__item-title')?.textContent?.trim();
      next.hidden = false;
      next.href = `/learn/${moduleId}/${currentId}`;
      next.textContent = lessonTitle ? `Next: ${lessonTitle}` : 'Next up';
      if (heading) heading.textContent = lessonTitle || heading.textContent;
      if (summary && row?.dataset.summary) summary.textContent = row.dataset.summary;
    } else if (next) {
      next.hidden = false;
      next.href = '/journey';
      next.textContent = 'Back to the map';
      if (heading) heading.textContent = 'Module cleared';
      if (summary) summary.textContent = 'Every lesson here is done. Stars only go up if you play again.';
    }

    const gate = main.querySelector('[data-hub-gate]');
    if (gate) {
      const ready = Boolean(snap.readiness?.ready);
      const state = locked ? 'locked' : ready ? 'glow' : 'closed';
      gate.dataset.state = state;
      const title = gate.querySelector('[data-gate-title]');
      const sub = gate.querySelector('[data-gate-sub]');
      if (state === 'locked') {
        if (title) title.textContent = 'Gate locked';
        if (sub) sub.textContent = modState.lockedReason || 'Finish Culture to reach the gate.';
      } else if (state === 'glow') {
        if (title) title.textContent = 'The gate is glowing';
        if (sub) sub.textContent = 'You are Roda Ready. Your coach opens it at Batizado.';
      } else {
        if (title) title.textContent = 'The golden gate';
        if (sub) sub.textContent = 'It glows when you are Roda Ready. A coach opens it at Batizado.';
      }
    }

    const params = new URLSearchParams(location.search);
    if (params.get('locked') === '1') {
      toast(modState?.lockedReason || 'That lesson is locked.');
    }
  }
  document.addEventListener('astro:page-load', init);
  init();
</script>
