---
// learn/[module]/[lesson].astro — the lesson player (SPEC §5.2). One route,
// four lesson types. Completion writes a ledger event through actions.js.
// WP2 turns this skeleton into the finished player (DrillTimer with
// metronome, Reading with read-aloud, richer Quiz, next-up flow).
import { ClientRouter } from 'astro:transitions';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../directions/quest/Nav.astro';
import Footer from '../../../directions/quest/Footer.astro';
import YouTube from '../../../components/YouTube.astro';
import Quiz from '../../../components/Quiz.astro';
import { LESSONS, MODULES, moduleById } from '../../../content/index.js';
import { wix, yt } from '../../../data/media.js';
import '../../../directions/quest/tokens.css';
import '../../../directions/quest/theme.css';

export function getStaticPaths() {
  return LESSONS.map((l) => ({ params: { module: l.moduleId, lesson: l.id }, props: { lesson: l } }));
}
const { lesson } = Astro.props;
const mod = moduleById(lesson.moduleId);
const siblings = LESSONS.filter((l) => l.moduleId === lesson.moduleId);
const index = siblings.findIndex((l) => l.id === lesson.id);
const nextLesson = siblings[index + 1] || null;
const TYPE_LABEL = { video: 'Watch', reading: 'Read', drill: 'Practice', quiz: 'Boss Quiz' };

// Tiny markdown: paragraphs + **bold**. WP2 may swap in a real renderer.
function md(s = '') {
  return s.split(/\n\s*\n/).map((p) => `<p>${p.trim().replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')}</p>`).join('');
}
const navActive = lesson.moduleId === 'graduation' ? 'batizado' : lesson.moduleId;
---

<Base title={`${lesson.title} — Physical Chess`} direction="quest">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <div class="quest-stagelight quest-stagelight--b" aria-hidden="true"></div>
    <Nav active={navActive} />
    <main class="quest-screen quest-lesson" data-lesson={lesson.id} data-module={lesson.moduleId} data-type={lesson.type}>
      <aside class="quest-rail" data-quest-enter>
        <a class="quest-rail__back" href={`/learn/${mod.id}`}>
          <svg width="18" height="18" viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" fill="none" stroke="#FFF6E5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {mod.title}
        </a>
        <p class="quest-rail__eyebrow">Lesson {index + 1} of {siblings.length}</p>
        <div class="quest-rail__list">
          {siblings.map((l, i) => (
            <a class={`quest-rail__item ${l.id === lesson.id ? 'quest-rail__item--current' : ''}`} href={`/learn/${mod.id}/${l.id}`} data-rail-lesson={l.id}>
              <span class="quest-rail__item-icon" data-rail-icon>{i + 1}</span>
              <span class="quest-rail__item-body"><span class="quest-rail__item-title">{l.title}</span><span class="quest-rail__item-meta">{l.minutes} min · {l.type}</span></span>
            </a>
          ))}
        </div>
      </aside>

      <section class="quest-lesson__stage" data-quest-enter>
        <span class="quest-lesson__type">{TYPE_LABEL[lesson.type]}</span>
        <h1 class="quest-lesson__title">{lesson.title}</h1>
        <p class="quest-lesson__summary">{lesson.summary}</p>

        {lesson.type === 'video' && lesson.videoKey && (
          <div>
            <YouTube id={yt(lesson.videoKey)} title={lesson.title} />
            <p class="quest-field__hint" style="margin:8px 0 18px">Video: SoChlo Productions</p>
            <button class="quest-btn quest-btn--lime" type="button" data-complete data-payload='{}'>I watched it</button>
          </div>
        )}

        {lesson.type === 'reading' && (
          <div>
            {lesson.photoKey && <img src={wix(lesson.photoKey, 1200, 640)} alt="" loading="lazy" style="border-radius:20px;margin-bottom:18px" />}
            <div class="quest-reading" set:html={md(lesson.body)} />
            {lesson.check && (
              <div class="quest-done" data-check>
                <p class="quest-done__title" style="color:var(--quest-cream)">{lesson.check.prompt}</p>
                <div class="quest-rating" data-check-choices>
                  {lesson.check.choices.map((c, i) => (<button type="button" data-check-choice={i} data-correct={i === lesson.check.correctIndex}>{c}</button>))}
                </div>
                <p class="quest-field__hint" data-check-feedback aria-live="polite"></p>
              </div>
            )}
            {!lesson.check && <button class="quest-btn quest-btn--lime" type="button" data-complete data-payload='{}'>I read it</button>}
          </div>
        )}

        {lesson.type === 'drill' && lesson.drill && (
          <div data-drill data-seconds={lesson.drill.seconds}>
            <ol class="quest-steps">{lesson.drill.steps.map((s) => (<li>{s.text}</li>))}</ol>
            <div class="quest-timer" data-timer>{Math.floor(lesson.drill.seconds / 60)}:{String(lesson.drill.seconds % 60).padStart(2, '0')}</div>
            <div class="quest-btn-row"><button class="quest-btn" type="button" data-timer-start>Start the timer</button></div>
            <div class="quest-done" data-rating hidden>
              <p class="quest-done__title">Time! How did it feel?</p>
              <div class="quest-rating">
                <button type="button" data-rate="1">Still learning</button>
                <button type="button" data-rate="2">Getting it</button>
                <button type="button" data-rate="3">Nailed it</button>
              </div>
            </div>
          </div>
        )}

        {lesson.type === 'quiz' && lesson.quiz && (
          <div><Quiz questions={lesson.quiz} class="quest-quiz" /></div>
        )}

        <div class="quest-done" data-finished hidden>
          <p class="quest-done__title">Lesson cleared! <span data-earned></span></p>
          <div class="quest-btn-row">
            {nextLesson ? <a class="quest-btn" href={`/learn/${mod.id}/${nextLesson.id}`}>Next: {nextLesson.title}</a> : <a class="quest-btn" href="/journey">Back to the map</a>}
          </div>
        </div>
      </section>
    </main>
    <div class="quest-toast" data-toast role="status"></div>
    <Footer />
  </div>

  <script>
    import '../../../directions/quest/motion.js';
    import { requireSession } from '../../../lib/auth-guard.js';
    import { recordEvent } from '../../../lib/actions.js';
    import { store } from '../../../lib/store.js';
    import { EVENT } from '../../../lib/game/events.js';

    const DONE_TYPE = { video: EVENT.VIDEO_DONE, reading: EVENT.READING_DONE, drill: EVENT.DRILL_DONE, quiz: EVENT.QUIZ_DONE };
    const CHECK = '<svg width="20" height="20" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7" fill="none" stroke="#0B2E24" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

    function toast(msg) {
      const t = document.querySelector('[data-toast]');
      t.textContent = msg; t.dataset.show = 'true';
      setTimeout(() => (t.dataset.show = 'false'), 2200);
    }
    function paintRail(snapshot) {
      document.querySelectorAll('[data-rail-lesson]').forEach((el) => {
        const st = snapshot.lessons[el.dataset.railLesson];
        el.classList.toggle('quest-rail__item--done', st?.status === 'done');
        if (st?.status === 'done') el.querySelector('[data-rail-icon]').innerHTML = CHECK;
      });
    }
    async function finish(main, payload) {
      const type = DONE_TYPE[main.dataset.type];
      const before = store.get().snapshot;
      const xpBefore = before?.xp || 0;
      const after = await recordEvent(type, { moduleId: main.dataset.module, lessonId: main.dataset.lesson, payload });
      const earned = after.xp - xpBefore;
      const done = main.querySelector('[data-finished]');
      done.hidden = false;
      done.querySelector('[data-earned]').textContent = earned > 0 ? `+${earned} XP` : 'Stars updated';
      paintRail(after);
      toast(earned > 0 ? `+${earned} XP` : 'Nice. Stars only go up.');
      done.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    async function init() {
      const s = await requireSession({ player: true });
      if (!s) return;
      const main = document.querySelector('[data-lesson]');
      if (!main || main.dataset.init) return;
      main.dataset.init = '1';
      paintRail(s.snapshot);

      main.querySelectorAll('[data-complete]').forEach((btn) => btn.addEventListener('click', () => { btn.disabled = true; finish(main, JSON.parse(btn.dataset.payload || '{}')); }));

      // Reading check: first try right = 2 stars.
      const check = main.querySelector('[data-check]');
      if (check) {
        let tries = 0;
        check.querySelectorAll('[data-check-choice]').forEach((b) => b.addEventListener('click', () => {
          tries += 1;
          const ok = b.dataset.correct === 'true';
          b.setAttribute('aria-pressed', 'true');
          check.querySelector('[data-check-feedback]').textContent = ok ? 'Boa!' : 'Not that one. Try again.';
          if (ok) { check.querySelectorAll('button').forEach((x) => (x.disabled = true)); finish(main, { checkFirstTry: tries === 1 }); }
        }));
      }

      // Drill: timer then self-rating.
      const drill = main.querySelector('[data-drill]');
      if (drill) {
        const total = Number(drill.dataset.seconds);
        const out = drill.querySelector('[data-timer]');
        drill.querySelector('[data-timer-start]').addEventListener('click', (e) => {
          e.currentTarget.disabled = true;
          let left = total;
          const tick = setInterval(() => {
            left -= 1;
            out.textContent = `${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}`;
            if (left <= 0) { clearInterval(tick); drill.querySelector('[data-rating]').hidden = false; }
          }, 1000);
        });
        drill.querySelectorAll('[data-rate]').forEach((b) => b.addEventListener('click', () => {
          drill.querySelectorAll('[data-rate]').forEach((x) => { x.disabled = true; x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
          finish(main, { selfRating: Number(b.dataset.rate) });
        }));
      }

      // Quiz: per-answer events, then quiz.done.
      const quiz = main.querySelector('[data-quiz]');
      if (quiz) {
        quiz.addEventListener('quiz:correct', (e) => recordEvent(EVENT.QUIZ_ANSWERED, { moduleId: main.dataset.module, lessonId: main.dataset.lesson, payload: { questionId: e.detail.id, correct: true } }));
        quiz.addEventListener('quiz:wrong', (e) => recordEvent(EVENT.QUIZ_ANSWERED, { moduleId: main.dataset.module, lessonId: main.dataset.lesson, payload: { questionId: e.detail.id, correct: false } }));
        quiz.addEventListener('quiz:done', (e) => finish(main, { score: e.detail.score, total: e.detail.total }));
      }
    }
    document.addEventListener('astro:page-load', init);
    init();
  </script>
</Base>
