---
// movements.astro — map node detail for the Movements module: lesson
// steps in the level rail, a real embedded video, a practice drill card
// and a mark-complete interaction. Per SPEC §2 row 3 + §5.2.
import { ClientRouter } from 'astro:transitions';
import Base from '../../layouts/Base.astro';
import Nav from '../../directions/quest/Nav.astro';
import Footer from '../../directions/quest/Footer.astro';
import YouTube from '../../components/YouTube.astro';
import { MODULES, moduleProgress } from '../../data/curriculum.js';
import { video, yt } from '../../data/media.js';

import '../../directions/quest/tokens.css';
import '../../directions/quest/theme.css';

const mod = MODULES.find((m) => m.id === 'movements');
const progress = moduleProgress(mod);
const currentIndex = mod.lessons.findIndex((l) => !l.completed);
const current = mod.lessons[currentIndex === -1 ? mod.lessons.length - 1 : currentIndex];
const drillLesson = mod.lessons.find((l) => l.type === 'drill') || mod.lessons[2];
const featured = video('aulao2024Lapa');
---

<Base title="Movements — Roda Quest" direction="quest">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <div class="quest-stagelight quest-stagelight--b" aria-hidden="true"></div>

    <Nav active="movements" />

    <main class="quest-detail">
      <aside class="quest-rail" data-quest-enter>
        <a class="quest-rail__back" href="/quest/dashboard">
          <svg width="18" height="18" viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" fill="none" stroke="#FFF6E5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Back to map
        </a>
        <h1 class="quest-rail__title">Movements</h1>
        <p class="quest-rail__eyebrow">STOP 1 &middot; {progress.completed} OF {progress.total} CLEARED</p>

        <div class="quest-rail__list">
        {
          mod.lessons.map((lesson, i) => {
            const isDone = lesson.completed;
            const isCurrent = !isDone && i === currentIndex;
            const stateClass = isDone
              ? 'quest-rail__item--done'
              : isCurrent
                ? 'quest-rail__item--current'
                : '';
            return (
              <div class={`quest-rail__item ${stateClass}`} data-quest-enter>
                <span class="quest-rail__item-icon">
                  {isDone ? (
                    <svg width="20" height="20" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7" fill="none" stroke="#0B2E24" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  ) : (
                    i + 1
                  )}
                </span>
                <span class="quest-rail__item-body">
                  <span class="quest-rail__item-title">{lesson.title}</span>
                  <span class="quest-rail__item-meta">
                    {lesson.minutes} min &middot; {isDone ? 'cleared' : isCurrent ? 'up next' : lesson.type}
                  </span>
                </span>
              </div>
            );
          })
        }
        </div>
      </aside>

      <section class="quest-panel" data-quest-enter>
        <span class="quest-panel__eyebrow">{current.type === 'video' ? 'WATCH' : current.type === 'drill' ? 'DRILL' : 'LESSON'}</span>
        <h2 class="quest-panel__title">{current.title}</h2>
        <p class="quest-panel__summary">{current.summary}</p>

        {
          current.videoKey && (
            <div>
              <YouTube id={yt(current.videoKey)} title={current.title} class="quest-video-frame" />
              <p class="quest-video-credit">Video: SoChlo Productions</p>
            </div>
          )
        }

        <div class="quest-drill-card">
          <div class="quest-drill-card__text">
            <span class="quest-drill-card__title">Practice: {drillLesson.title}</span>
            <span class="quest-drill-card__meta">{drillLesson.minutes} min &middot; {drillLesson.summary}</span>
          </div>
          <button type="button" class="quest-btn quest-btn--lime" data-quest-complete-btn data-done="false">
            <span data-quest-complete-label>Mark complete</span>
          </button>
        </div>

        <div>
          <div class="quest-video-frame">
            <video src={featured.mp4} poster={featured.poster} controls preload="none" playsinline></video>
          </div>
          <p class="quest-video-credit">Latest from the roda &mdash; {featured.title}. Video: SoChlo Productions</p>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Base>

<script>
  import '../../directions/quest/motion.js';
</script>
