---
// movements.astro — Axé Comics Movements lesson player: a full-page splash
// panel with the real aulão 2024 Lapa video, and the five Movements lessons
// as step panels underneath with a mark-complete interaction. SPEC §2 row 3.
import { ClientRouter } from 'astro:transitions';
import Base from '../../layouts/Base.astro';
import Nav from '../../directions/comics/Nav.astro';
import Footer from '../../directions/comics/Footer.astro';
import Starburst from '../../directions/comics/Starburst.astro';
import { MODULES } from '../../data/curriculum.js';
import { video } from '../../data/media.js';
import '../../directions/comics/tokens.css';
import '../../directions/comics/theme.css';

const movementsModule = MODULES.find((m) => m.id === 'movements');
const { mp4, poster } = video('aulao2024Lapa');

const TILTS = [-1, 1.2, -0.6, 1, -1.4];
---

<Base title="Movements — Axé Comics" direction="comics">
  <Fragment slot="head">
    <ClientRouter />
  </Fragment>

  <Nav active="movements" />

  <main class="wrap">
    <section class="cx-lesson-lead" data-enter="left" style="--cx-delay:40ms;">
      <div>
        <p class="cx-strip-head__eyebrow">CHAPTER 2 · MOVEMENT TRAINING</p>
        <h1 class="cx-lesson-lead__title">BUILD YOUR <span>JOGO!</span></h1>
      </div>
      <p class="cx-lesson-lead__dek">Watch the move, practice it slowly, then mark the lesson done.</p>
    </section>
    <div class="cx-panel cx-splash" data-enter="up" style="--cx-tilt:-0.5deg;">
      <div class="cx-splash__media" data-video-key="aulao2024Lapa">
        <img class="cx-splash__poster" src={poster} alt="Aulão 2024 – 300 Anos Lapa" loading="eager" />
        <video class="cx-splash__video" hidden controls poster={poster}>
          <source src={mp4} type="video/mp4" />
        </video>
        <button type="button" class="cx-art__play" data-splash-play>
          <span>▶ PLAY!</span>
        </button>
      </div>
      <span class="cx-splash__title">NOW PLAYING · AÚ</span>
    </div>

    <p style="font-size:13px; font-weight:800; margin: 18px 0 8px; color:var(--cx-gray-mute);">
      Video: SoChlo Productions · Aulão 2024 – 300 Anos Lapa
    </p>

    <div class="cx-steps">
      {
        movementsModule.lessons.map((lesson, i) => (
          <div
            class="cx-panel cx-step"
            data-step
            data-done={lesson.completed ? 'true' : 'false'}
            data-enter={i % 2 === 0 ? 'left' : 'right'}
            style={`--cx-tilt:${TILTS[i % TILTS.length]}deg; --cx-delay:${120 + i * 90}ms;`}
          >
            <div class="cx-step__body">
              <div class="cx-step__title-row">
                <span class="cx-step__num">{i + 1}</span>
                <span class="cx-step__title">{lesson.title}</span>
              </div>
              <span class:list={['cx-step__type', { 'cx-step__type--drill': lesson.type === 'drill' }]}>
                {lesson.type.toUpperCase()} · {lesson.minutes} MIN
              </span>
              <p class="cx-step__summary">{lesson.summary}</p>
              <button type="button" class="cx-step__mark" data-step-mark>
                MARK DONE
              </button>
            </div>
            <Starburst text="DONE!" size={92} rotate={8} class="cx-step__done-burst" />
          </div>
        ))
      }
    </div>
  </main>

  <Footer />

  <script>
    import '../../directions/comics/motion.js';
  </script>
</Base>
