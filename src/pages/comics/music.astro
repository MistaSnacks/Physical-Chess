---
// music.astro — Axé Comics Music & Culture + quiz: instrument cards,
// Portuguese words, and the 3-question quiz panel with the AXÉ! reward
// moment and full-screen celebration. SPEC §2 row 4, §5.3.
import { ClientRouter } from 'astro:transitions';
import Base from '../../layouts/Base.astro';
import Nav from '../../directions/comics/Nav.astro';
import Footer from '../../directions/comics/Footer.astro';
import SpeechBubble from '../../directions/comics/SpeechBubble.astro';
import PhotoArt from '../../directions/comics/PhotoArt.astro';
import Quiz from '../../components/Quiz.astro';
import { INSTRUMENTS, PORTUGUESE_WORDS, MUSIC_QUIZ } from '../../data/curriculum.js';
import '../../directions/comics/tokens.css';
import '../../directions/comics/theme.css';

// Simple ink-line icons for the instruments without a real photo in media.js.
const ICONS: Record<string, string> = {
  pandeiro:
    '<circle cx="12" cy="12" r="8" fill="none" stroke="#111" stroke-width="1.6"/><circle cx="12" cy="4" r="1.4" fill="#111"/><circle cx="20" cy="12" r="1.4" fill="#111"/><circle cx="12" cy="20" r="1.4" fill="#111"/><circle cx="4" cy="12" r="1.4" fill="#111"/>',
  atabaque:
    '<path d="M8 3h8l-1 6H9z" fill="none" stroke="#111" stroke-width="1.6"/><path d="M9 9h6l1 11a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1z" fill="none" stroke="#111" stroke-width="1.6"/>',
  agogo:
    '<path d="M12 3c-3 3-3 7 0 10" fill="none" stroke="#111" stroke-width="1.6"/><path d="M12 9c3 3 3 8 0 12" fill="none" stroke="#111" stroke-width="1.6"/><circle cx="12" cy="3" r="1.4" fill="#111"/>',
};
---

<Base title="Music & Culture — Axé Comics" direction="comics">
  <Fragment slot="head">
    <ClientRouter />
  </Fragment>

  <Nav active="music" />

  <main class="wrap">
    <section data-enter="left" style="padding-block:40px 8px; --cx-delay:40ms;">
      <p class="cx-strip-head__eyebrow">CHAPTER 3 · MUSIC &amp; CULTURE</p>
      <h1 class="cx-strip-head__title" style="font-size:clamp(36px, 5vw, 64px);">THE SOUND OF THE RODA</h1>
    </section>

    <div class="cx-quiz-wrap cx-quiz-wrap--lead">
      <div class="cx-panel cx-quiz-panel" data-enter="left" style="--cx-tilt:-0.4deg; --cx-delay:120ms;">
        <div class="cx-quiz-badge-row">
          <span class="cx-quiz-label">BOSS QUIZ!</span>
          <span class="cx-quiz-progress">3 QUESTIONS · +150 XP</span>
        </div>
        <Quiz questions={MUSIC_QUIZ} />
      </div>

      <aside class="cx-quiz-side" data-enter="right" style="--cx-delay:220ms;">
        <div class="cx-quiz-side__bubble">
          <SpeechBubble text="Boa, Maya! Answer all three and axé is yours." align="left" />
        </div>
        <PhotoArt photoKey="mestraMarciaBerimbau" w={300} h={300} class="cx-panel cx-quiz-side__art" style="--cx-tilt:1.5deg;" eager />
        <p class="cx-quiz-side__name">MESTRA MARCIA</p>
        <p class="cx-quiz-side__xp">+50 XP EACH</p>
      </aside>
    </div>

    <div class="cx-section-heading" data-enter="up">
      <div>
        <p class="cx-strip-head__eyebrow">YOUR RODA TOOLKIT</p>
        <h2>MEET THE BAND</h2>
      </div>
      <p>Study these clues, then replay the quiz.</p>
    </div>

    <div class="cx-instruments">
      {
        INSTRUMENTS.map((inst, i) => (
          <div
            class="cx-panel cx-instrument"
            data-enter={i % 2 === 0 ? 'left' : 'right'}
            style={`--cx-tilt:${i % 2 === 0 ? -1.2 : 1}deg; --cx-delay:${120 + i * 80}ms;`}
          >
            {inst.photoKey ? (
              <PhotoArt photoKey={inst.photoKey} w={480} h={340} class="cx-instrument__art" />
            ) : (
              <div class="cx-instrument__art" style="display:flex; align-items:center; justify-content:center; background:var(--cx-yellow);">
                <svg width="72" height="72" viewBox="0 0 24 24" set:html={ICONS[inst.id]} />
              </div>
            )}
            <div class="cx-instrument__body">
              <p class="cx-instrument__name">{inst.name}</p>
              <p class="cx-instrument__blurb">{inst.blurb}</p>
            </div>
          </div>
        ))
      }
    </div>

    <h2 style="font-family:var(--cx-font-display); font-size:32px; margin-block:8px 4px;">WORDS FOR THE RODA</h2>
    <div class="cx-words">
      {
        PORTUGUESE_WORDS.map((w, i) => (
          <div
            class="cx-panel cx-word"
            data-enter="up"
            style={`--cx-tilt:${i % 2 === 0 ? -0.8 : 0.8}deg; --cx-delay:${i * 60}ms;`}
          >
            <p class="cx-word__term">{w.word}</p>
            <p class="cx-word__meaning">{w.meaning}</p>
          </div>
        ))
      }
    </div>

  </main>

  <Footer />

  <div class="cx-celebrate" data-celebrate hidden>
    <p class="cx-celebrate__title">AXÉ!!!</p>
    <p class="cx-celebrate__score" data-celebrate-score></p>
    <a class="cx-celebrate__close" href="/comics/batizado">ON TO THE BATIZADO →</a>
  </div>

  <script>
    import '../../directions/comics/motion.js';
  </script>
</Base>
