---
// dashboard.astro — Axé Comics "My Journey": the strip. Four curriculum
// modules as comic panels, a mestre speech bubble, and the black corda
// meter bar. SPEC §2 row 2, §5.3.
import { ClientRouter } from 'astro:transitions';
import Base from '../../layouts/Base.astro';
import Nav from '../../directions/comics/Nav.astro';
import Footer from '../../directions/comics/Footer.astro';
import SpeechBubble from '../../directions/comics/SpeechBubble.astro';
import PhotoArt from '../../directions/comics/PhotoArt.astro';
import { MODULES, moduleProgress, overallProgress, nextUpLesson } from '../../data/curriculum.js';
import { STUDENT } from '../../data/student.js';
import { CORDAS, cordaIndex, BATIZADO_DATE } from '../../data/batizado.js';
import '../../directions/comics/tokens.css';
import '../../directions/comics/theme.css';

const overall = overallProgress();
const next = nextUpLesson();
const cIndex = cordaIndex(STUDENT.corda);
const nextCorda = CORDAS[cIndex + 1] ?? CORDAS[cIndex];

const MODULE_PHOTO = {
  movements: 'kidsWorkshopDay2',
  music: 'berimbauGourd',
  culture: 'sambaDeRoda',
  graduation: 'bannerBatizado',
};
const MODULE_HREF = {
  movements: '/comics/movements',
  music: '/comics/music',
  culture: '/comics/music',
  graduation: '/comics/batizado',
};

const daysUntilBatizado = Math.max(
  0,
  Math.ceil((new Date(BATIZADO_DATE).getTime() - Date.now()) / (1000 * 60 * 60 * 24))
);

const speech = next
  ? `${overall.completed} lesson${overall.completed === 1 ? '' : 's'} down, Maya! Next up: "${next.lesson.title}" in ${next.module.title}.`
  : `${overall.completed} of ${overall.total} lessons done, Maya! You've cleared the whole roda.`;

const TILTS = [-1.5, 1, -0.8, 1.3];
const SIDES = ['left', 'right', 'left', 'right'];

const meterSegments = 10;
const filledSegments = Math.round((overall.percent / 100) * meterSegments);
---

<Base title="My Journey — Axé Comics" direction="comics">
  <Fragment slot="head">
    <ClientRouter />
  </Fragment>

  <Nav active="dashboard" />

  <main class="wrap">
    <section class="cx-strip-head">
      <div data-enter="left" style="--cx-delay:40ms;">
        <p class="cx-strip-head__eyebrow">CHAPTER 2 · CORDA {STUDENT.corda.toUpperCase()}</p>
        <h1 class="cx-strip-head__title">
          MAYA VS.
          <span>THE RODA!</span>
        </h1>
        <p class="cx-streak" style="margin-top:16px;">{STUDENT.streakDays}-DAY STREAK · {STUDENT.stars} STARS</p>
      </div>

      <div data-enter="right" style="--cx-delay:160ms;">
        <SpeechBubble text={speech} align="right" />
        <div style="display:flex; align-items:center; gap:14px; margin-top:16px;">
          <PhotoArt photoKey="mestrePernilongo" w={140} h={140} class="cx-panel" style="width:80px; height:80px; --cx-tilt:1.5deg;" />
          <p class="cx-strip-head__eyebrow" style="margin:0;">MESTRE PERNILONGO</p>
        </div>
      </div>
    </section>

    <div class="cx-modules">
      {
        MODULES.map((mod, i) => {
          const progress = moduleProgress(mod);
          const isDone = progress.percent === 100;
          const isCurrent = !mod.locked && !isDone;
          const state = mod.locked ? 'locked' : isDone ? 'done' : undefined;
          const currentLesson = isCurrent ? mod.lessons.find((l) => !l.completed) : null;
          const caption = mod.locked
            ? mod.lockedReason
            : currentLesson
              ? currentLesson.summary
              : mod.lessons[mod.lessons.length - 1]?.summary;

          return (
            <a
              href={MODULE_HREF[mod.id]}
              class="cx-panel cx-module"
              data-enter={SIDES[i % SIDES.length]}
              style={`--cx-tilt:${TILTS[i % TILTS.length]}deg; --cx-delay:${260 + i * 90}ms; display:block; text-decoration:none;`}
            >
              <div class:list={['cx-panel__header', { 'cx-panel__header--red': isCurrent }]}>
                <span class="cx-panel__header-title">{mod.title.toUpperCase()}</span>
                <span class="cx-panel__header-badge">
                  {mod.locked ? 'LOCKED' : isCurrent ? 'NOW' : `${progress.completed} / ${progress.total}`}
                </span>
              </div>
              <PhotoArt
                photoKey={MODULE_PHOTO[mod.id]}
                w={640}
                h={480}
                state={state}
                play={isCurrent}
                class="cx-module__art"
              />
              <p class="cx-panel__caption">{caption}</p>
            </a>
          );
        })
      }
    </div>

    <div class="cx-meter" data-enter="up" style="--cx-delay:520ms;">
      <div class="cx-meter__next">
        <p class="cx-meter__next-label">NEXT CORDA</p>
        <p class="cx-meter__next-value">{nextCorda.label.toUpperCase()}</p>
      </div>
      <div class="cx-meter__track" role="img" aria-label={`${overall.percent}% of lessons complete`}>
        {
          Array.from({ length: meterSegments }).map((_, i) => (
            <span class:list={['cx-meter__seg', { 'cx-meter__seg--fill': i < filledSegments }]} />
          ))
        }
      </div>
      <p class="cx-meter__count">{overall.completed} / {overall.total} lessons</p>
      <div class="cx-meter__countdown">
        <p class="cx-meter__countdown-text">BATIZADO IN {daysUntilBatizado} DAYS</p>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    import '../../directions/comics/motion.js';
  </script>
</Base>
