---
// dashboard.astro — Sticker Roda / "My Journey"
import { ClientRouter } from 'astro:transitions';
import Base from '../../layouts/Base.astro';
import Nav from '../../directions/sticker/Nav.astro';
import Footer from '../../directions/sticker/Footer.astro';
import '../../directions/sticker/theme.css';
import { MODULES, moduleProgress, overallProgress, nextUpLesson } from '../../data/curriculum.js';
import { STUDENT } from '../../data/student.js';
import { CORDAS, cordaIndex, BATIZADO_DATE, BATIZADO_DATE_TBC } from '../../data/batizado.js';
import { PHOTOS, wix } from '../../data/media.js';

const overall = overallProgress();
const currentCorda = CORDAS[cordaIndex(STUDENT.corda)];
const nextCorda = CORDAS[cordaIndex(STUDENT.nextCorda)];
const nextUp = nextUpLesson();

const daysToBatizado = Math.max(
  0,
  Math.ceil((new Date(BATIZADO_DATE).getTime() - Date.now()) / (1000 * 60 * 60 * 24))
);

const MODULE_META = {
  movements: {
    badge: 'sky',
    href: '/sticker/movements',
    icon: '<path d="M12 5.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" fill="var(--color-ink)"/><path d="M12 8v5M12 10l-5-2M12 11l5 2M12 13l-4 6M12 13l4 6.5" fill="none" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round"/>',
    photo: 'classPhoto2022a',
  },
  music: {
    badge: 'sun',
    href: '/sticker/music',
    icon: '<path d="M6 20c-3 0-5-6 1-8 1.5-.5 3 .3 3 2v9" fill="none" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round"/><path d="M10 5.5 18 3v11" fill="none" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><ellipse cx="15.5" cy="15.5" rx="2.5" ry="2" fill="var(--color-ink)"/>',
    photo: 'mestraMarciaBerimbau',
  },
  culture: {
    badge: 'coral',
    href: '/sticker/music',
    icon: '<circle cx="12" cy="12" r="8" fill="none" stroke="var(--color-white)" stroke-width="2"/><path d="M4 12h16M12 4c2.5 3 2.5 13 0 16M12 4c-2.5 3-2.5 13 0 16" fill="none" stroke="var(--color-white)" stroke-width="1.6"/>',
    iconStroke: '#fff',
    photo: 'sambaDeRoda',
  },
  graduation: {
    badge: 'blue',
    href: '/sticker/batizado',
    icon: '<path d="M5 10 12 6l7 4-7 4-7-4Z" fill="none" stroke="var(--color-white)" stroke-width="2" stroke-linejoin="round"/><path d="M8 12.5V16c0 1.3 1.8 2.5 4 2.5s4-1.2 4-2.5v-3.5" fill="none" stroke="var(--color-white)" stroke-width="2"/>',
    photo: 'heroWorkshop',
  },
};
---

<Base title="My Journey — Sticker Roda — Physical Chess" direction="sticker">
  <Fragment slot="head">
    <ClientRouter />
  </Fragment>

  <Nav active="dashboard" />

  <main class="sr-dash wrap" transition:animate="fade">
    <div class="sr-greet">
      <div>
        <h1 class="sr-greet__title">
          Welcome back, {STUDENT.firstName}!
          <svg class="sr-wave" width="0.85em" height="0.85em" viewBox="0 0 24 24" aria-hidden="true" style="color:var(--color-sun);">
            <path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V12M11 12V4a1.5 1.5 0 0 1 3 0v8M14 12V5.5a1.5 1.5 0 0 1 3 0V13M17 13v-3.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-2a6 6 0 0 1-5.2-3L5 14.5c-.6-1 .1-2 1.2-1.8.5.1.9.4 1.2.8L8 15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round" />
          </svg>
        </h1>
        <p class="sr-greet__sub">Pick up where you left off, capoeirista!</p>
      </div>
      <span class="sr-greet__badge">
        <svg width="18" height="18" viewBox="0 0 24 24"><path d="M12 2l2.9 6.26L21.5 9.27l-5 4.87 1.18 6.88L12 17.77l-5.68 3.25L7.5 14.14l-5-4.87 6.6-1.01L12 2z" fill="var(--color-ink)" /></svg>
        {overall.completed} / {overall.total} lessons done
      </span>
    </div>

    <div class="sr-corda-row">
      <h2>Corda {currentCorda.label}</h2>
      <span class="sr-corda-pill">
        <span class="sr-corda-swatch" style={`background:${currentCorda.color}`}></span>
        <span class="label">{currentCorda.label} corda</span>
      </span>
    </div>

    <div class="sr-modules" data-stagger>
      {MODULES.map((mod, i) => {
        const prog = moduleProgress(mod);
        const meta = MODULE_META[mod.id];
        const tilt = ['-1.2deg', '-0.1deg', '1.4deg', '-2deg'][i % 4];
        return (
          <div class="sr-card sr-module-card" data-anim="card" data-locked={mod.locked ? 'true' : 'false'} style={`--tilt:${tilt}`}>
            <div class="sr-module-card__top">
              <span class={`sr-icon-badge sr-icon-badge--${mod.locked ? 'muted' : meta.badge}`} set:html={`<svg width="30" height="30" viewBox="0 0 24 24">${meta.icon}</svg>`} />
              {prog.percent === 100 ? (
                <span class="sr-chip sr-chip--done" data-chip="done">
                  <svg width="14" height="14" viewBox="0 0 24 24"><path d="M4 12.5 L9.5 18 L20 6.5" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  Done!
                </span>
              ) : mod.locked ? (
                <span class="sr-chip sr-chip--locked">
                  <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2.5" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M8 10V7a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2.4"/></svg>
                  Locked
                </span>
              ) : null}
            </div>
            <div class="sr-module-card__photo">
              <img src={wix(meta.photo, 640, 300)} alt={PHOTOS[meta.photo].caption} loading="lazy" width="640" height="300" />
              <span>{mod.locked ? 'Unlock this world' : `${prog.completed} of ${prog.total} complete`}</span>
            </div>
            <h3 class="sr-module-card__title">{mod.title}</h3>
            <p class="sr-module-card__desc">
              {mod.locked ? mod.lockedReason : mod.lessons[0]?.summary}
            </p>
            <div class="sr-progress" data-progress={prog.percent}>
              <div class="sr-progress__track"><div class="sr-progress__fill" data-progress-fill></div></div>
              <p class="sr-progress__label">{prog.completed}/{prog.total} lessons · {prog.percent}%</p>
            </div>
            {!mod.locked && (
              <a class="sr-btn sr-btn--blue sr-module-card__cta" href={meta.href}>Continue</a>
            )}
          </div>
        );
      })}
    </div>

    {nextUp && (
      <div class="sr-card sr-unlock-banner" data-anim="card" style="--tilt:0.4deg">
        <div class="sr-unlock-banner__left">
          <span class="sr-icon-badge sr-icon-badge--sun">
            <svg width="26" height="26" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2.5" fill="none" stroke="var(--color-ink)" stroke-width="2.4"/><path d="M8 10 V7 a4 4 0 0 1 8 0 v3" fill="none" stroke="var(--color-ink)" stroke-width="2.4"/><circle cx="12" cy="15" r="1.8" fill="var(--color-ink)"/></svg>
          </span>
          <div>
            <h3>Next up: {nextUp.lesson.title}</h3>
            <p>{nextUp.module.title} · {nextUp.lesson.minutes} min {nextUp.lesson.type}</p>
          </div>
        </div>
        <a class="sr-btn sr-btn--ghost" href={MODULE_META[nextUp.module.id].href}>Continue →</a>
      </div>
    )}

    <div class="sr-stat-row" data-stagger>
      <div class="sr-card sr-stat-card" data-anim="card" style="--tilt:-0.5deg">
        <span class="sr-icon-badge sr-icon-badge--coral">
          <svg width="24" height="24" viewBox="0 0 24 24"><path d="M12 2 C13 6, 17 7.5, 17 12.5 a5 5 0 0 1 -10 0 C7 9.5, 9 8, 9.6 5.5 C10.8 6.8, 11.6 7.6, 12 9 C12.6 6.6, 11.6 4.4, 12 2z" fill="#fff"/></svg>
        </span>
        <div>
          <h3>{STUDENT.streakDays}-day streak!</h3>
          <p>Practice today to keep the fire going</p>
        </div>
      </div>
      <div class="sr-card sr-stat-card" data-anim="card" style="--tilt:0.5deg">
        <span class="sr-icon-badge sr-icon-badge--blue">
          <svg width="24" height="24" viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5" fill="none" stroke="#fff" stroke-width="2.2"/><path d="M3.5 9.5 H20.5 M8 2.8 V6.5 M16 2.8 V6.5" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="15" r="2.2" fill="#fff"/></svg>
        </span>
        <div>
          <h3>Batizado 2026 · {daysToBatizado} days</h3>
          <p>{BATIZADO_DATE_TBC ? 'Date TBC — ' : ''}Finish your course to earn your corda at the big day</p>
        </div>
      </div>
      <div class="sr-card sr-stat-card" data-anim="card" style="--tilt:-0.3deg">
        <span class="sr-icon-badge sr-icon-badge--lime">
          <svg width="24" height="24" viewBox="0 0 24 24"><path d="M12 2l2.9 6.26L21.5 9.27l-5 4.87 1.18 6.88L12 17.77l-5.68 3.25L7.5 14.14l-5-4.87 6.6-1.01L12 2z" fill="#fff"/></svg>
        </span>
        <div>
          <h3>{STUDENT.stars} stars · {STUDENT.badges} badges</h3>
          <p>{STUDENT.xp}/{STUDENT.xpToNext} XP toward Corda {nextCorda.label}</p>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    import '../../directions/sticker/motion.js';
  </script>
</Base>
