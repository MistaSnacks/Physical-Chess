---
// movements.astro — Sticker Roda / Movements lesson player
import { ClientRouter } from 'astro:transitions';
import Base from '../../layouts/Base.astro';
import Nav from '../../directions/sticker/Nav.astro';
import Footer from '../../directions/sticker/Footer.astro';
import '../../directions/sticker/theme.css';
import YouTube from '../../components/YouTube.astro';
import { MODULES, moduleProgress } from '../../data/curriculum.js';
import { yt } from '../../data/media.js';

const mod = MODULES.find((m) => m.id === 'movements');
const prog = moduleProgress(mod);
const currentLesson = mod.lessons.find((l) => !l.completed) || mod.lessons[0];
const drillLesson = mod.lessons.find((l) => l.type === 'drill');

function lessonState(lesson) {
  if (lesson.completed) return 'done';
  if (lesson.id === currentLesson.id) return 'current';
  return 'upcoming';
}

const TYPE_LABEL = { video: 'Watch', drill: 'Practice', reading: 'Read', quiz: 'Quiz' };
---

<Base title="Movements — Sticker Roda — Physical Chess" direction="sticker">
  <Fragment slot="head">
    <ClientRouter />
  </Fragment>

  <Nav active="movements" />

  <main class="sr-lesson-page wrap" transition:animate="fade">
    <div class="sr-lesson-crumb">
      <a class="sr-btn sr-btn--ghost sr-lesson-crumb__back" href="/sticker/dashboard">
        <svg width="14" height="14" viewBox="0 0 24 24"><path d="M15 4 L7 12 L15 20" fill="none" stroke="var(--color-ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        My Journey
      </a>
      <span class="sr-icon-badge sr-icon-badge--sky" style="width:54px;height:54px;transform:rotate(-4deg);">
        <svg width="28" height="28" viewBox="0 0 24 24"><path d="M12 5.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" fill="var(--color-ink)"/><path d="M12 8v5M12 10l-5-2M12 11l5 2M12 13l-4 6M12 13l4 6.5" fill="none" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round"/></svg>
      </span>
      <h1>Movements</h1>
      <span class="sr-chip sr-chip--sky">{prog.completed}/{prog.total} lessons · {prog.percent}%</span>
    </div>

    <div class="sr-lesson-layout">
      <div class="sr-lesson-list" data-stagger>
        {mod.lessons.map((lesson, i) => {
          const state = lessonState(lesson);
          return (
            <div class="sr-card sr-lesson-item" data-anim="card" data-state={state} style={`--tilt:${(i % 2 === 0 ? -0.8 : -0.1) + (i * 0.15)}deg`}>
              <span class="sr-lesson-item__icon" aria-hidden="true">
                {lesson.completed ? (
                  <svg width="16" height="16" viewBox="0 0 24 24"><path d="M4 12.5 L9.5 18 L20 6.5" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                ) : (
                  <span style="font-family:var(--font-display); font-weight:700; color:var(--color-ink); font-size:14px;">{i + 1}</span>
                )}
              </span>
              <div>
                <p class="sr-lesson-item__title">{lesson.title}</p>
                <p class="sr-lesson-item__meta">{TYPE_LABEL[lesson.type]} · {lesson.minutes} min</p>
              </div>
            </div>
          );
        })}
      </div>

      <div class="sr-card sr-lesson-panel" data-anim="card" style="--tilt:0deg">
        <div class="sr-lesson-panel__head">
          <h2>{currentLesson.title}</h2>
          <span class="sr-chip sr-chip--sun">{TYPE_LABEL[currentLesson.type]} · {currentLesson.minutes} min</span>
        </div>

        {currentLesson.videoKey && (
          <div class="sr-lesson-panel__video">
            <YouTube id={yt(currentLesson.videoKey)} title={currentLesson.title} controls />
          </div>
        )}

        <p class="sr-lesson-panel__summary">{currentLesson.summary}</p>
        <p class="sr-video-card credit" style="margin:0; padding:0;">Video: SoChlo Productions</p>

        <div class="sr-lesson-panel__actions" data-lesson-card data-completed={currentLesson.completed ? 'true' : 'false'}>
          <button class="sr-btn sr-btn--lime" type="button" data-mark-complete disabled={currentLesson.completed}>
            {currentLesson.completed ? 'Marked complete' : 'Mark complete'}
          </button>
          <span class="sr-chip sr-chip--done" data-chip="done" hidden={!currentLesson.completed}>
            <svg width="14" height="14" viewBox="0 0 24 24"><path d="M4 12.5 L9.5 18 L20 6.5" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Done!
          </span>
        </div>
      </div>
    </div>

    {drillLesson && (
      <div class="sr-card sr-drill-card" data-anim="card" style="--tilt:-0.6deg">
        <span class="sr-icon-badge sr-icon-badge--coral sr-drill-card__icon">
          <svg width="26" height="26" viewBox="0 0 24 24"><circle cx="7" cy="5" r="2.3" fill="#fff"/><path d="M7 8 L8 13 L15 15 L21 11 M8 13 L6 20 M15 15 L17 20.5" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <div>
          <h3>Practice drill · {drillLesson.title}</h3>
          <p>{drillLesson.summary}</p>
        </div>
        {drillLesson.completed && (
          <span class="sr-chip sr-chip--done" data-chip="done" style="margin-left:auto;">
            <svg width="14" height="14" viewBox="0 0 24 24"><path d="M4 12.5 L9.5 18 L20 6.5" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Done!
          </span>
        )}
      </div>
    )}
  </main>

  <Footer />

  <script>
    import '../../directions/sticker/motion.js';
  </script>
</Base>
