---
// batizado.astro — Sticker Roda / Graduation / Batizado
import { ClientRouter } from 'astro:transitions';
import Base from '../../layouts/Base.astro';
import Nav from '../../directions/sticker/Nav.astro';
import Footer from '../../directions/sticker/Footer.astro';
import '../../directions/sticker/theme.css';
import Countdown from '../../components/Countdown.astro';
import Gallery from '../../components/Gallery.astro';
import YouTube from '../../components/YouTube.astro';
import { PHOTOS, wix, yt } from '../../data/media.js';
import { INTRO, MOMENTS, CORDAS, BATIZADO_DATE, BATIZADO_DATE_TBC, cordaIndex } from '../../data/batizado.js';
import { STUDENT } from '../../data/student.js';

const currentIndex = cordaIndex(STUDENT.corda);

const GALLERY_PHOTOS = [
  'heroRoda',
  'bannerBatizado',
  'cocoTubarao',
  'kidsParents',
  'voltaDoMundo',
  'toroMindinha',
  'trocaDeCordas',
  'voltaAdults',
  'celebration2018',
  'cordsTable2018',
  'batizado2019a',
  'batizado2019b',
  'groupFoto2019',
  'xampuGasparzinho',
  'troca2019',
  'batizado2022',
];

const VIDEOS = [
  { key: 'batizado2026', label: 'Batizado 2026' },
  { key: 'batizado2025', label: 'Batizado 2025' },
  { key: 'batizado2024', label: 'Batizado 2024' },
];
---

<Base title="Graduation · Batizado — Sticker Roda — Physical Chess" direction="sticker">
  <Fragment slot="head">
    <ClientRouter />
  </Fragment>

  <Nav active="batizado" />

  <main transition:animate="fade">
    <section class="sr-batizado-hero wrap">
      <div class="sr-batizado-hero__copy">
        <span class="sr-hero__eyebrow" data-anim="card" style="--tilt:-1.5deg">Graduation</span>
        <h1>Batizado 2026</h1>
        <p>{INTRO}</p>
        <Countdown target={BATIZADO_DATE} dateTbc={BATIZADO_DATE_TBC} />
      </div>
      <div class="sr-card sr-batizado-hero__photo" data-anim="card" style="--tilt:2.5deg">
        <img src={wix('bannerBatizado', 720, 540)} alt={PHOTOS.bannerBatizado.caption} loading="eager" width="720" height="540" />
      </div>
    </section>

    <section class="sr-section wrap">
      <div class="sr-section__head">
        <p class="sr-eyebrow">What happens at Batizado</p>
        <h2 class="sr-section__title">Six moments, one ceremony</h2>
      </div>
      <div class="sr-moments" data-stagger>
        {MOMENTS.map((m, i) => (
          <div class="sr-card sr-moment" data-anim="card" style={`--tilt:${i % 2 === 0 ? '-0.8deg' : '0.7deg'}`}>
            <div class="sr-moment__photo">
              <img src={wix(m.photoKey, 480, 360)} alt={PHOTOS[m.photoKey]?.caption || m.title} loading="lazy" width="480" height="360" />
            </div>
            <div>
              <p class="sr-moment__num">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="sr-moment__title">{m.title}</h3>
              <p class="sr-moment__copy">{m.copy}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="sr-section wrap">
      <div class="sr-section__head">
        <p class="sr-eyebrow">Cordas</p>
        <h2 class="sr-section__title">The rank track</h2>
        <p class="sr-section__sub">{STUDENT.firstName} is currently Corda {CORDAS[currentIndex].label}.</p>
      </div>
      <div class="sr-cordas-track" data-stagger>
        {CORDAS.map((c, i) => (
          <div class="sr-card sr-corda-node" data-anim="card" data-current={i === currentIndex ? 'true' : 'false'} style={`--tilt:${i % 2 === 0 ? '-1deg' : '1deg'}`}>
            {i === currentIndex && <span class="you-are">You are here</span>}
            <span class="sr-corda-swatch-lg" style={`background:${c.color}`}></span>
            <span class="label">{c.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="sr-section wrap sr-gallery-wrap">
      <div class="sr-section__head">
        <p class="sr-eyebrow">Batizado Media</p>
        <h2 class="sr-section__title">Photos from the roda</h2>
      </div>
      <Gallery photos={GALLERY_PHOTOS} width={480} height={360} eager={4} />
    </section>

    <section class="sr-section wrap">
      <div class="sr-section__head">
        <p class="sr-eyebrow">Watch</p>
        <h2 class="sr-section__title">Batizado, year by year</h2>
      </div>
      <div class="sr-videos-grid" data-stagger>
        {VIDEOS.map((v, i) => (
          <div class="sr-card sr-video-card" data-anim="card" style={`--tilt:${i % 2 === 0 ? '-1deg' : '1deg'}`}>
            <YouTube id={yt(v.key)} title={v.label} controls />
            <h3>{v.label}</h3>
            <p class="credit">Video: SoChlo Productions</p>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import '../../directions/sticker/motion.js';
  </script>
</Base>
