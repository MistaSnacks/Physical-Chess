---
// family/players/new.astro — create a player (SPEC §5.3). Kids never see
// this screen; a guardian fills it in. Program is set by invite code.
import { ClientRouter } from 'astro:transitions';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../directions/quest/Nav.astro';
import Footer from '../../../directions/quest/Footer.astro';
import AvatarPicker from '../../../components/quest/AvatarPicker.astro';
import '../../../directions/quest/tokens.css';
import '../../../directions/quest/theme.css';
---

<Base title="Add a player — Physical Chess" direction="quest">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <Nav active="family" />
    <main class="quest-screen quest-screen--narrow">
      <p class="quest-screen__eyebrow" data-quest-enter>Grown-ups</p>
      <h1 class="quest-screen__title" data-quest-enter>Add a player</h1>
      <p class="quest-screen__sub" data-quest-enter>Only a first name is needed. We never ask a child for an email or password.</p>
      <form class="quest-card" data-player-form data-quest-enter>
        <div class="quest-form__error" data-error hidden></div>
        <div class="quest-field"><label class="quest-field__label" for="firstName">First name</label><input class="quest-field__input" id="firstName" name="firstName" required maxlength="40" /></div>
        <div class="quest-field"><label class="quest-field__label" for="apelido">Apelido (capoeira nickname)</label><input class="quest-field__input" id="apelido" name="apelido" maxlength="40" /><span class="quest-field__hint">Optional. Their mestre may give one later.</span></div>
        <AvatarPicker />
        <div class="quest-field">
          <label class="quest-field__label" for="inviteCode">Class invite code</label>
          <input class="quest-field__input" id="inviteCode" name="inviteCode" maxlength="24" autocomplete="off" />
          <span class="quest-field__hint" data-program-hint>Ask your coach for the code on the class flyer. Leave blank if you train at home.</span>
        </div>
        <div class="quest-field"><label class="quest-field__label" for="birthYear">Birth year</label><input class="quest-field__input" id="birthYear" name="birthYear" type="number" min="2005" max="2022" /><span class="quest-field__hint">Optional. Helps coaches group classes.</span></div>
        <label class="quest-toggle">
          <input type="checkbox" name="mayPlayInClass" checked />
          <span>May play in class on a shared tablet</span>
        </label>
        <div class="quest-btn-row"><button class="quest-btn quest-btn--lime" type="submit">Add player</button><a class="quest-btn quest-btn--ghost" href="/family">Cancel</a></div>
      </form>
    </main>
    <Footer />
  </div>
  <script>
    import '../../../directions/quest/motion.js';
    import { requireSession } from '../../../lib/auth-guard.js';
    import { createPlayer, selectPlayer } from '../../../lib/actions.js';
    import { requireGrownUp } from '../../../lib/grown-up-gate.js';
    import { programByInvite } from '../../../content/programs.js';

    function bindInvite(form) {
      const input = form.querySelector('[name=inviteCode]');
      const hint = form.querySelector('[data-program-hint]');
      const paint = () => {
        const code = String(input.value || '').trim();
        if (!code) { hint.textContent = 'Ask your coach for the code on the class flyer. Leave blank if you train at home.'; return null; }
        const prog = programByInvite(code);
        if (prog) { hint.textContent = `This places them in ${prog.name}.`; return prog; }
        hint.textContent = 'That code does not match a class. Ask your coach.';
        return false;
      };
      input.addEventListener('input', paint);
      return paint;
    }

    async function init() {
      const s = await requireSession();
      if (!s) return;
      if (!(await requireGrownUp())) { location.replace('/who'); return; }
      const form = document.querySelector('[data-player-form]');
      const resolve = bindInvite(form);
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const err = form.querySelector('[data-error]');
        err.hidden = true;
        const fd = new FormData(form);
        const invite = String(fd.get('inviteCode') || '').trim();
        const prog = resolve();
        if (invite && prog === false) { err.textContent = 'That invite code does not match a class.'; err.hidden = false; return; }
        try {
          const player = await createPlayer({
            firstName: String(fd.get('firstName')).trim(),
            apelido: String(fd.get('apelido') || '').trim(),
            avatar: { animal: fd.get('animal'), color: fd.get('color') },
            program: prog ? prog.key : null,
            birthYear: fd.get('birthYear') ? Number(fd.get('birthYear')) : null,
            mayPlayInClass: form.mayPlayInClass.checked,
          });
          await selectPlayer(player.id);
          location.href = '/journey';
        } catch (ex) {
          err.textContent = 'Could not add the player. Please try again.';
          err.hidden = false;
          console.error(ex);
        }
      });
    }
    document.addEventListener('astro:page-load', init);
    init();
  </script>
</Base>
