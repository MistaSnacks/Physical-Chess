---
// family/report.astro — guardian report card (SPEC §5.3). Query: ?player=
import { ClientRouter } from 'astro:transitions';
import Base from '../../layouts/Base.astro';
import Nav from '../../directions/quest/Nav.astro';
import Footer from '../../directions/quest/Footer.astro';
import '../../directions/quest/tokens.css';
import '../../directions/quest/theme.css';
---

<Base title="Report card — Physical Chess" direction="quest">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <Nav active="family" />
    <main class="quest-screen quest-report">
      <p class="quest-screen__eyebrow" data-quest-enter>Grown-ups</p>
      <h1 class="quest-screen__title" data-quest-enter>Report card</h1>
      <p class="quest-screen__sub" data-quest-enter>Progress, practice, and a download of everything we hold about this player.</p>
      <p class="quest-card quest-card--note" data-missing hidden>We could not find that player. <a href="/family" style="color:var(--quest-mango)">Back to Family</a></p>
      <div data-report hidden></div>
    </main>
    <Footer />
  </div>
  <script>
    import '../../directions/quest/motion.js';
    import { requireSession } from '../../lib/auth-guard.js';
    import { selectPlayer, confirmPractice } from '../../lib/actions.js';
    import { requireGrownUp } from '../../lib/grown-up-gate.js';
    import { store } from '../../lib/store.js';
    import { avatarSvg } from '../../lib/avatar.js';
    import { lessonById } from '../../content/lessons.js';
    import { programByKey } from '../../content/programs.js';
    import { CORDAS } from '../../data/batizado.js';
    import { EVENT } from '../../lib/game/events.js';
    import { downloadCsv, downloadJson, playerExportPayload } from '../../lib/export.js';

    const TZ = { timeZone: 'America/New_York', dateStyle: 'medium', timeStyle: 'short' };
    const fmt = (iso) => { try { return new Intl.DateTimeFormat('en-US', TZ).format(new Date(iso)); } catch { return iso || ''; } };
    const cordaLabel = (id) => CORDAS.find((c) => c.id === id)?.label || 'Crua';
    const lessonTitle = (id) => lessonById(id)?.title || id || '—';

    const LABELS = {
      [EVENT.VIDEO_DONE]: 'Watched a lesson',
      [EVENT.READING_DONE]: 'Finished a reading',
      [EVENT.DRILL_DONE]: 'Logged a practice',
      [EVENT.PRACTICE_CONFIRMED]: 'You saw this practice',
      [EVENT.QUIZ_ANSWERED]: 'Answered a quiz question',
      [EVENT.QUIZ_DONE]: 'Finished a quiz',
      [EVENT.MODULE_CLEARED]: 'Cleared a module',
      [EVENT.DESAFIO_DONE]: 'Finished Desafio do Dia',
      [EVENT.STREAK_WEEK]: 'Saved a roda week',
      [EVENT.PATCH_EARNED]: 'Earned a patch',
      [EVENT.COACH_XP]: 'Coach bonus',
      [EVENT.CORDA_AWARDED]: 'Corda awarded',
      [EVENT.ATTENDANCE]: 'Class stamp',
      [EVENT.GLOSSARY_MASTERED]: 'Learned a Portuguese word',
      [EVENT.PLAYER_CREATED]: 'Player added',
      [EVENT.PLAYER_DELETED]: 'Player deleted',
    };

    function starRow(n) {
      const on = Number(n) || 0;
      return `<span class="quest-stars" aria-label="${on} of 3 stars">${[1, 2, 3].map((i) =>
        `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.4 6.6H21l-5.4 4.2 2 6.7L12 16.8 6.4 20.5l2-6.7L3 9.6h6.6z" fill="${i <= on ? '#FFB238' : 'none'}" stroke="#FFB238" stroke-width="1.6"/></svg>`
      ).join('')}</span>`;
    }

    function render(root, { player, snapshot, events, account }) {
      const program = programByKey(player.program);
      const drills = events.filter((e) => e.type === EVENT.DRILL_DONE);
      const seen = new Set(events.filter((e) => e.type === EVENT.PRACTICE_CONFIRMED).map((e) => e.lessonId));
      const byLesson = new Map();
      for (const d of drills) byLesson.set(d.lessonId, d);
      const cordaHist = events.filter((e) => e.type === EVENT.CORDA_AWARDED);
      const lessonsDone = Object.values(snapshot.lessons).filter((l) => l.status === 'done');
      const timeline = [...events].sort((a, b) => new Date(b.occurredAt) - new Date(a.occurredAt)).slice(0, 50);
      const fileBase = `physical-chess-${(player.apelido || player.firstName || 'player').toLowerCase().replace(/\s+/g, '-')}`;

      root.innerHTML = `
        <section class="quest-card quest-report__hero">
          <span class="quest-report__avatar">${avatarSvg(player.avatar, 88)}</span>
          <div>
            <h2 class="quest-card__title">${escapeHtml(player.apelido || player.firstName)}</h2>
            <p class="quest-card__body">${escapeHtml(player.firstName)}${program ? ` · ${escapeHtml(program.name)}` : ''}</p>
          </div>
        </section>
        <section class="quest-report__stats">
          <div class="quest-stat"><span class="quest-stat__label">Level</span><span class="quest-stat__value">${snapshot.level.level}</span><span class="quest-stat__hint">${escapeHtml(snapshot.level.title)}</span></div>
          <div class="quest-stat"><span class="quest-stat__label">XP</span><span class="quest-stat__value">${snapshot.xp}</span><span class="quest-stat__hint">${snapshot.level.xpToNext ? snapshot.level.xpToNext + ' to next' : 'max'}</span></div>
          <div class="quest-stat"><span class="quest-stat__label">Stars</span><span class="quest-stat__value">${snapshot.stars}</span><span class="quest-stat__hint">${snapshot.lessonsDone} lessons</span></div>
          <div class="quest-stat"><span class="quest-stat__label">Roda weeks</span><span class="quest-stat__value">${snapshot.streak.weeks}</span><span class="quest-stat__hint">${snapshot.streak.activeThisWeek ? 'active this week' : 'resting'}</span></div>
          <div class="quest-stat"><span class="quest-stat__label">Corda</span><span class="quest-stat__value">${escapeHtml(cordaLabel(snapshot.cordaCurrent))}</span><span class="quest-stat__hint">Coach awarded</span></div>
        </section>
        <section class="quest-card">
          <h2 class="quest-card__title">Batizado readiness</h2>
          <p class="quest-card__body">${snapshot.readiness.percent}% · ${snapshot.readiness.metCount} of ${snapshot.readiness.total}</p>
          <ul class="quest-checklist">
            ${snapshot.readiness.items.map((item) => `<li class="${item.met ? 'is-met' : ''}"><span class="quest-check" aria-hidden="true"></span>${escapeHtml(item.label)}</li>`).join('')}
          </ul>
        </section>
        <section class="quest-card">
          <h2 class="quest-card__title">Lessons done</h2>
          ${lessonsDone.length ? `<table class="quest-table"><thead><tr><th>Lesson</th><th>Stars</th></tr></thead><tbody>${lessonsDone.map((l) => `<tr><td>${escapeHtml(lessonTitle(l.lessonId))}</td><td>${starRow(l.bestStars)}</td></tr>`).join('')}</tbody></table>` : '<p class="quest-card__body">No lessons finished yet.</p>'}
        </section>
        <section class="quest-card">
          <h2 class="quest-card__title">Patches</h2>
          ${snapshot.patches.length ? `<ul class="quest-patch-list">${snapshot.patches.map((p) => `<li><strong>${escapeHtml(p.title)}</strong> · ${escapeHtml(p.subtitle || '')}</li>`).join('')}</ul>` : '<p class="quest-card__body">No patches yet.</p>'}
        </section>
        <section class="quest-card">
          <h2 class="quest-card__title">Corda history</h2>
          ${cordaHist.length ? `<ol class="quest-timeline">${cordaHist.map((e) => `<li><span>${fmt(e.occurredAt)}</span> ${escapeHtml(cordaLabel(e.payload?.corda))}${e.payload?.event ? ` · ${escapeHtml(e.payload.event)}` : ''}</li>`).join('')}</ol>` : `<p class="quest-card__body">Starting corda: ${escapeHtml(cordaLabel(snapshot.cordaCurrent))}. A coach awards the next one at Batizado.</p>`}
        </section>
        <section class="quest-card">
          <h2 class="quest-card__title">Practice log</h2>
          <p class="quest-card__body">Tap I saw it when you watched them train at home.</p>
          <div data-practice>
            ${[...byLesson.values()].length ? `<ul class="quest-practice">${[...byLesson.values()].map((d) => {
              const confirmed = seen.has(d.lessonId);
              return `<li data-drill="${escapeHtml(d.lessonId)}" data-module="${escapeHtml(d.moduleId || '')}">
                <div><strong>${escapeHtml(lessonTitle(d.lessonId))}</strong><span>${fmt(d.occurredAt)}</span></div>
                ${confirmed ? '<span class="quest-chip">You saw it</span>' : `<button class="quest-btn quest-btn--lime" type="button" data-saw>I saw it</button>`}
              </li>`;
            }).join('')}</ul>` : '<p class="quest-card__body">No drills logged yet.</p>'}
          </div>
        </section>
        <section class="quest-card">
          <h2 class="quest-card__title">Activity</h2>
          <ol class="quest-timeline">
            ${timeline.map((e) => `<li><span>${fmt(e.occurredAt)}</span> ${escapeHtml(LABELS[e.type] || e.type)}${e.lessonId ? ` · ${escapeHtml(lessonTitle(e.lessonId))}` : ''}${e.xp ? ` · +${e.xp} XP` : ''}</li>`).join('') || '<li>Nothing recorded yet.</li>'}
          </ol>
        </section>
        <div class="quest-btn-row" data-print-hide>
          <button class="quest-btn" type="button" data-print>Print</button>
          <button class="quest-btn quest-btn--lime" type="button" data-csv>Download CSV</button>
          <button class="quest-btn quest-btn--ghost" type="button" data-json>Download JSON</button>
          <a class="quest-btn quest-btn--ghost" href="/family/players/edit?player=${encodeURIComponent(player.id)}">Edit player</a>
        </div>
      `;

      root.querySelector('[data-print]')?.addEventListener('click', () => window.print());
      root.querySelector('[data-csv]')?.addEventListener('click', () => downloadCsv(`${fileBase}.csv`, events));
      root.querySelector('[data-json]')?.addEventListener('click', () => downloadJson(`${fileBase}.json`, playerExportPayload({ player, snapshot, events, account })));
      root.querySelectorAll('[data-saw]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          const li = btn.closest('[data-drill]');
          await confirmPractice(player.id, { lessonId: li.dataset.drill, moduleId: li.dataset.module || null });
          const s = store.get();
          render(root, { player: s.player, snapshot: s.snapshot, events: s.events, account: s.session.account });
        });
      });
    }

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    async function init() {
      const s = await requireSession();
      if (!s) return;
      if (!(await requireGrownUp())) { location.replace('/who'); return; }
      const main = document.querySelector('main');
      if (main.dataset.wp4Bound) return;
      main.dataset.wp4Bound = '1';
      const id = new URLSearchParams(location.search).get('player');
      const row = s.session.players.find((p) => p.id === id);
      if (!row) { document.querySelector('[data-missing]').hidden = false; return; }
      await selectPlayer(id);
      const state = store.get();
      const root = document.querySelector('[data-report]');
      root.hidden = false;
      render(root, { player: state.player, snapshot: state.snapshot, events: state.events, account: state.session.account });
    }
    document.addEventListener('astro:page-load', init);
    init();
  </script>
</Base>
