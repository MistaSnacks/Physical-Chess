---
// coach/attendance.astro — tap-to-stamp grid (SPEC §5.4).
import { ClientRouter } from 'astro:transitions';
import Base from '../../layouts/Base.astro';
import Nav from '../../directions/quest/Nav.astro';
import Footer from '../../directions/quest/Footer.astro';
import CoachNav from '../../components/quest/CoachNav.astro';
import '../../directions/quest/tokens.css';
import '../../directions/quest/theme.css';
---

<Base title="Attendance — Physical Chess" direction="quest">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <Nav active="coach" />
    <main class="quest-screen quest-screen--wide quest-coach-screen">
      <p class="quest-screen__eyebrow" data-quest-enter>Coach</p>
      <h1 class="quest-screen__title" data-quest-enter>Today’s class</h1>
      <p class="quest-screen__sub" data-quest-enter>Choose a turma and tap everyone who trained. Save once the circle is complete.</p>
      <CoachNav active="attendance" />
      <form class="quest-card quest-attend-bar" data-bar data-quest-enter>
        <div class="quest-field"><label class="quest-field__label" for="program">Program</label>
          <select class="quest-field__input" id="program" name="program" data-program></select>
        </div>
        <div class="quest-field"><label class="quest-field__label" for="date">Date</label>
          <input class="quest-field__input" id="date" name="date" type="date" data-date />
        </div>
        <button class="quest-btn quest-btn--lime" type="submit" data-save>Save stamps</button>
      </form>
      <div class="quest-players quest-attendance-grid" data-grid data-quest-enter aria-live="polite"></div>
      <p class="quest-field__hint quest-coach-status" data-status role="status"></p>
    </main>
    <Footer />
  </div>
  <script>
    import { esc } from '../../lib/html.js';
    import '../../directions/quest/motion.js';
    import { requireSession } from '../../lib/auth-guard.js';
    import { getCoach } from '../../lib/repo/coachRepo.js';
    import { programsForAccount, NO_PROGRAMS_COPY } from '../../lib/coach.js';
    import { nyDate } from '../../lib/game/streaks.js';
    import { avatarSvg } from '../../lib/avatar.js';

    async function init() {
      const s = await requireSession({ role: 'coach' });
      if (!s) return;
      if (s.session.account.role === 'admin') document.querySelectorAll('[data-coach-roles]').forEach((el) => { el.hidden = false; });
      const coach = await getCoach();
      const programs = programsForAccount(s.session.account);
      const sel = document.querySelector('[data-program]');
      const date = document.querySelector('[data-date]');
      const grid = document.querySelector('[data-grid]');
      const status = document.querySelector('[data-status]');
      if (!programs.length) {
        document.querySelector('[data-bar]')?.setAttribute('hidden', '');
        grid.innerHTML = `<p class="quest-card quest-card--note" data-empty-programs>${NO_PROGRAMS_COPY}</p>`;
        return;
      }
      sel.innerHTML = programs.map((p) => `<option value="${p.key}">${p.name}</option>`).join('');
      date.value = nyDate();
      const picked = new Set();

      async function render() {
        const rows = await coach.roster(sel.value);
        const detail = await Promise.all(rows.map((r) => coach.player(r.id)));
        const stamped = new Set();
        for (const d of detail) {
          if (!d) continue;
          for (const a of d.attendance || []) if (a.classDate === date.value && a.program === sel.value) stamped.add(d.player.id);
        }
        picked.clear();
        stamped.forEach((id) => picked.add(id));
        grid.innerHTML = rows.map((p) => `<button type="button" class="quest-player-card ${picked.has(p.id) ? 'is-stamped' : ''}" data-id="${esc(p.id)}" aria-pressed="${picked.has(p.id)}"><span class="quest-player-card__avatar">${avatarSvg(p.avatar, 80)}</span><span class="quest-player-card__name">${esc(p.apelido)}</span><span class="quest-player-card__meta">${esc(p.firstName)}</span><span class="quest-attendance-state">${picked.has(p.id) ? 'Stamped' : 'Tap to stamp'}</span></button>`).join('');
        grid.querySelectorAll('[data-id]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            if (picked.has(id)) picked.delete(id); else picked.add(id);
            btn.classList.toggle('is-stamped', picked.has(id));
            btn.setAttribute('aria-pressed', String(picked.has(id)));
            btn.querySelector('.quest-attendance-state').textContent = picked.has(id) ? 'Stamped' : 'Tap to stamp';
          });
        });
      }

      sel.addEventListener('change', render);
      date.addEventListener('change', render);
      document.querySelector('[data-bar]').addEventListener('submit', async (ev) => {
        ev.preventDefault();
        status.textContent = 'Saving…';
        await coach.stampAttendance({ playerIds: [...picked], program: sel.value, classDate: date.value });
        status.textContent = `Saved ${picked.size} stamp${picked.size === 1 ? '' : 's'} for ${date.value}.`;
        await render();
      });
      await render();
    }
    document.addEventListener('astro:page-load', init);
    init();
  </script>
</Base>
