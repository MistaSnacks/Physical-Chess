+  column-gap: 24px;
+}
+.quest-report .quest-timeline li {
+  padding: 0 0 10px;
+  border-bottom: 1px solid var(--quest-leaf-border);
+  font-size: 16px;
+  line-height: 1.45;
+}
+.quest-report .quest-timeline li span {
+  margin-bottom: 3px;
+  font-size: 12px;
+}
+.quest-report-stars {
+  position: static;
+  display: inline-flex;
+  gap: 4px;
+  vertical-align: middle;
+}
+.quest-report-stars svg { width: 22px; height: 22px; }
+.quest-report__actions {
+  padding-top: 4px;
+  justify-content: flex-end;
+}
+
+.quest-btn:focus-visible,
+.quest-player-card:focus-visible,
+.quest-family-card__report:focus-visible {
+  outline: 3px solid var(--quest-lime);
+  outline-offset: 3px;
+}
+.quest-btn--lime:focus-visible,
+.quest-family-card__report:focus-visible { outline-color: var(--quest-mango); }
+
+@media (max-width: 860px) {
+  .quest-family__settings-grid,
+  .quest-me__overview,
+  .quest-me__progress,
+  .quest-report__grid { grid-template-columns: 1fr; }
+  .quest-report__practice,
+  .quest-report__activity { grid-column: auto; }
+  .quest-report__activity .quest-timeline { grid-template-columns: 1fr; }
+  .quest-me__patches .quest-patch-wall { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+}
+
+@media (max-width: 600px) {
+  .quest-who__players,
+  .quest-family__players { grid-template-columns: 1fr; gap: 16px; }
+  .quest-who__players .quest-player-card,
+  .quest-family__players > .quest-player-card,
+  .quest-family-card .quest-player-card { min-height: 0; }
+  .quest-player-form-screen > .quest-card { padding: 24px; }
+  .quest-me__stats { grid-template-columns: 1fr 1fr; }
+  .quest-me__stats li { flex-direction: column; align-items: flex-start; gap: 4px; }
+  .quest-report__hero { flex-wrap: nowrap; padding: 18px; }
+  .quest-report__avatar { flex: 0 0 72px; }
+  .quest-report__avatar svg { width: 72px; height: 72px; }
+  .quest-report__stats { gap: 10px; }
+  .quest-report__stats .quest-stat:last-child { grid-column: 1 / -1; }
+  .quest-report__actions { display: grid; grid-template-columns: 1fr 1fr; }
+  .quest-report__actions .quest-btn { min-width: 0; padding-inline: 14px; }
+}
+
+@media (max-width: 430px) {
+  .quest-player-form-screen > .quest-card { padding: 22px 20px; }
+  .quest-me__patches .quest-patch-wall { gap: 12px 8px; }
+  .quest-me__stats li > span { font-size: 12px; }
+  .quest-report__hero { gap: 12px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .quest-family-card,
+  .quest-family-card__report { transition: none; }
+  .quest-family-card:hover { transform: none; }
+}
+
+@media print {
+  .quest-report__grid { display: block; }
+  .quest-report__grid > .quest-card { margin-top: 12px; }
+  .quest-report__activity .quest-timeline { grid-template-columns: 1fr; }
+}
