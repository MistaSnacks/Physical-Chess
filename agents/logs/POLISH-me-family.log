+  transition: transform .18s var(--quest-ease), box-shadow .18s var(--quest-ease), border-color .18s var(--quest-ease);
+}
+.quest-family-card:hover {
+  transform: translateY(-4px);
+  border-color: var(--quest-lime);
+  box-shadow: 0 8px 0 var(--quest-palm-shadow);
+}
+.quest-family-card:focus-within {
+  border-color: var(--quest-lime);
