const colors = Object.entries(AVATAR_COLORS);
---

<Base title="Me — Physical Chess" direction="quest">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <Nav active="me" />
    <main class="quest-screen quest-me">
      <p class="quest-screen__eyebrow" data-quest-enter>Level <span data-bind="level.level">1</span> · <span data-bind="level.title">Iniciante</span></p>
      <h1 class="quest-screen__title" data-quest-enter><span data-bind="player.apelido">Player</span></h1>
      <p class="quest-screen__sub" data-quest-enter>Your <strong>apelido</strong> is how the roda knows you. This page is yours.</p>

      <div data-quest-enter>
        <Bira moment="welcome" compact />
      </div>

      <Hud />

      <section class="quest-card quest-me__card" data-quest-enter data-avatar-editor>
        <h2 class="quest-card__title">Your look</h2>
        <p class="quest-card__body">Tap an animal and a color. It saves as you go.</p>
        <form class="quest-me__avatar-form">
          <div class="quest-field">
            <span class="quest-field__label" id="me-animal-label">Animal</span>
            <div class="quest-avatar-grid" data-avatars role="radiogroup" aria-labelledby="me-animal-label">
              {ANIMALS.map((a) => (
                <label>
                  <input type="radio" name="animal" value={a} aria-label={a} />
                  <span data-animal={a}></span>
                </label>
              ))}
            </div>
          </div>
          <div class="quest-field">
            <span class="quest-field__label" id="me-color-label">Color</span>
            <div class="quest-swatches" role="radiogroup" aria-labelledby="me-color-label">
              {colors.map(([k, hex]) => (
                <label style={`background:${hex}`}>
                  <input type="radio" name="color" value={k} aria-label={k} />
                  <span></span>
                </label>
              ))}
            </div>
          </div>
          <p class="quest-field__hint" data-avatar-status aria-live="polite"></p>
        </form>
      </section>

      <section class="quest-card quest-me__card" data-quest-enter>
        <p class="quest-me__level-eye">Level <span data-bind="level.level">1</span></p>
        <h2 class="quest-card__title" data-bind="level.title">Iniciante</h2>
        <p class="quest-me__bira" data-bind="level.bira"></p>
        <p class="quest-card__body"><span data-bind="xp">0</span> XP. <span data-bind="level.xpToNext">0</span> to the next title.</p>
      </section>

      <section class="quest-card quest-me__card" data-quest-enter>
        <h2 class="quest-card__title">Stats</h2>
        <ul class="quest-me__stats">
          <li><span data-bind="lessonsDone">0</span> / <span data-bind="lessonsTotal">0</span> lessons</li>
          <li><span data-bind="stars">0</span> stars</li>
          <li><span data-bind="streak.weeks">0</span> roda weeks</li>
          <li><span data-bind="practices">0</span> practices · <span data-bind="practicesConfirmed">0</span> seen</li>
          <li><span data-bind="desafios">0</span> desafios</li>
          <li><span data-bind="glossaryMastered">0</span> Portuguese words</li>
        </ul>
      </section>

      <section class="quest-card quest-me__card" data-quest-enter>
        <h2 class="quest-card__title">Patch wall</h2>
        <p class="quest-card__body">Patches you earn stitch onto this wall.</p>
        <ul class="quest-patch-wall">
          {PATCHES.map((p) => (
            <li class="quest-patch-wall__item" data-patch-tile={p.key}>
              <Patch patch={p} earned={false} size={88} />
              <p class="quest-patch-wall__title">{p.title}</p>
              <p class="quest-patch-wall__rule">{p.subtitle}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="quest-card quest-me__card" data-quest-enter>
        <h2 class="quest-card__title">Batizado readiness</h2>
        <p class="quest-card__body">Your coach uses this list. XP does not award a corda.</p>
        <ul class="quest-ready-list" data-readiness-list></ul>
      </section>

      <section class="quest-card quest-me__card" data-quest-enter>
        <h2 class="quest-card__title">Corda history</h2>
        <ol class="quest-corda-log" data-corda-history hidden></ol>
        <p class="quest-card__body" data-corda-empty>Your first corda comes at Batizado.</p>
      </section>
    </main>
    <Footer />
    <LevelUp />
    <PatchUnlock />
  </div>
  <script>
    import '../directions/quest/motion.js';
    import { requireSession } from '../lib/auth-guard.js';
    import { bindDom, store } from '../lib/store.js';
    import { bindHud } from '../lib/map.js';
    import { updatePlayer } from '../lib/actions.js';
    import { avatarSvg } from '../lib/avatar.js';
    import { patchMarkup } from '../lib/patch-art.js';
    import { PATCHES } from '../content/patches.js';
    import { CORDAS } from '../data/batizado.js';
    import { EVENT } from '../lib/game/events.js';

    function paintAvatarGrid(form, avatar) {
      form.querySelectorAll('[data-animal]').forEach((el) => {
        el.innerHTML = avatarSvg({ animal: el.dataset.animal, color: avatar.color }, 56);
      });
      const animal = form.querySelector(`input[name="animal"][value="${avatar.animal}"]`);
      const color = form.querySelector(`input[name="color"][value="${avatar.color}"]`);
      if (animal) animal.checked = true;
      if (color) color.checked = true;
    }

    function paintWall(snapshot) {
      const earned = new Set((snapshot.patches || []).map((p) => p.key));
      document.querySelectorAll('[data-patch-tile]').forEach((tile) => {
        const key = tile.dataset.patchTile;
        const patch = PATCHES.find((p) => p.key === key);
        const on = earned.has(key);
        tile.classList.toggle('is-earned', on);
        const face = tile.querySelector('[data-patch-key], .quest-patch-wrap');
        if (patch && face) {
          face.innerHTML = patchMarkup({
            art: patch.art,
            tier: patch.tier,
            title: patch.title,
            earned: on,
            size: 88,
            stitching: false,
          });
        }
      });
    }

    function paintReady(snapshot) {
      const list = document.querySelector('[data-readiness-list]');
      if (!list) return;
      const items = snapshot.readiness?.items || [];
      list.innerHTML = items.map((item) => {
        const pct = Math.max(0, Math.min(100, item.progress || 0));
        return `<li class="quest-ready-list__item${item.met ? ' is-met' : ''}">
          <span class="quest-ready-list__label">${item.label}</span>
          <span class="quest-ready-list__bar"><span class="quest-ready-list__fill" style="transform:scaleX(${pct / 100})"></span></span>
          <span class="quest-ready-list__pct">${item.met ? 'Done' : pct + '%'}</span>
        </li>`;
      }).join('');
    }

    function paintCorda(events) {
      const log = document.querySelector('[data-corda-history]');
      const empty = document.querySelector('[data-corda-empty]');
      const awards = (events || []).filter((e) => e.type === EVENT.CORDA_AWARDED);
      if (!log || !empty) return;
      if (!awards.length) {
        log.hidden = true;
        empty.hidden = false;
        return;
      }
      empty.hidden = true;
      log.hidden = false;
      log.innerHTML = awards.map((e) => {
        const id = e.payload?.corda;
        const corda = CORDAS.find((c) => c.id === id);
        const when = e.occurredAt ? new Date(e.occurredAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
        const eventName = e.payload?.event || 'Batizado';
        return `<li><span class="quest-corda-log__swatch" style="background:${corda?.color || '#E8DCC3'}"></span><span>${corda?.label || id} · ${eventName} · ${when}</span></li>`;
      }).join('');
    }

    async function init() {
      const s = await requireSession({ player: true });
      if (!s) return;
      bindDom();
      bindHud();
      const form = document.querySelector('[data-avatar-editor] form');
      const player = store.get().player;
      if (form && player) {
        paintAvatarGrid(form, player.avatar || { animal: 'frog', color: 'lime' });
        form.addEventListener('change', async () => {
          const avatar = { animal: form.animal.value, color: form.color.value };
          paintAvatarGrid(form, avatar);
          const status = document.querySelector('[data-avatar-status]');
          try {
            await updatePlayer(player.id, { avatar });
            if (status) status.textContent = 'Saved.';
          } catch (err) {
            if (status) status.textContent = 'Could not save. Try again.';
            console.error(err);
          }
        });
      }
      const paint = (state) => {
        if (!state.snapshot) return;
        paintWall(state.snapshot);
        paintReady(state.snapshot);
        paintCorda(state.events);
      };
      store.subscribe(paint);
      if (s.isDemo && !document.querySelector('.quest-demo-badge')) {
        const b = document.createElement('div');
        b.className = 'quest-demo-badge';
        b.textContent = 'Demo';
        document.body.appendChild(b);
      }
    }
    document.addEventListener('astro:page-load', init);
    init();
  </script>
</Base>

--- src/pages/family/index.astro ---
---
// family/index.astro — guardian home (SPEC §5.3): players, report links,
// settings, sign out, delete my account.
import { ClientRouter } from 'astro:transitions';
import Base from '../../layouts/Base.astro';
import Nav from '../../directions/quest/Nav.astro';
import Footer from '../../directions/quest/Footer.astro';
import PlayerCard from '../../components/quest/PlayerCard.astro';
import '../../directions/quest/tokens.css';
import '../../directions/quest/theme.css';
---

<Base title="Family — Physical Chess" direction="quest">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <Nav active="family" />
    <main class="quest-screen">
      <p class="quest-screen__eyebrow" data-quest-enter>Grown-ups</p>
      <h1 class="quest-screen__title" data-quest-enter><span data-account-name>Family</span></h1>
      <p class="quest-screen__sub" data-quest-enter>Your players, their report cards, and your settings.</p>

      <div class="quest-players" data-players data-quest-enter>
        <PlayerCard />
      </div>
      <p class="quest-empty" data-empty hidden>No players yet. Add the first child to this family.</p>

      <section class="quest-card" data-quest-enter>
        <h2 class="quest-card__title">Settings</h2>
        <form data-settings-form>
          <div class="quest-form__ok" data-settings-ok hidden></div>
          <div class="quest-form__error" data-settings-error hidden></div>
          <div class="quest-field">
            <label class="quest-field__label" for="displayName">Your name</label>
            <input class="quest-field__input" id="displayName" name="displayName" maxlength="80" />
          </div>
          <div class="quest-field">
            <label class="quest-field__label" for="email">Email</label>
            <input class="quest-field__input" id="email" name="email" type="email" readonly />
            <span class="quest-field__hint">This comes from your login. It is not shown to players.</span>
          </div>
          <label class="quest-toggle">
            <input type="checkbox" name="leaderboardOptIn" />
            <span>Show our apelidos on the turma board. Avatars only. Never last names or emails.</span>
          </label>
          <div class="quest-btn-row"><button class="quest-btn quest-btn--lime" type="submit">Save settings</button></div>
        </form>
      </section>

      <section class="quest-card" data-quest-enter>
        <h2 class="quest-card__title">May play in class</h2>
        <p class="quest-card__body">When a coach puts a tablet in class mode, only these players appear.</p>
        <div data-class-toggles></div>
      </section>

      <div class="quest-btn-row" data-print-hide>
        <button class="quest-btn quest-btn--ghost" type="button" data-signout>Sign out</button>
        <button class="quest-btn quest-btn--danger" type="button" data-delete-start>Delete my account</button>
      </div>
      <section class="quest-card quest-card--danger" data-delete-confirm hidden>
        <h2 class="quest-card__title">Delete this family?</h2>
        <p class="quest-card__body">This erases every player, their lessons, and this login. It cannot be undone.</p>
        <div class="quest-form__error" data-delete-error hidden></div>
        <div class="quest-field">
          <label class="quest-field__label" for="delete-confirm">Type DELETE to confirm</label>
          <input class="quest-field__input" id="delete-confirm" data-delete-typed autocomplete="off" />
        </div>
        <div class="quest-btn-row">
          <button class="quest-btn quest-btn--danger" type="button" data-delete-go>Delete for good</button>
          <button class="quest-btn quest-btn--ghost" type="button" data-delete-cancel>Keep this account</button>
        </div>
      </section>
      <section class="quest-card" data-demo-coach hidden data-quest-enter>
        <h2 class="quest-card__title">Demo coach</h2>
        <p class="quest-card__body">Open the seeded turma of eight players. Switch back any time. This does not change a real Wix role.</p>
        <div class="quest-btn-row">
          <button class="quest-btn quest-btn--lime" type="button" data-to-coach>Switch to coach view</button>
          <button class="quest-btn" type="button" data-to-admin>Switch to admin view</button>
          <button class="quest-btn quest-btn--ghost" type="button" data-to-family hidden>Switch back to family</button>
        </div>
      </section>
    </main>
    <Footer />
  </div>
  <script>
    import '../../directions/quest/motion.js';
    import { requireSession } from '../../lib/auth-guard.js';
    import { signOut, updateAccount, updatePlayer, deleteAccount, snapshotsForSession } from '../../lib/actions.js';
    import { playerCardEl } from '../../lib/player-card.js';
    import { requireGrownUp } from '../../lib/grown-up-gate.js';
    import { IS_DEMO } from '../../lib/repo/index.js';

    async function init() {
      const s = await requireSession();
      if (!s) return;
      if (!(await requireGrownUp())) { location.replace('/who'); return; }
      const main = document.querySelector('main');
      if (main.dataset.wp4Bound) return;
      main.dataset.wp4Bound = '1';

      const account = s.session.account;
      document.querySelector('[data-account-name]').textContent = account.displayName || 'Family';
      const form = document.querySelector('[data-settings-form]');
      form.displayName.value = account.displayName || '';
      form.email.value = account.email || '';
      form.leaderboardOptIn.checked = account.leaderboardOptIn !== false;

      const grid = document.querySelector('[data-players]');
      const add = grid.querySelector('[data-add-player]');
      grid.querySelectorAll('.quest-family-card').forEach((n) => n.remove());
      const cards = await snapshotsForSession();
      document.querySelector('[data-empty]').hidden = cards.length > 0;
      for (const { player, snapshot } of cards) {
        const wrap = document.createElement('div');
        wrap.className = 'quest-family-card';
        const card = playerCardEl(player, {
          href: `/family/players/edit?player=${encodeURIComponent(player.id)}`,
          snapshot,
        });
        const report = document.createElement('a');
        report.className = 'quest-family-card__report';
        report.href = `/family/report?player=${encodeURIComponent(player.id)}`;
        report.textContent = 'Report card';
        wrap.append(card, report);
        grid.insertBefore(wrap, add);
      }

      const classBox = document.querySelector('[data-class-toggles]');
      classBox.innerHTML = '';
      for (const { player } of cards) {
        const label = document.createElement('label');
        label.className = 'quest-toggle';
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.checked = player.mayPlayInClass !== false;
        input.addEventListener('change', async () => {
          await updatePlayer(player.id, { mayPlayInClass: input.checked });
        });
        const span = document.createElement('span');
        span.textContent = `${player.firstName}${player.apelido ? ` (${player.apelido})` : ''} may play in class`;
        label.append(input, span);
        classBox.appendChild(label);
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const ok = form.querySelector('[data-settings-ok]');
        const err = form.querySelector('[data-settings-error]');
        ok.hidden = true; err.hidden = true;
        try {
          await updateAccount({
            displayName: String(form.displayName.value).trim(),
            leaderboardOptIn: form.leaderboardOptIn.checked,
          });
          document.querySelector('[data-account-name]').textContent = String(form.displayName.value).trim() || 'Family';
          ok.textContent = 'Saved.';
          ok.hidden = false;
        } catch (ex) {
          err.textContent = 'Could not save. Please try again.';
          err.hidden = false;
          console.error(ex);
        }
      });

      document.querySelector('[data-signout]').addEventListener('click', async () => { await signOut(); location.href = '/'; });
      const confirm = document.querySelector('[data-delete-confirm]');
      document.querySelector('[data-delete-start]').addEventListener('click', () => { confirm.hidden = false; confirm.scrollIntoView({ behavior: 'smooth' }); });
      document.querySelector('[data-delete-cancel]').addEventListener('click', () => { confirm.hidden = true; });
      document.querySelector('[data-delete-go]').addEventListener('click', async () => {
        const typed = document.querySelector('[data-delete-typed]').value.trim();
        const err = document.querySelector('[data-delete-error]');
        if (typed !== 'DELETE') { err.textContent = 'Type DELETE in capital letters to confirm.'; err.hidden = false; return; }
        const result = await deleteAccount();
        if (result.contactAce) {
          err.innerHTML = 'Contact ACE to delete your account. <a href="mailto:info@the-ace.org" style="color:var(--quest-cream)">info@the-ace.org</a>';
          err.hidden = false;
          return;
        }
        location.href = '/';
      });
      if (IS_DEMO) {
        const box = document.querySelector('[data-demo-coach]');
        box.hidden = false;
        const role = s.session.account.role;
        document.querySelector('[data-to-family]').hidden = role === 'guardian';
        document.querySelector('[data-to-coach]').hidden = role === 'coach';
        document.querySelector('[data-to-admin]').hidden = role === 'admin';
        const go = async (nextRole, programs) => {
          await updateAccount({ role: nextRole, programs });
          const { coachDemo } = await import('../../lib/repo/coachDemo.js');
          await coachDemo.ensure();
          location.href = nextRole === 'guardian' ? '/family' : nextRole === 'admin' ? '/admin/roles' : '/coach';
        };
        document.querySelector('[data-to-coach]').addEventListener('click', () => go('coach', ['bushwick', 'berkeley-carroll', 'prospect']));
        document.querySelector('[data-to-admin]').addEventListener('click', () => go('admin', ['bushwick', 'berkeley-carroll', 'prospect', 'brooklyn-open']));
        document.querySelector('[data-to-family]').addEventListener('click', () => go('guardian', []));
      }
    }
    document.addEventListener('astro:page-load', init);
    init();
  </script>
</Base>

--- src/pages/family/players/new.astro ---
---
// family/players/new.astro — create a player (SPEC §5.3). Kids never see
// this screen; a guardian fills it in. Program is set by invite code.
import { ClientRouter } from 'astro:transitions';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../directions/quest/Nav.astro';
import Footer from '../../../directions/quest/Footer.astro';
import AvatarPicker from '../../../components/quest/AvatarPicker.astro';
import '../../../directions/quest/tokens.css';
import '../../../directions/quest/theme.css';
---

<Base title="Add a player — Physical Chess" direction="quest">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <Nav active="family" />
    <main class="quest-screen quest-screen--narrow">
      <p class="quest-screen__eyebrow" data-quest-enter>Grown-ups</p>
      <h1 class="quest-screen__title" data-quest-enter>Add a player</h1>
      <p class="quest-screen__sub" data-quest-enter>Only a first name is needed. We never ask a child for an email or password.</p>
      <form class="quest-card" data-player-form data-quest-enter>
        <div class="quest-form__error" data-error hidden></div>
        <div class="quest-field"><label class="quest-field__label" for="firstName">First name</label><input class="quest-field__input" id="firstName" name="firstName" required maxlength="40" /></div>
        <div class="quest-field"><label class="quest-field__label" for="apelido">Apelido (capoeira nickname)</label><input class="quest-field__input" id="apelido" name="apelido" maxlength="40" /><span class="quest-field__hint">Optional. Their mestre may give one later.</span></div>
        <AvatarPicker />
        <div class="quest-field">
          <label class="quest-field__label" for="inviteCode">Class invite code</label>
          <input class="quest-field__input" id="inviteCode" name="inviteCode" maxlength="24" autocomplete="off" />
          <span class="quest-field__hint" data-program-hint>Ask your coach for the code on the class flyer. Leave blank if you train at home.</span>
        </div>
        <div class="quest-field"><label class="quest-field__label" for="birthYear">Birth year</label><input class="quest-field__input" id="birthYear" name="birthYear" type="number" min="2005" max="2022" /><span class="quest-field__hint">Optional. Helps coaches group classes.</span></div>
        <label class="quest-toggle">
          <input type="checkbox" name="mayPlayInClass" checked />
          <span>May play in class on a shared tablet</span>
        </label>
        <div class="quest-btn-row"><button class="quest-btn quest-btn--lime" type="submit">Add player</button><a class="quest-btn quest-btn--ghost" href="/family">Cancel</a></div>
      </form>
    </main>
    <Footer />
  </div>
  <script>
    import '../../../directions/quest/motion.js';
    import { requireSession } from '../../../lib/auth-guard.js';
    import { createPlayer, selectPlayer } from '../../../lib/actions.js';
    import { requireGrownUp } from '../../../lib/grown-up-gate.js';
    import { programByInvite } from '../../../content/programs.js';

    function bindInvite(form) {
      const input = form.querySelector('[name=inviteCode]');
      const hint = form.querySelector('[data-program-hint]');
      const paint = () => {
        const code = String(input.value || '').trim();
        if (!code) { hint.textContent = 'Ask your coach for the code on the class flyer. Leave blank if you train at home.'; return null; }
        const prog = programByInvite(code);
        if (prog) { hint.textContent = `This places them in ${prog.name}.`; return prog; }
        hint.textContent = 'That code does not match a class. Ask your coach.';
        return false;
      };
      input.addEventListener('input', paint);
      return paint;
    }

    async function init() {
      const s = await requireSession();
      if (!s) return;
      if (!(await requireGrownUp())) { location.replace('/who'); return; }
      const main = document.querySelector('main');
      if (main.dataset.wp4Bound) return;
      main.dataset.wp4Bound = '1';
      const form = document.querySelector('[data-player-form]');
      const resolve = bindInvite(form);
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const err = form.querySelector('[data-error]');
        err.hidden = true;
        const fd = new FormData(form);
        const invite = String(fd.get('inviteCode') || '').trim();
        const prog = resolve();
        if (invite && prog === false) { err.textContent = 'That invite code does not match a class.'; err.hidden = false; return; }
        try {
          const player = await createPlayer({
            firstName: String(fd.get('firstName')).trim(),
            apelido: String(fd.get('apelido') || '').trim(),
            avatar: { animal: fd.get('animal'), color: fd.get('color') },
            program: prog ? prog.key : null,
            birthYear: fd.get('birthYear') ? Number(fd.get('birthYear')) : null,
            mayPlayInClass: form.mayPlayInClass.checked,
          });
          await selectPlayer(player.id);
          location.href = '/journey';
        } catch (ex) {
          err.textContent = 'Could not add the player. Please try again.';
          err.hidden = false;
          console.error(ex);
        }
      });
    }
    document.addEventListener('astro:page-load', init);
    init();
  </script>
</Base>

--- src/pages/family/players/edit.astro ---
---
// family/players/edit.astro — edit / delete a player. Static route with
// ?player= because output is static (unknown ids cannot be prerendered).
import { ClientRouter } from 'astro:transitions';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../directions/quest/Nav.astro';
import Footer from '../../../directions/quest/Footer.astro';
import AvatarPicker from '../../../components/quest/AvatarPicker.astro';
import '../../../directions/quest/tokens.css';
import '../../../directions/quest/theme.css';
---

<Base title="Edit player — Physical Chess" direction="quest">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <Nav active="family" />
    <main class="quest-screen quest-screen--narrow">
      <p class="quest-screen__eyebrow" data-quest-enter>Grown-ups</p>
      <h1 class="quest-screen__title" data-quest-enter>Edit player</h1>
      <p class="quest-screen__sub" data-quest-enter>Change their name, apelido, avatar, or class. Players never see this page.</p>

      <p class="quest-card quest-card--note" data-missing hidden>We could not find that player. <a href="/family" style="color:var(--quest-mango)">Back to Family</a></p>

      <form class="quest-card" data-player-form hidden data-quest-enter>
        <div class="quest-form__ok" data-ok hidden></div>
        <div class="quest-form__error" data-error hidden></div>
        <div class="quest-field"><label class="quest-field__label" for="firstName">First name</label><input class="quest-field__input" id="firstName" name="firstName" required maxlength="40" /></div>
        <div class="quest-field"><label class="quest-field__label" for="apelido">Apelido (capoeira nickname)</label><input class="quest-field__input" id="apelido" name="apelido" maxlength="40" /></div>
        <AvatarPicker />
        <div class="quest-field">
          <label class="quest-field__label" for="inviteCode">Class invite code</label>
          <input class="quest-field__input" id="inviteCode" name="inviteCode" maxlength="24" autocomplete="off" />
          <span class="quest-field__hint" data-program-hint></span>
        </div>
        <div class="quest-field"><label class="quest-field__label" for="birthYear">Birth year</label><input class="quest-field__input" id="birthYear" name="birthYear" type="number" min="2005" max="2022" /></div>
        <label class="quest-toggle">
          <input type="checkbox" name="mayPlayInClass" />
          <span>May play in class on a shared tablet</span>
        </label>
        <div class="quest-btn-row">
          <button class="quest-btn quest-btn--lime" type="submit">Save</button>
          <a class="quest-btn quest-btn--ghost" href="/family">Back</a>
          <a class="quest-btn quest-btn--ghost" data-report-link href="/family">Report card</a>
        </div>
      </form>

      <section class="quest-card quest-card--danger" data-delete-box hidden>
        <h2 class="quest-card__title">Delete this player</h2>
        <p class="quest-card__body">This erases their lessons, stars, and patches. It cannot be undone.</p>
        <button class="quest-btn quest-btn--danger" type="button" data-delete-start>Delete this player</button>
        <div data-delete-confirm hidden>
          <div class="quest-form__error" data-delete-error hidden></div>
          <div class="quest-field" style="margin-top:16px">
            <label class="quest-field__label" for="delete-name">Type their first name to confirm</label>
            <input class="quest-field__input" id="delete-name" data-delete-typed autocomplete="off" />
          </div>
          <div class="quest-btn-row">
            <button class="quest-btn quest-btn--danger" type="button" data-delete-go>Delete for good</button>
            <button class="quest-btn quest-btn--ghost" type="button" data-delete-cancel>Keep this player</button>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
  <script>
    import '../../../directions/quest/motion.js';
    import { requireSession } from '../../../lib/auth-guard.js';
    import { updatePlayer, deletePlayer } from '../../../lib/actions.js';
    import { requireGrownUp } from '../../../lib/grown-up-gate.js';
    import { programByInvite, programByKey } from '../../../content/programs.js';
    import { avatarSvg } from '../../../lib/avatar.js';

    function bindInvite(form, currentKey) {
      const input = form.querySelector('[name=inviteCode]');
      const hint = form.querySelector('[data-program-hint]');
      const current = programByKey(currentKey);
      if (current && !input.value) input.value = current.inviteCode;
      const paint = () => {
        const code = String(input.value || '').trim();
        if (!code) { hint.textContent = 'Leave blank if they train at home.'; return null; }
        const prog = programByInvite(code);
        if (prog) { hint.textContent = `This places them in ${prog.name}.`; return prog; }
        hint.textContent = 'That code does not match a class. Ask your coach.';
        return false;
      };
      input.addEventListener('input', paint);
      paint();
      return paint;
    }

    async function init() {
      const s = await requireSession();
      if (!s) return;
      if (!(await requireGrownUp())) { location.replace('/who'); return; }
      const main = document.querySelector('main');
      if (main.dataset.wp4Bound) return;
      main.dataset.wp4Bound = '1';
      const id = new URLSearchParams(location.search).get('player');
      const player = s.session.players.find((p) => p.id === id);
      if (!player) {
        document.querySelector('[data-missing]').hidden = false;
        return;
      }
      const form = document.querySelector('[data-player-form]');
      const del = document.querySelector('[data-delete-box]');
      form.hidden = false;
      del.hidden = false;
      form.firstName.value = player.firstName || '';
      form.apelido.value = player.apelido || '';
      form.birthYear.value = player.birthYear || '';
      form.mayPlayInClass.checked = player.mayPlayInClass !== false;
      const animal = form.querySelector(`[name=animal][value="${player.avatar?.animal || 'frog'}"]`);
      const color = form.querySelector(`[name=color][value="${player.avatar?.color || 'mango'}"]`);
      if (animal) animal.checked = true;
      if (color) color.checked = true;
      form.querySelectorAll('[data-animal]').forEach((el) => {
        el.innerHTML = avatarSvg({ animal: el.dataset.animal, color: player.avatar?.color || 'mango' }, 56);
      });
      document.querySelector('[data-report-link]').href = `/family/report?player=${encodeURIComponent(player.id)}`;
      const resolve = bindInvite(form, player.program);

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const err = form.querySelector('[data-error]');
        const ok = form.querySelector('[data-ok]');
        err.hidden = true; ok.hidden = true;
        const fd = new FormData(form);
        const invite = String(fd.get('inviteCode') || '').trim();
        const prog = resolve();
        if (invite && prog === false) { err.textContent = 'That invite code does not match a class.'; err.hidden = false; return; }
        try {
          await updatePlayer(player.id, {
            firstName: String(fd.get('firstName')).trim(),
            apelido: String(fd.get('apelido') || '').trim(),
            avatar: { animal: fd.get('animal'), color: fd.get('color') },
            program: prog ? prog.key : null,
            birthYear: fd.get('birthYear') ? Number(fd.get('birthYear')) : null,
            mayPlayInClass: form.mayPlayInClass.checked,
          });
          ok.textContent = 'Saved.';
          ok.hidden = false;
        } catch (ex) {
          err.textContent = 'Could not save. Please try again.';
          err.hidden = false;
          console.error(ex);
        }
      });

      const confirm = del.querySelector('[data-delete-confirm]');
      del.querySelector('[data-delete-start]').addEventListener('click', () => { confirm.hidden = false; });
      del.querySelector('[data-delete-cancel]').addEventListener('click', () => { confirm.hidden = true; });
      del.querySelector('[data-delete-go]').addEventListener('click', async () => {
        const typed = del.querySelector('[data-delete-typed]').value.trim();
        const err = del.querySelector('[data-delete-error]');
        if (typed !== player.firstName) {
          err.textContent = `Type ${player.firstName} exactly to confirm.`;
          err.hidden = false;
          return;
        }
        await deletePlayer(player.id);
        location.href = '/family';
      });
    }
    document.addEventListener('astro:page-load', init);
    init();
  </script>
</Base>

--- src/pages/family/report.astro ---
---
// family/report.astro — guardian report card (SPEC §5.3). Query: ?player=
import { ClientRouter } from 'astro:transitions';
import Base from '../../layouts/Base.astro';
import Nav from '../../directions/quest/Nav.astro';
import Footer from '../../directions/quest/Footer.astro';
import '../../directions/quest/tokens.css';
import '../../directions/quest/theme.css';
---

<Base title="Report card — Physical Chess" direction="quest">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <Nav active="family" />
    <main class="quest-screen quest-report">
      <p class="quest-screen__eyebrow" data-quest-enter>Grown-ups</p>
      <h1 class="quest-screen__title" data-quest-enter>Report card</h1>
      <p class="quest-screen__sub" data-quest-enter>Progress, practice, and a download of everything we hold about this player.</p>
      <p class="quest-card quest-card--note" data-missing hidden>We could not find that player. <a href="/family" style="color:var(--quest-mango)">Back to Family</a></p>
      <div data-report hidden></div>
    </main>
    <Footer />
  </div>
  <script>
    import '../../directions/quest/motion.js';
    import { requireSession } from '../../lib/auth-guard.js';
    import { selectPlayer, confirmPractice } from '../../lib/actions.js';
    import { requireGrownUp } from '../../lib/grown-up-gate.js';
    import { store } from '../../lib/store.js';
    import { avatarSvg } from '../../lib/avatar.js';
    import { lessonById } from '../../content/lessons.js';
    import { programByKey } from '../../content/programs.js';
    import { CORDAS } from '../../data/batizado.js';
    import { EVENT } from '../../lib/game/events.js';
    import { downloadCsv, downloadJson, playerExportPayload } from '../../lib/export.js';

    const TZ = { timeZone: 'America/New_York', dateStyle: 'medium', timeStyle: 'short' };
    const fmt = (iso) => { try { return new Intl.DateTimeFormat('en-US', TZ).format(new Date(iso)); } catch { return iso || ''; } };
    const cordaLabel = (id) => CORDAS.find((c) => c.id === id)?.label || 'Crua';
    const lessonTitle = (id) => lessonById(id)?.title || id || '—';

    const LABELS = {
      [EVENT.VIDEO_DONE]: 'Watched a lesson',
      [EVENT.READING_DONE]: 'Finished a reading',
      [EVENT.DRILL_DONE]: 'Logged a practice',
      [EVENT.PRACTICE_CONFIRMED]: 'You saw this practice',
      [EVENT.QUIZ_ANSWERED]: 'Answered a quiz question',
      [EVENT.QUIZ_DONE]: 'Finished a quiz',
      [EVENT.MODULE_CLEARED]: 'Cleared a module',
      [EVENT.DESAFIO_DONE]: 'Finished Desafio do Dia',
      [EVENT.STREAK_WEEK]: 'Saved a roda week',
      [EVENT.PATCH_EARNED]: 'Earned a patch',
      [EVENT.COACH_XP]: 'Coach bonus',
      [EVENT.CORDA_AWARDED]: 'Corda awarded',
      [EVENT.ATTENDANCE]: 'Class stamp',
      [EVENT.GLOSSARY_MASTERED]: 'Learned a Portuguese word',
      [EVENT.PLAYER_CREATED]: 'Player added',
      [EVENT.PLAYER_DELETED]: 'Player deleted',
    };

    function starRow(n) {
      const on = Number(n) || 0;
      return `<span class="quest-stars" aria-label="${on} of 3 stars">${[1, 2, 3].map((i) =>
        `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.4 6.6H21l-5.4 4.2 2 6.7L12 16.8 6.4 20.5l2-6.7L3 9.6h6.6z" fill="${i <= on ? '#FFB238' : 'none'}" stroke="#FFB238" stroke-width="1.6"/></svg>`
      ).join('')}</span>`;
    }

    function render(root, { player, snapshot, events, account }) {
      const program = programByKey(player.program);
      const drills = events.filter((e) => e.type === EVENT.DRILL_DONE);
      const seen = new Set(events.filter((e) => e.type === EVENT.PRACTICE_CONFIRMED).map((e) => e.lessonId));
      const byLesson = new Map();
      for (const d of drills) byLesson.set(d.lessonId, d);
      const cordaHist = events.filter((e) => e.type === EVENT.CORDA_AWARDED);
      const lessonsDone = Object.values(snapshot.lessons).filter((l) => l.status === 'done');
      const timeline = [...events].sort((a, b) => new Date(b.occurredAt) - new Date(a.occurredAt)).slice(0, 50);
      const fileBase = `physical-chess-${(player.apelido || player.firstName || 'player').toLowerCase().replace(/\s+/g, '-')}`;

      root.innerHTML = `
        <section class="quest-card quest-report__hero">
          <span class="quest-report__avatar">${avatarSvg(player.avatar, 88)}</span>
          <div>
            <h2 class="quest-card__title">${escapeHtml(player.apelido || player.firstName)}</h2>
            <p class="quest-card__body">${escapeHtml(player.firstName)}${program ? ` · ${escapeHtml(program.name)}` : ''}</p>
          </div>
        </section>
        <section class="quest-report__stats">
          <div class="quest-stat"><span class="quest-stat__label">Level</span><span class="quest-stat__value">${snapshot.level.level}</span><span class="quest-stat__hint">${escapeHtml(snapshot.level.title)}</span></div>
          <div class="quest-stat"><span class="quest-stat__label">XP</span><span class="quest-stat__value">${snapshot.xp}</span><span class="quest-stat__hint">${snapshot.level.xpToNext ? snapshot.level.xpToNext + ' to next' : 'max'}</span></div>
          <div class="quest-stat"><span class="quest-stat__label">Stars</span><span class="quest-stat__value">${snapshot.stars}</span><span class="quest-stat__hint">${snapshot.lessonsDone} lessons</span></div>
          <div class="quest-stat"><span class="quest-stat__label">Roda weeks</span><span class="quest-stat__value">${snapshot.streak.weeks}</span><span class="quest-stat__hint">${snapshot.streak.activeThisWeek ? 'active this week' : 'resting'}</span></div>
          <div class="quest-stat"><span class="quest-stat__label">Corda</span><span class="quest-stat__value">${escapeHtml(cordaLabel(snapshot.cordaCurrent))}</span><span class="quest-stat__hint">Coach awarded</span></div>
        </section>
        <section class="quest-card">
          <h2 class="quest-card__title">Batizado readiness</h2>
          <p class="quest-card__body">${snapshot.readiness.percent}% · ${snapshot.readiness.metCount} of ${snapshot.readiness.total}</p>
          <ul class="quest-checklist">
            ${snapshot.readiness.items.map((item) => `<li class="${item.met ? 'is-met' : ''}"><span class="quest-checklist__mark" aria-hidden="true"></span>${escapeHtml(item.label)}</li>`).join('')}
          </ul>
        </section>
        <section class="quest-card">
          <h2 class="quest-card__title">Lessons done</h2>
          ${lessonsDone.length ? `<table class="quest-table"><thead><tr><th>Lesson</th><th>Stars</th></tr></thead><tbody>${lessonsDone.map((l) => `<tr><td>${escapeHtml(lessonTitle(l.lessonId))}</td><td>${starRow(l.bestStars)}</td></tr>`).join('')}</tbody></table>` : '<p class="quest-card__body">No lessons finished yet.</p>'}
        </section>
        <section class="quest-card">
          <h2 class="quest-card__title">Patches</h2>
          ${snapshot.patches.length ? `<ul class="quest-patch-list">${snapshot.patches.map((p) => `<li><strong>${escapeHtml(p.title)}</strong> · ${escapeHtml(p.subtitle || '')}</li>`).join('')}</ul>` : '<p class="quest-card__body">No patches yet.</p>'}
        </section>
        <section class="quest-card">
          <h2 class="quest-card__title">Corda history</h2>
          ${cordaHist.length ? `<ol class="quest-timeline">${cordaHist.map((e) => `<li><span>${fmt(e.occurredAt)}</span> ${escapeHtml(cordaLabel(e.payload?.corda))}${e.payload?.event ? ` · ${escapeHtml(e.payload.event)}` : ''}</li>`).join('')}</ol>` : `<p class="quest-card__body">Starting corda: ${escapeHtml(cordaLabel(snapshot.cordaCurrent))}. A coach awards the next one at Batizado.</p>`}
        </section>
        <section class="quest-card">
          <h2 class="quest-card__title">Practice log</h2>
          <p class="quest-card__body">Tap I saw it when you watched them train at home.</p>
          <div data-practice>
            ${[...byLesson.values()].length ? `<ul class="quest-practice">${[...byLesson.values()].map((d) => {
              const confirmed = seen.has(d.lessonId);
              return `<li data-drill="${escapeHtml(d.lessonId)}" data-module="${escapeHtml(d.moduleId || '')}">
                <div><strong>${escapeHtml(lessonTitle(d.lessonId))}</strong><span>${fmt(d.occurredAt)}</span></div>
                ${confirmed ? '<span class="quest-chip">You saw it</span>' : `<button class="quest-btn quest-btn--lime" type="button" data-saw>I saw it</button>`}
              </li>`;
            }).join('')}</ul>` : '<p class="quest-card__body">No drills logged yet.</p>'}
          </div>
        </section>
        <section class="quest-card">
          <h2 class="quest-card__title">Activity</h2>
          <ol class="quest-timeline">
            ${timeline.map((e) => `<li><span>${fmt(e.occurredAt)}</span> ${escapeHtml(LABELS[e.type] || e.type)}${e.lessonId ? ` · ${escapeHtml(lessonTitle(e.lessonId))}` : ''}${e.xp ? ` · +${e.xp} XP` : ''}</li>`).join('') || '<li>Nothing recorded yet.</li>'}
          </ol>
        </section>
        <div class="quest-btn-row" data-print-hide>
          <button class="quest-btn" type="button" data-print>Print</button>
          <button class="quest-btn quest-btn--lime" type="button" data-csv>Download CSV</button>
          <button class="quest-btn quest-btn--ghost" type="button" data-json>Download JSON</button>
          <a class="quest-btn quest-btn--ghost" href="/family/players/edit?player=${encodeURIComponent(player.id)}">Edit player</a>
        </div>
      `;

      root.querySelector('[data-print]')?.addEventListener('click', () => window.print());
      root.querySelector('[data-csv]')?.addEventListener('click', () => downloadCsv(`${fileBase}.csv`, events));
      root.querySelector('[data-json]')?.addEventListener('click', () => downloadJson(`${fileBase}.json`, playerExportPayload({ player, snapshot, events, account })));
      root.querySelectorAll('[data-saw]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          const li = btn.closest('[data-drill]');
          await confirmPractice(player.id, { lessonId: li.dataset.drill, moduleId: li.dataset.module || null });
          const s = store.get();
          render(root, { player: s.player, snapshot: s.snapshot, events: s.events, account: s.session.account });
        });
      });
    }

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    async function init() {
      const s = await requireSession();
      if (!s) return;
      if (!(await requireGrownUp())) { location.replace('/who'); return; }
      const main = document.querySelector('main');
      if (main.dataset.wp4Bound) return;
      main.dataset.wp4Bound = '1';
      const id = new URLSearchParams(location.search).get('player');
      const row = s.session.players.find((p) => p.id === id);
      if (!row) { document.querySelector('[data-missing]').hidden = false; return; }
      await selectPlayer(id);
      const state = store.get();
      const root = document.querySelector('[data-report]');
      root.hidden = false;
      render(root, { player: state.player, snapshot: state.snapshot, events: state.events, account: state.session.account });
    }
    document.addEventListener('astro:page-load', init);
    init();
  </script>
</Base>

