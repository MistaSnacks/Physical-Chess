@@ -4402,3 +4402,267 @@
 .quest-footer__note {
   color: var(--quest-cream);
 }
+
+/* === POLISH: me-family === */
+.quest-who,
+.quest-family,
+.quest-player-form-screen,
+.quest-me,
+.quest-report {
+  position: relative;
+  z-index: 1;
+}
+.quest-nav__brand,
+.quest-nav__link,
+.quest-nav__more-btn,
+.quest-nav__cta,
+.quest-nav__chip { min-height: 44px; }
+.quest-who__players,
+.quest-family__players {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  align-items: stretch;
+}
+.quest-who__players { max-width: 800px; }
