/* ---------------------------------------------------------------------
   base.css — shared reset + utilities.
   Zero visual opinion beyond a neutral reset. Each direction's
   theme.css owns all actual look-and-feel.
   --------------------------------------------------------------------- */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
}

html {
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

body {
  min-height: 100vh;
  font-family: 'Nunito', system-ui, sans-serif;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

img,
picture,
video,
canvas,
svg {
  display: block;
  max-width: 100%;
}

input,
button,
textarea,
select {
  font: inherit;
  color: inherit;
}

button {
  cursor: pointer;
  background: none;
  border: 0;
  padding: 0;
}

a {
  color: inherit;
  text-decoration: none;
}

ul,
ol {
  margin: 0;
  padding: 0;
  list-style: none;
}

h1,
h2,
h3,
h4,
p,
figure {
  margin: 0;
}

/* Screen-reader only utility */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.skip-link {
  position: absolute;
  left: 12px;
  top: -80px;
  z-index: 1000;
  padding: 10px 16px;
  background: #B9F26B;
  color: #0B2E24;
  font: 800 14px/1 Nunito, system-ui, sans-serif;
  border-radius: 999px;
}
.skip-link:focus,
.skip-link:focus-visible {
  top: 12px;
  outline: 3px solid #FFB238;
  outline-offset: 3px;
}

/* Shared page-width wrapper: 1440 max, 48px side padding, 20px on mobile */
.wrap {
  width: 100%;
  max-width: 1440px;
  margin-inline: auto;
  padding-inline: 48px;
}

@media (max-width: 640px) {
  .wrap {
    padding-inline: 20px;
  }
}

/* Reduced-motion guard: every direction's motion.js / theme.css must
   respect this. This global rule collapses transforms + transitions
   to instant final states unless a script explicitly opts an element
   out via [data-motion-exempt]. */
@media (prefers-reduced-motion: reduce) {
  *:not([data-motion-exempt]),
  *:not([data-motion-exempt])::before,
  *:not([data-motion-exempt])::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}
---
// Base.astro — shared <html> shell for every route.
// Accepts a `direction` prop ('quest' | undefined
// for the neutral chooser) and stamps it as a class on <body> so each
// direction's theme.css can scope its selectors, e.g. body.direction-sticker.
import '../styles/base.css';
import { wix } from '../data/media.js';

interface Props {
  title: string;
  description?: string;
  direction?: 'quest';
}

const {
  title,
  description = 'Physical Chess — a kids capoeira learning app by ACE / Abadá Capoeira Brooklyn.',
  direction,
} = Astro.props;

