// privacy.astro — plain-language child-data notice (SPEC §3.3). Copy still
// needs ACE / Camren sign-off (SPEC §10 q16).
import { ClientRouter } from 'astro:transitions';
import Base from '../layouts/Base.astro';
import Nav from '../directions/quest/Nav.astro';
import Footer from '../directions/quest/Footer.astro';
import { CONTACT } from '../data/batizado.js';
import '../directions/quest/tokens.css';
import '../directions/quest/theme.css';
---

<Base title="Privacy — Physical Chess" direction="quest" description="What Physical Chess stores about a child, and how a parent can delete it.">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <Nav active="home" />
    <main class="quest-screen quest-screen--narrow quest-privacy">
      <p class="quest-screen__eyebrow" data-quest-enter>Grown-ups</p>
      <h1 class="quest-screen__title" data-quest-enter>Privacy</h1>
      <p class="quest-screen__sub" data-quest-enter>This page is for parents and guardians. It says what we store about a child and how to erase it.</p>

      <section class="quest-card" data-quest-enter>
        <h2 class="quest-card__title">What we store about a child</h2>
        <p class="quest-card__body">A player is a child inside a grown-up’s account. Kids never enter an email or a password.</p>
        <ul class="quest-privacy__list">
          <li>First name</li>
          <li><strong>Apelido</strong> (capoeira nickname), if they have one</li>
          <li>Avatar: an animal sticker and a color</li>
          <li>Birth year, only if you choose to share it</li>
          <li>Which class they train with</li>
          <li>Activity: lessons, practice, quizzes, patches, and attendance a coach stamps</li>
        </ul>
      </section>

      <section class="quest-card" data-quest-enter>
        <h2 class="quest-card__title">What we do not store</h2>
        <ul class="quest-privacy__list">
          <li>A child’s email or password. They do not have one.</li>
          <li>A child’s last name.</li>
          <li>Another family’s email or last name on any screen a player can see.</li>
        </ul>
      </section>

      <section class="quest-card" data-quest-enter>
        <h2 class="quest-card__title">How to delete it</h2>
        <p class="quest-card__body">You can delete one player from Family → that player → Delete this player. That erases their lessons, stars, patches, and activity.</p>
        <p class="quest-card__body">You can delete the whole family from Family → Delete my account. That removes every player and the grown-up login.</p>
        <p class="quest-card__body">You can also email ACE and ask. We will delete the records by hand.</p>
      </section>

      <section class="quest-card" data-quest-enter>
        <h2 class="quest-card__title">Who to contact</h2>
        <p class="quest-card__body">ACE / Abadá Capoeira Brooklyn.</p>
        <p class="quest-card__body"><a href={`tel:${CONTACT.phone.replace(/[^0-9+]/g, '')}`} style="color:var(--quest-mango)">{CONTACT.phone}</a></p>
        <p class="quest-card__body"><a href={`mailto:${CONTACT.email}`} style="color:var(--quest-mango)">{CONTACT.email}</a></p>
      </section>
    </main>
    <Footer />
  </div>
  <script>
    import '../directions/quest/motion.js';
  </script>
</Base>
---
// Nav.astro — Roda Quest header. Highlights the active screen via
// aria-current so theme.css can style it. The right-hand slot is a player
// chip once a session exists (filled by src/lib/nav.js), else "Log in".
// WP5 adds a "More" menu for public pages; the four main links and session
// chip stay as they are.

interface Props {
  active?: 'home' | 'journey' | 'movements' | 'music' | 'culture' | 'graduation' | 'batizado' | 'me' | 'family' | 'coach' | 'who' | 'about' | 'shop';
}

const { active } = Astro.props;

const LINKS = [
  { id: 'journey', href: '/journey', label: 'My Journey' },
  { id: 'movements', href: '/learn/movements', label: 'Movements' },
  { id: 'music', href: '/learn/music', label: 'Music' },
  { id: 'batizado', href: '/batizado', label: 'Batizado' },
];

const MORE = [
  { id: 'about', href: '/about', label: 'About' },
  { id: 'graduation', href: '/graduation', label: 'Graduation' },
  { id: 'shop', href: '/shop', label: 'Shop' },
  { id: 'privacy', href: '/privacy', label: 'Privacy' },
];

const moreCurrent = active === 'about' || active === 'shop' || active === 'graduation';
---

<header class="quest-nav" data-quest-enter>
  <a class="quest-nav__brand" href="/">
    <span class="quest-nav__mark">
      <svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <circle cx="13" cy="4" r="2" fill="none" stroke="#FFF6E5" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M4 20l4-5 3 1 2-5 4 2 3-4" fill="none" stroke="#FFF6E5" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M8 15l-1 6" fill="none" stroke="#FFF6E5" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    <span class="quest-nav__wordmark">PHYSICAL CHESS</span>
  </a>

  <nav class="quest-nav__links" aria-label="Roda Quest screens">
    {
      LINKS.map((link) => (
        <a class="quest-nav__link" href={link.href} aria-current={active === link.id ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="quest-nav__more" data-nav-more>
    <button
      type="button"
      class="quest-nav__more-btn"
      data-more-btn
      aria-expanded="false"
      aria-controls="quest-more-panel"
      aria-haspopup="true"
      data-current={moreCurrent ? 'true' : undefined}
    >
      More
      <svg class="quest-nav__more-caret" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
        <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <div class="quest-more-backdrop" data-more-backdrop hidden></div>
    <div id="quest-more-panel" class="quest-more-panel" data-more-panel hidden role="menu" aria-label="More pages">
      <p class="quest-more-panel__title">Visit</p>
      {
        MORE.map((link) => (
          <a
            class="quest-more-panel__link"
            href={link.href}
            role="menuitem"
            aria-current={active === link.id ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <button type="button" class="quest-more-panel__close" data-more-close>Close</button>
    </div>
  </div>

  <div class="quest-nav__session" data-nav-session>
    <a class="quest-nav__cta" href="/login" data-nav-login>Log in</a>
    <a class="quest-nav__chip" href="/who" data-nav-chip hidden>
      <span class="quest-nav__chip-avatar" data-nav-avatar></span>
      <span class="quest-nav__chip-name" data-nav-name></span>
    </a>
    <a class="quest-nav__coach" href="/coach" data-nav-coach hidden>Coach</a>
  </div>
</header>

<script>
  import '../../lib/nav.js';

  function moreParts(root) {
    return {
      btn: root.querySelector('[data-more-btn]'),
      panel: document.getElementById('quest-more-panel'),
      backdrop: document.querySelector('[data-more-backdrop]'),
      closeBtn: document.querySelector('[data-more-close]'),
    };
  }

  function isMobileMore() {
    return window.matchMedia('(max-width: 600px)').matches;
  }

  function closeMore(root) {
    const { btn, panel, backdrop } = moreParts(root);
    btn.setAttribute('aria-expanded', 'false');
    panel.hidden = true;
    backdrop.hidden = true;
    document.body.classList.remove('quest-more-open');
    root.append(backdrop, panel);
  }

  function openMore(root) {
    const { btn, panel, backdrop } = moreParts(root);
    btn.setAttribute('aria-expanded', 'true');
    if (isMobileMore()) document.body.append(backdrop, panel);
    panel.hidden = false;
    backdrop.hidden = false;
    document.body.classList.add('quest-more-open');
    panel.querySelector('a')?.focus();
  }

  function bindMore() {
    document.body.classList.remove('quest-more-open');
    document.querySelectorAll('body > [data-more-panel], body > [data-more-backdrop]').forEach((el) => el.remove());
    document.querySelectorAll('[data-nav-more]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';
      const btn = root.querySelector('[data-more-btn]');
      const panel = root.querySelector('[data-more-panel]');
      const backdrop = root.querySelector('[data-more-backdrop]');
      const closeBtn = root.querySelector('[data-more-close]');

      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        if (open) closeMore(root);
        else openMore(root);
      });
      backdrop.addEventListener('click', () => closeMore(root));
      closeBtn.addEventListener('click', () => {
        closeMore(root);
        btn.focus();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
          closeMore(root);
          btn.focus();
        }
      });
      panel.addEventListener('keydown', (e) => {
        const items = Array.from(panel.querySelectorAll('[role="menuitem"], [data-more-close]'));
        const i = items.indexOf(document.activeElement);
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          items[(i + 1) % items.length]?.focus();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          items[(i - 1 + items.length) % items.length]?.focus();
        } else if (e.key === 'Home') {
          e.preventDefault();
          items[0]?.focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          items[items.length - 1]?.focus();
        } else if (e.key === 'Tab' && btn.getAttribute('aria-expanded') === 'true' && window.matchMedia('(max-width: 600px)').matches) {
          e.preventDefault();
          if (e.shiftKey) items[(i - 1 + items.length) % items.length]?.focus();
          else items[(i + 1) % items.length]?.focus();
        }
      });
    });
