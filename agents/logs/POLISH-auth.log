/* ---------------------------------------------------------------------
   tokens.css — Roda Quest design tokens.
   Values copied from Paper artboards ED-0 (map) / EE-0 (quiz) JSX.
   --------------------------------------------------------------------- */

:root {
  /* Colors */
  --quest-palm-shadow: #0b2e24; /* ground / page bg */
  --quest-deep-leaf: #154334; /* surface */
  --quest-leaf-border: #1e5a46; /* surface border */
  --quest-hibiscus: #ff4f7a;
  --quest-hibiscus-shadow: #8a1f3d;
  --quest-mango: #ffb238;
  --quest-mango-shadow: #7a4a00;
  --quest-lime: #b9f26b;
  --quest-lime-shadow: #4e7a22;
  --quest-cream: #fff6e5;
  --quest-muted: #9fc4b3;
  --quest-muted-2: #7fa894;
  --quest-ink: #0b2e24;

  /* Corda progression (from batizado.js CORDAS, for reference) */
  --quest-corda-crua: #e8dcc3;

  /* Type */
  --quest-font-display: 'Lilita One', system-ui, sans-serif;
  --quest-font-label: 'Nunito', system-ui, sans-serif;
  --quest-font-body: 'Nunito', system-ui, sans-serif;

  --quest-text-display-lg: 56px;
  --quest-text-display-md: 40px;
  --quest-text-display-sm: 26px;
  --quest-text-label: 14px;
  --quest-text-body: 17px;

  /* Radii */
  --quest-radius-pill: 999px;
  --quest-radius-lg: 36px;
  --quest-radius-md: 20px;
  --quest-radius-sm: 12px;

  /* Borders */
  --quest-border-thin: 3px;
  --quest-border-thick: 6px;

  /* Motion timing */
  --quest-ease: cubic-bezier(0.22, 1, 0.36, 1);
  --quest-entrance-duration: 1.2s;
}
/* ---------------------------------------------------------------------
   theme.css — Roda Quest. All visual styling for the /quest route lives
   here. tokens.css supplies the palette/type/radii variables.
   --------------------------------------------------------------------- */

body.direction-quest {
  background: var(--quest-palm-shadow);
  color: var(--quest-cream);
  font-family: var(--quest-font-body);
  overflow-x: hidden;
}

body.direction-quest h1,
body.direction-quest h2,
body.direction-quest h3 {
  font-family: var(--quest-font-display);
  font-weight: 400;
  margin: 0;
}

body.direction-quest .wrap {
  max-width: 1360px;
}

body.direction-quest img {
  display: block;
}

/* ---------------------------------------------------------------------
   View transitions — "fade through palm shadow"
   --------------------------------------------------------------------- */
html:has(body.direction-quest) {
  background: var(--quest-palm-shadow);
}

::view-transition-old(root) {
  animation: quest-vt-out 0.32s ease-in both;
}
::view-transition-new(root) {
  animation: quest-vt-in 0.38s ease-out 0.28s both;
}
@keyframes quest-vt-out {
  to {
    opacity: 0;
    transform: scale(0.99);
  }
}
@keyframes quest-vt-in {
  from {
    opacity: 0;
    transform: scale(1.01);
  }
}

/* ---------------------------------------------------------------------
   Layout scaffolding
   --------------------------------------------------------------------- */
.quest-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: clip;
}

.quest-stars {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.quest-stagelight {
  position: absolute;
  border-radius: 999px;
  opacity: 0.9;
  pointer-events: none;
  z-index: 0;
}
.quest-stagelight--a {
  width: 900px;
  height: 900px;
  background: var(--quest-deep-leaf);
  top: -420px;
  right: -300px;
}
.quest-stagelight--b {
  width: 620px;
  height: 620px;
  background: #123a2e;
  bottom: -280px;
  left: -220px;
}

/* ---------------------------------------------------------------------
   Nav
   --------------------------------------------------------------------- */
.quest-nav {
  position: relative;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 22px 48px;
  flex-wrap: wrap;
}

.quest-nav__brand {
  display: flex;
