  font-size: 16px;
  font-weight: 800;
}

/* Mascot */
.quest-mascot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18px;
  position: sticky;
  top: 100px;
}
.quest-mascot__bubble-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.quest-mascot__bubble {
  padding: 16px 20px;
  border-radius: 22px;
  background: var(--quest-cream);
  color: var(--quest-ink);
  font-weight: 800;
  font-size: 16px;
  text-align: center;
  line-height: 1.4;
}
.quest-mascot__tail {
  margin-top: -2px;
}
.quest-mascot__figure {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 160px;
  height: 160px;
  border-radius: 999px;
  background: var(--quest-mango);
  border: 6px solid var(--quest-ink);
  box-shadow: 0 10px 0 var(--quest-mango-shadow);
}
.quest-mascot__figure.is-breathing {
  animation: quest-breathe 3.6s ease-in-out infinite;
  transform-origin: 50% 100%;
}
@keyframes quest-breathe {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.035);
  }
}
.quest-pulse {
  animation: quest-mascot-pulse 0.5s var(--quest-ease);
}
@keyframes quest-mascot-pulse {
  0% {
    transform: scale(1);
  }
  40% {
    transform: scale(1.18);
  }
  100% {
    transform: scale(1);
  }
}

.quest-mascot__name {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--quest-muted);
}

