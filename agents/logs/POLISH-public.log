}

/* ---------------------------------------------------------------------
   Instruments / Portuguese words (Music page)
   --------------------------------------------------------------------- */
.quest-instruments {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.quest-instrument-card {
  display: flex;
