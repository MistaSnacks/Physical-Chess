.quest-corda__you {
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.08em;
  color: var(--quest-mango);
}

.quest-gallery.gallery {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.quest-gallery .gallery__item {
  border-radius: 18px;
  overflow: hidden;
  border: 3px solid var(--quest-leaf-border);
  position: relative;
}
.quest-gallery .gallery__figure {
  position: relative;
  aspect-ratio: 1 / 1;
}
.quest-gallery .gallery__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s var(--quest-ease);
}
.quest-gallery .gallery__item:hover .gallery__img {
  transform: scale(1.06);
}
.quest-gallery .gallery__caption {
  position: absolute;
  inset: auto 0 0 0;
  padding: 8px 10px;
  font-size: 11px;
  font-weight: 700;
  color: var(--quest-cream);
  background: linear-gradient(180deg, transparent, rgba(11, 46, 36, 0.9));
}

.quest-videos {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.quest-video-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.quest-video-card .yt-embed {
  border-radius: 20px;
  overflow: hidden;
  border: 4px solid var(--quest-ink);
}
.quest-video-card__title {
  font-weight: 900;
  font-size: 15px;
  color: var(--quest-cream);
}
.quest-video-card__credit {
  font-size: 12px;
  font-weight: 700;
  color: var(--quest-muted-2);
}

/* ---------------------------------------------------------------------
   Instruments / Portuguese words (Music page)
   --------------------------------------------------------------------- */
.quest-instruments {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
/* ---------------------------------------------------------------------
   base.css — shared reset + utilities.
   Zero visual opinion beyond a neutral reset. Each direction's
   theme.css owns all actual look-and-feel.
   --------------------------------------------------------------------- */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
}

html {
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

body {
  min-height: 100vh;
  font-family: 'Nunito', system-ui, sans-serif;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

img,
picture,
video,
canvas,
svg {
  display: block;
  max-width: 100%;
}

input,
button,
textarea,
select {
  font: inherit;
  color: inherit;
}

button {
  cursor: pointer;
  background: none;
  border: 0;
  padding: 0;
}

a {
  color: inherit;
  text-decoration: none;
}

ul,
ol {
  margin: 0;
  padding: 0;
  list-style: none;
}

h1,
h2,
h3,
h4,
p,
figure {
  margin: 0;
}

/* Screen-reader only utility */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.skip-link {
  position: absolute;
  left: 12px;
  top: -80px;
  z-index: 1000;
  padding: 10px 16px;
  background: #B9F26B;
  color: #0B2E24;
  font: 800 14px/1 Nunito, system-ui, sans-serif;
  border-radius: 999px;
}
.skip-link:focus,
.skip-link:focus-visible {
  top: 12px;
  outline: 3px solid #FFB238;
  outline-offset: 3px;
}

/* Shared page-width wrapper: 1440 max, 48px side padding, 20px on mobile */
.wrap {
  width: 100%;
  max-width: 1440px;
  margin-inline: auto;
  padding-inline: 48px;
}

@media (max-width: 640px) {
  .wrap {
    padding-inline: 20px;
  }
}

/* Reduced-motion guard: every direction's motion.js / theme.css must
   respect this. This global rule collapses transforms + transitions
   to instant final states unless a script explicitly opts an element
   out via [data-motion-exempt]. */
@media (prefers-reduced-motion: reduce) {
  *:not([data-motion-exempt]),
  *:not([data-motion-exempt])::before,
  *:not([data-motion-exempt])::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}
