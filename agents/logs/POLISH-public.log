/* ---------------------------------------------------------------------
   theme.css — Roda Quest. All visual styling for the /quest route lives
   here. tokens.css supplies the palette/type/radii variables.
   --------------------------------------------------------------------- */

body.direction-quest {
  background: var(--quest-palm-shadow);
  color: var(--quest-cream);
  font-family: var(--quest-font-body);
  overflow-x: hidden;
}

body.direction-quest h1,
body.direction-quest h2,
body.direction-quest h3 {
  font-family: var(--quest-font-display);
  font-weight: 400;
  margin: 0;
}

body.direction-quest .wrap {
  max-width: 1360px;
}

body.direction-quest img {
  display: block;
}

/* ---------------------------------------------------------------------
   View transitions — "fade through palm shadow"
   --------------------------------------------------------------------- */
html:has(body.direction-quest) {
  background: var(--quest-palm-shadow);
}

::view-transition-old(root) {
  animation: quest-vt-out 0.32s ease-in both;
}
::view-transition-new(root) {
  animation: quest-vt-in 0.38s ease-out 0.28s both;
}
@keyframes quest-vt-out {
  to {
    opacity: 0;
    transform: scale(0.99);
  }
}
@keyframes quest-vt-in {
  from {
    opacity: 0;
    transform: scale(1.01);
  }
}

/* ---------------------------------------------------------------------
   Layout scaffolding
   --------------------------------------------------------------------- */
.quest-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: clip;
}

.quest-stars {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.quest-stagelight {
  position: absolute;
  border-radius: 999px;
  opacity: 0.9;
  pointer-events: none;
  z-index: 0;
}
.quest-stagelight--a {
  width: 900px;
  height: 900px;
  background: var(--quest-deep-leaf);
  top: -420px;
  right: -300px;
}
.quest-stagelight--b {
  width: 620px;
  height: 620px;
  background: #123a2e;
  bottom: -280px;
  left: -220px;
}

/* ---------------------------------------------------------------------
   Nav
   --------------------------------------------------------------------- */
.quest-nav {
  position: relative;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 22px 48px;
  flex-wrap: wrap;
}

.quest-nav__brand {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-shrink: 0;
}

.quest-nav__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  background: var(--quest-hibiscus);
  border-radius: 14px;
  rotate: -8deg;
}
.quest-nav__mark svg {
  flex-shrink: 0;
}

.quest-nav__wordmark {
  font-family: var(--quest-font-display);
  font-size: 21px;
  letter-spacing: 0.02em;
  color: var(--quest-cream);
  white-space: nowrap;
}

.quest-nav__links {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.quest-nav__link {
  display: inline-flex;
  align-items: center;
  padding: 10px 16px;
  border-radius: 999px;
  font-weight: 800;
  font-size: 14px;
  letter-spacing: 0.04em;
  color: var(--quest-muted);
  transition: transform 0.18s var(--quest-ease);
}
.quest-nav__link:hover {
  background: var(--quest-deep-leaf);
  color: var(--quest-cream);
  transform: translateY(-2px);
}
.quest-nav__link:active {
  transform: translateY(0);
}
.quest-nav__link[aria-current='page'] {
  background: var(--quest-deep-leaf);
  color: var(--quest-cream);
}

.quest-nav__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  border-radius: 999px;
  background: var(--quest-cream);
  color: var(--quest-palm-shadow);
  font-weight: 900;
  font-size: 14px;
  transition: transform 0.18s var(--quest-ease);
  box-shadow: 0 0 0 rgba(0, 0, 0, 0);
}
.quest-nav__cta:hover {
  transform: translateY(-2px);
}
.quest-nav__cta:active {
  transform: translateY(0);
}

/* ---------------------------------------------------------------------
   Shared pills / buttons / stat chips
   --------------------------------------------------------------------- */
.quest-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  border-radius: 999px;
  background: var(--quest-deep-leaf);
  font-weight: 800;
  font-size: 15px;
  color: var(--quest-cream);
}

.quest-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 16px 28px;
  border-radius: 999px;
  font-family: var(--quest-font-display);
  font-size: 17px;
  letter-spacing: 0.02em;
  border: 4px solid var(--quest-ink);
  cursor: pointer;
  transition: transform 0.16s var(--quest-ease);
}
.quest-btn--mango {
  background: var(--quest-mango);
  color: var(--quest-palm-shadow);
  box-shadow: 0 8px 0 var(--quest-mango-shadow);
}
.quest-btn--lime {
  background: var(--quest-lime);
  color: var(--quest-palm-shadow);
  box-shadow: 0 8px 0 var(--quest-lime-shadow);
}
.quest-btn--hibiscus {
  background: var(--quest-hibiscus);
  color: var(--quest-cream);
  box-shadow: 0 8px 0 var(--quest-hibiscus-shadow);
}
.quest-btn--ghost {
  background: transparent;
  color: var(--quest-cream);
  border-color: var(--quest-leaf-border);
  box-shadow: none;
}
.quest-btn:hover {
  transform: translateY(-3px);
}
.quest-btn--mango:hover {
  box-shadow: 0 11px 0 var(--quest-mango-shadow);
}
.quest-btn--lime:hover {
