/* ---------------------------------------------------------------------
   Home / hero
   --------------------------------------------------------------------- */
.quest-hero {
  position: relative;
  overflow: hidden;
  min-height: 640px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 40px 48px 80px;
}

.quest-hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.quest-hero__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.55;
}
.quest-hero__scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(11, 46, 36, 0.35) 0%,
    rgba(11, 46, 36, 0.55) 55%,
    var(--quest-palm-shadow) 100%
  );
}

.quest-hero__content {
  position: relative;
  z-index: 2;
  max-width: 720px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.quest-hero__eyebrow {
  font-weight: 800;
  font-size: 14px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--quest-mango);
}

.quest-hero__title {
  font-size: clamp(40px, 6vw, var(--quest-text-display-lg));
  line-height: 1.02;
  color: var(--quest-cream);
}

.quest-hero__sub {
  font-size: 18px;
  font-weight: 600;
  line-height: 1.5;
  color: var(--quest-muted);
  max-width: 560px;
}

.quest-hero__age {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-weight: 800;
  font-size: 14px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--quest-lime);
}

.quest-hero__credit {
  align-self: flex-start;
  padding: 7px 12px;
  border-radius: var(--quest-radius-pill);
  background: rgba(11, 46, 36, 0.78);
  color: var(--quest-cream);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.quest-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 4px;
}

.quest-section {
  position: relative;
  z-index: 1;
  padding: 64px 48px;
}
.quest-section__eyebrow {
  font-weight: 800;
  font-size: 13px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--quest-mango);
  margin-bottom: 8px;
}
.quest-section__title {
  font-size: var(--quest-text-display-sm);
  color: var(--quest-cream);
  margin-bottom: 28px;
}

.quest-screens {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.quest-screen-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 24px;
  background: var(--quest-deep-leaf);
  border: 3px solid var(--quest-leaf-border);
  border-radius: 24px;
  transition: transform 0.18s var(--quest-ease);
}
.quest-screen-card:hover {
  transform: translateY(-4px);
  border-color: var(--quest-mango);
}
.quest-screen-card__title {
  font-family: var(--quest-font-display);
  font-size: 20px;
  color: var(--quest-cream);
}
.quest-screen-card__sub {
  font-size: 14px;
  font-weight: 600;
  color: var(--quest-muted);
  line-height: 1.5;
}

.quest-footer {
  position: relative;
  z-index: 1;
  margin-top: auto;
  padding: 40px 48px 48px;
  border-top: 1px solid var(--quest-leaf-border);
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 24px;
}
.quest-footer__brand {
  font-family: var(--quest-font-display);
  font-size: 20px;
  color: var(--quest-cream);
}
.quest-footer__contact {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 14px;
  font-weight: 700;
  color: var(--quest-muted);
}
.quest-footer__contact a:hover {
  color: var(--quest-cream);
}
.quest-footer__note {
  font-size: 12px;
  color: var(--quest-muted-2);
}

/* ---------------------------------------------------------------------
   Dashboard = the map
   --------------------------------------------------------------------- */
.quest-map-wrap {
  position: relative;
  flex: 1;
  padding: 0 48px 32px;
}

.quest-map-header {
  position: relative;
  z-index: 2;
  max-width: 640px;
  margin-left: 392px;
  padding: 8px 0 24px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.quest-map-header__eyebrow {
  font-weight: 800;
  font-size: 14px;
  letter-spacing: 0.14em;
  color: var(--quest-mango);
}
.quest-map-header__title {
  font-size: clamp(32px, 4.5vw, var(--quest-text-display-lg));
  color: var(--quest-cream);
    transform: scale(1.035);
  }
}
.quest-pulse {
  animation: quest-mascot-pulse 0.5s var(--quest-ease);
}
@keyframes quest-mascot-pulse {
  0% {
    transform: scale(1);
  }
  40% {
    transform: scale(1.18);
  }
  100% {
    transform: scale(1);
  }
}

.quest-mascot__name {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--quest-muted);
}

/* ---------------------------------------------------------------------
   Batizado
   --------------------------------------------------------------------- */
.quest-batizado-hero {
  position: relative;
  z-index: 1;
  padding: 24px 48px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 18px;
}
.quest-batizado-hero__title {
  font-size: clamp(34px, 5vw, var(--quest-text-display-lg));
  color: var(--quest-cream);
}
.quest-batizado-hero__intro {
  max-width: 680px;
  font-size: 17px;
  font-weight: 600;
  color: var(--quest-muted);
  line-height: 1.6;
}

.quest-countdown.countdown {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14px;
}
.countdown__unit {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 14px 18px;
  border-radius: 16px;
  background: var(--quest-deep-leaf);
  border: 3px solid var(--quest-leaf-border);
  min-width: 70px;
}
.countdown__value {
  font-family: var(--quest-font-display);
  font-size: 30px;
  color: var(--quest-mango);
}
.countdown__label {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: var(--quest-muted);
  text-transform: uppercase;
}
.countdown__note {
  width: 100%;
  text-align: center;
  font-size: 12px;
  color: var(--quest-muted-2);
  margin-top: 6px;
}
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.08);
  }
}
.quest-node__flag {
  animation: quest-flag-bob 2.2s ease-in-out 0.75s infinite both;
}
@keyframes quest-flag-bob {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-6px);
  }
}

/* ---------------------------------------------------------------------
   Responsive
   --------------------------------------------------------------------- */
@media (max-width: 900px) {
  /* Safety net: flex items default to min-width:auto, which lets an
     unbreakable word/token force its flex row (and therefore the page)
     wider than the viewport. Reset it broadly for this narrow layout. */
  .quest-page * {
    min-width: 0;
  }

  .quest-nav {
    padding: 18px 20px;
  }
  .quest-nav__links {
    order: 3;
    width: 100%;
    justify-content: flex-start;
    overflow-x: auto;
  }
  .quest-hero {
    padding: 24px 20px 56px;
    min-height: 520px;
  }
  .quest-section {
    padding: 44px 20px;
  }
  .quest-screens {
    grid-template-columns: 1fr 1fr;
  }
  .quest-footer {
    padding: 32px 20px 40px;
  }

  .quest-map-wrap {
    padding: 0 20px 56px;
  }
  .quest-map-header {
    margin-left: 0;
    padding-top: 0;
  }
  .quest-map-body {
    flex-direction: column;
  }
  .quest-map-left {
    width: 100%;
    min-width: 0;
  }
  .quest-hud {
    min-width: 0;
  }
  .quest-hud__top,
  .quest-hud__xp-row {
    min-width: 0;
  }
  .quest-hud__name {
    font-size: 28px;
  }
  .quest-hud__stats {
    flex-direction: column;
    gap: 8px;
  }
  .quest-hud__stat {
    flex-direction: row;
    justify-content: space-between;
    padding: 10px 16px;
    padding: 14px 16px 10px;
  }
  .quest-nav__brand {
    gap: 10px;
  }
  .quest-nav__mark {
    width: 40px;
    height: 40px;
    border-radius: 12px;
  }
  .quest-nav__wordmark {
    font-size: 18px;
  }
  .quest-nav__cta {
    padding: 9px 15px;
    font-size: 13px;
  }
  .quest-nav__links {
    flex-wrap: nowrap;
    gap: 2px;
    padding-bottom: 4px;
    scrollbar-width: none;
  }
  .quest-nav__links::-webkit-scrollbar {
    display: none;
  }
  .quest-nav__link {
    flex: 0 0 auto;
    padding: 8px 11px;
    font-size: 12px;
  }

  .quest-hero {
    min-height: calc(100svh - 112px);
    padding: 34px 20px 50px;
  }
  .quest-hero__content {
    gap: 16px;
  }
  .quest-hero__title {
    font-size: 44px;
  }
  .quest-hero__sub {
    font-size: 16px;
    line-height: 1.45;
  }
  .quest-hero__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .quest-hero__actions .quest-btn {
    justify-content: center;
    padding: 13px 10px;
    font-size: 15px;
    text-align: center;
  }
  .quest-screens {
    grid-template-columns: 1fr;
  }

  .quest-map-wrap {
    display: flex;
    flex-direction: column;
    padding-inline: 20px;
  }
  .quest-map-header {
    padding-top: 12px;
  }
  .quest-map-header__title {
    font-size: 42px;
    line-height: 1.05;
  }
  .quest-map-header__sub {
    font-size: 15px;
    line-height: 1.5;
    margin-top: 16px;
  }
  .quest-quiz .quiz__choice {
    gap: 12px;
    padding: 12px 14px;
    border-radius: 16px;
    font-size: 17px;
  }
  .quest-quiz .quiz__choice::before {
    width: 38px;
    height: 38px;
    font-size: 17px;
  }
  .quest-quiz .quiz__feedback {
    padding: 13px 16px;
    margin-top: 14px;
  }
  .quest-section--instruments {
    padding-top: 30px;
  }
  .quest-instrument-card {
    padding: 12px;
  }
  .quest-instrument-card__blurb {
    font-size: 12px;
  }

  .quest-batizado-hero {
    gap: 14px;
    padding-top: 28px;
  }
  .quest-batizado-hero__title {
    font-size: 46px;
  }
  .quest-batizado-hero__intro {
    font-size: 16px;
    line-height: 1.55;
  }
  .quest-countdown.countdown {
    flex-wrap: wrap;
    gap: 7px;
  }
  .countdown__unit {
    min-width: 0;
    padding: 10px 9px;
  }
  .countdown__value {
    font-size: 25px;
  }
  .quest-gate-reveal {
    margin-top: 34px;
  }
  .quest-gate-panel {
    padding: 34px 18px;
  }
}

body.direction-quest :focus-visible {
  outline: 3px solid var(--quest-lime);
  outline-offset: 4px;
}
.quest-checklist li {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  color: var(--quest-muted);
}
.quest-checklist li.is-met { color: var(--quest-cream); }
.quest-checklist__mark {
  flex: 0 0 22px;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 3px solid var(--quest-leaf-border);
}
.quest-checklist li.is-met .quest-checklist__mark {
  background: var(--quest-lime);
  border-color: var(--quest-lime);
}
.quest-patch-list { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 8px; }
.quest-patch-list li { color: var(--quest-cream); }
.quest-timeline { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 10px; }
.quest-timeline li { color: var(--quest-cream); font-size: 15px; }
.quest-timeline li span { display: block; color: var(--quest-muted); font: 800 11px/1.2 var(--quest-font-label); letter-spacing: .08em; text-transform: uppercase; }
.quest-practice { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 12px; }
.quest-practice li {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  background: var(--quest-palm-shadow);
  border-radius: 16px;
  padding: 14px 16px;
}
.quest-practice li div { display: grid; gap: 4px; min-width: 0; }
.quest-practice li span { color: var(--quest-muted); font-size: 13px; }
.quest-chip {
  display: inline-flex;
  align-items: center;
  min-height: 36px;
  padding: 0 14px;
  border-radius: 999px;
  background: var(--quest-lime);
  color: var(--quest-ink);
  font: 800 12px/1 var(--quest-font-label);
  letter-spacing: .06em;
  text-transform: uppercase;
  white-space: nowrap;
}
.quest-privacy__list { margin: 12px 0 0; padding-left: 1.2em; color: var(--quest-cream); display: grid; gap: 8px; }
.quest-privacy .quest-card__body + .quest-card__body { margin-top: 10px; }
.quest-footer__note a { color: var(--quest-mango); }
.quest-avatar-picker { min-width: 0; }

@media (max-width: 860px) {
  .quest-report__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .quest-practice li { flex-wrap: wrap; }
  .quest-report__hero { flex-wrap: wrap; }
}
@media (max-width: 430px) {
  .quest-report__stats { grid-template-columns: 1fr 1fr; }
  .quest-stat__value { font-size: 24px; }
}

@media (prefers-reduced-motion: reduce) {
  .quest-grownup { transition: none; }
  .quest-family-card .quest-player-card { transition: none; }
}

@media print {
  .quest-nav,
  .quest-footer,
  .quest-stagelight,
  .quest-demo-badge,
  .quest-grownup,
  [data-print-hide] { display: none !important; }
  body.direction-quest,
  .quest-page,
  .quest-screen,
  .quest-card,
  .quest-stat {
    background: #fff !important;
    color: #0B2E24 !important;
    box-shadow: none !important;
    border-color: #c8c8c8 !important;
  }
  .quest-screen__title,
  .quest-card__title,
  .quest-stat__value { color: #0B2E24 !important; }
  .quest-screen__sub,
  .quest-card__body,
  .quest-muted,
  .quest-stat__hint,
  .quest-timeline li span { color: #3d5c50 !important; }
  .quest-report { max-width: none; }
  .quest-report__stats { display: block; }
  .quest-stat { margin-bottom: 8px; }
  .quest-page { overflow: visible; }
}


/* === WP5: public === */
.quest-nav__more {
  position: relative;
  z-index: 6;
  flex-shrink: 0;
}
.quest-nav__more-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 16px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--quest-muted);
  font-weight: 800;
  font-size: 14px;
  letter-spacing: 0.04em;
  font-family: var(--quest-font-label);
  cursor: pointer;
}
.quest-nav__more-btn:hover,
.quest-nav__more-btn[aria-expanded='true'],
.quest-nav__more-btn[data-current='true'] {
  background: var(--quest-deep-leaf);
  color: var(--quest-cream);
}
.quest-nav__more-caret {
  transition: transform 0.18s var(--quest-ease);
}
.quest-nav__more-btn[aria-expanded='true'] .quest-nav__more-caret {
  transform: rotate(180deg);
}
.quest-more-backdrop {
  position: fixed;
  inset: 0;
  z-index: 40;
  background: rgba(11, 46, 36, 0.55);
}
.quest-more-panel {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  z-index: 41;
  min-width: 220px;
  padding: 14px;
  background: var(--quest-deep-leaf);
  border: 3px solid var(--quest-leaf-border);
  border-radius: 20px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.quest-more-panel__title {
  font: 800 11px/1 var(--quest-font-label);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--quest-mango);
  margin: 0 8px 8px;
}
.quest-more-panel__link {
  display: block;
  padding: 12px 14px;
  border-radius: 12px;
  color: var(--quest-cream);
  font-weight: 800;
  font-size: 15px;
}
.quest-more-panel__link:hover,
.quest-more-panel__link[aria-current='page'] {
  background: var(--quest-palm-shadow);
  color: var(--quest-lime);
}
.quest-more-panel__close {
  display: none;
  margin-top: 10px;
  min-height: 48px;
  border: 3px solid var(--quest-leaf-border);
  border-radius: 999px;
  background: transparent;
  color: var(--quest-cream);
  font: 800 14px/1 var(--quest-font-label);
  cursor: pointer;
}
body.quest-more-open {
  overflow: hidden;
}

.quest-hero__poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.quest-hero__video {
  opacity: 0;
}
.quest-hero__video[src] {
  opacity: 0.55;
}
.quest-hero__contact {
  font-weight: 700;
  font-size: 14px;
  color: var(--quest-muted);
}
.quest-hero__contact a {
  color: var(--quest-lime);
}
.quest-hero__contact a:hover {
  color: var(--quest-cream);
}

.quest-footer__links {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 16px;
  max-width: 720px;
  font-size: 13px;
  font-weight: 700;
}
.quest-footer__links a {
  color: var(--quest-muted);
}
.quest-footer__links a:hover {
  color: var(--quest-cream);
}
.quest-footer__credit {
  display: block;
  margin-top: 6px;
  color: var(--quest-muted-2);
}

.quest-prose {
  max-width: 62ch;
  font-size: 18px;
  line-height: 1.65;
  color: var(--quest-muted);
  margin: 0 0 28px;
}
.quest-prose p {
  margin: 0 0 16px;
}
.quest-prose strong {
  color: var(--quest-mango);
  font-weight: 800;
}

.quest-review-note {
  display: inline-block;
  margin: 0 0 22px;
  padding: 8px 12px;
  border: 2px dashed var(--quest-mango);
  border-radius: 999px;
  color: var(--quest-mango);
  font: 800 11px/1 var(--quest-font-label);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.quest-public-stops {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 18px;
}
.quest-public-stops--four {
  grid-template-columns: repeat(4, 1fr);
}
.quest-stop-card,
.quest-educator,
.quest-stop-card__img,
.quest-educator__photo,
.quest-public-heroimg {
  min-width: 0;
  max-width: 100%;
}
.quest-stop-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
  background: var(--quest-deep-leaf);
  border: 3px solid var(--quest-leaf-border);
  border-radius: 24px;
  overflow: hidden;
  color: var(--quest-cream);
  transition: transform 0.18s var(--quest-ease), border-color 0.18s;
}
.quest-stop-card:hover {
  transform: translateY(-4px);
  border-color: var(--quest-mango);
}
.quest-stop-card__img {
  width: 100%;
  aspect-ratio: 16 / 10;
  object-fit: cover;
}
.quest-stop-card__title {
  font-family: var(--quest-font-display);
  font-size: 22px;
  padding: 0 18px;
}
.quest-stop-card__sub {
  font-size: 14px;
  font-weight: 600;
  color: var(--quest-muted);
  line-height: 1.45;
  padding: 0 18px 18px;
}

.quest-public-heroimg {
  width: 100%;
  max-width: 960px;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  border-radius: 24px;
  border: 3px solid var(--quest-leaf-border);
  margin: 0 0 28px;
}

.quest-educators {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 20px;
}
.quest-educator {
  background: var(--quest-deep-leaf);
  border: 3px solid var(--quest-leaf-border);
  border-radius: 24px;
  overflow: hidden;
  padding: 0 0 18px;
}
.quest-educator__photo {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
}
.quest-educator__title {
  margin: 14px 16px 0;
  font: 800 12px/1 var(--quest-font-label);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--quest-mango);
}
.quest-educator__name {
  margin: 6px 16px 8px;
  font-size: 26px;
  color: var(--quest-cream);
}
.quest-educator__bio {
  margin: 0 16px;
  color: var(--quest-muted);
  font-size: 14px;
  line-height: 1.45;
}

.quest-faq {
  display: grid;
  gap: 12px;
  max-width: 720px;
}
.quest-faq__item {
  background: var(--quest-deep-leaf);
  border: 3px solid var(--quest-leaf-border);
  border-radius: 18px;
  padding: 4px 8px;
}
.quest-faq__q {
  cursor: pointer;
  list-style: none;
  padding: 14px 12px;
  font-weight: 800;
  font-size: 16px;
  color: var(--quest-cream);
}
.quest-faq__q::-webkit-details-marker {
  display: none;
}
.quest-faq__item[open] .quest-faq__q {
  color: var(--quest-lime);
}
.quest-faq__a {
  margin: 0 12px 16px;
  color: var(--quest-muted);
  font-size: 16px;
  line-height: 1.5;
}
.quest-faq__a strong {
  color: var(--quest-mango);
}

.quest-field__input--area {
  min-height: 140px;
  padding: 14px 16px;
  resize: vertical;
  line-height: 1.45;
}
select.quest-field__input {
  appearance: none;
  background-image: linear-gradient(45deg, transparent 50%, var(--quest-lime) 50%),
    linear-gradient(135deg, var(--quest-lime) 50%, transparent 50%);
  background-position: calc(100% - 22px) 50%, calc(100% - 16px) 50%;
  background-size: 6px 6px, 6px 6px;
  background-repeat: no-repeat;
  padding-right: 40px;
}
.quest-form__ok {
  background: var(--quest-lime);
  color: var(--quest-ink);
  padding: 12px 16px;
  border-radius: 12px;
  font-weight: 700;
  margin-bottom: 16px;
}

.quest-card__body a {
  color: var(--quest-lime);
}
.quest-card__body a:hover {
  color: var(--quest-cream);
}

.quest-media-year {
  margin-bottom: 40px;
}
.quest-media-year__title {
  font-size: 28px;
  color: var(--quest-mango);
  margin: 0 0 16px;
}

.quest-cordas-track--page {
  flex-wrap: wrap;
  margin-top: 8px;
}

.quest-latest {
  max-width: 860px;
}
.quest-latest .yt-embed {
  border-radius: 20px;
  overflow: hidden;
  border: 4px solid var(--quest-ink);
}
.quest-yt-lite {
  position: relative;
  display: block;
  width: 100%;
  padding: 0;
  border: 4px solid var(--quest-ink);
  border-radius: 20px;
  overflow: hidden;
  cursor: pointer;
  background: var(--quest-deep-leaf);
  color: var(--quest-cream);
}
.quest-yt-lite img {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
}
.quest-yt-lite__play {
  position: absolute;
  inset: 50% auto auto 50%;
  transform: translate(-50%, -50%);
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: var(--quest-mango);
  color: var(--quest-ink);
  display: grid;
  place-items: center;
  box-shadow: 0 6px 0 var(--quest-mango-shadow);
}
.quest-yt-lite:hover .quest-yt-lite__play {
  background: var(--quest-lime);
}
.quest-latest .quest-video-card__credit {
  margin-top: 10px;
}

.quest-shop-price {
  margin-bottom: 18px;
}

@media (max-width: 900px) {
  .quest-public-stops--four {
    grid-template-columns: 1fr 1fr;
  }
  .quest-nav__more {
    margin-left: auto;
  }
}

@media (max-width: 600px) {
  .quest-public-stops,
  .quest-public-stops--four {
    grid-template-columns: 1fr;
  }
  .quest-more-backdrop:not([hidden]) {
    display: block;
  }
  .quest-more-panel {
    position: fixed;
    top: unset;
    right: 0;
    left: 0;
    bottom: 0;
    min-width: 0;
    max-height: 80vh;
    overflow: auto;
    border-radius: 24px 24px 0 0;
    padding: 22px 20px 28px;
  }
  .quest-more-panel__close {
    display: block;
    width: 100%;
  }
  .quest-hero__actions {
    grid-template-columns: 1fr;
  }
  .quest-videos {
    grid-template-columns: 1fr;
  }
  .quest-gallery.gallery {
    grid-template-columns: 1fr 1fr;
  }
  .quest-nav__more-btn {
    padding: 8px 12px;
    font-size: 12px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .quest-nav__more-caret,
  .quest-stop-card,
  .quest-gallery .gallery__img {
    transition: none;
  }
  .quest-stop-card:hover {
    transform: none;
  }
}

/* === WP6: coach === */
.quest-screen--wide { max-width: 1180px; }
.quest-coach-nav { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 28px; }
.quest-coach-nav a { min-height: 40px; padding: 8px 14px; border-radius: 999px; border: 3px solid var(--quest-leaf-border); color: var(--quest-cream); font: 800 12px/1 var(--quest-font-label); letter-spacing: .08em; text-transform: uppercase; display: inline-flex; align-items: center; }
.quest-coach-nav a[aria-current="page"] { background: var(--quest-lime); color: var(--quest-ink); border-color: var(--quest-lime); }
.quest-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 18px; }
.quest-stat-card { background: var(--quest-deep-leaf); border: 3px solid var(--quest-mango); border-radius: var(--quest-radius-lg); padding: 18px; }
.quest-stat-card__value { font-family: var(--quest-font-display); font-size: 36px; color: var(--quest-lime); margin: 0; }
.quest-stat-card__label { color: var(--quest-muted); font: 800 12px/1.3 var(--quest-font-label); letter-spacing: .08em; text-transform: uppercase; margin: 6px 0 0; }
.quest-buckets { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; align-items: end; min-height: 140px; margin-top: 12px; }
.quest-buckets__col { display: grid; justify-items: center; gap: 6px; }
.quest-buckets__bar { display: block; width: 100%; min-height: 8px; background: var(--quest-mango); border-radius: 8px 8px 0 0; }
.quest-buckets__n { color: var(--quest-cream); font: 800 14px/1 var(--quest-font-label); }
.quest-buckets__label { color: var(--quest-muted); font-size: 11px; }
.quest-quiet { margin: 8px 0 0; padding: 0; list-style: none; display: grid; gap: 6px; }

