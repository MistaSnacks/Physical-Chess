+}
+.quest-turma-board .quest-lb__row:first-child .quest-lb__rank {
+  background: var(--quest-mango);
+  color: var(--quest-ink);
+}
+.quest-turma-board .quest-lb__ava svg {
+  display: block;
+  filter: drop-shadow(0 3px 0 rgba(0, 0, 0, .28));
+}
+.quest-turma-board .quest-lb__name {
+  min-width: 0;
