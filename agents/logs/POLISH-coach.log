@@ -4402,3 +4402,753 @@
 .quest-footer__note {
   color: var(--quest-cream);
 }
+
+/* === POLISH: coach === */
+.quest-screen {
+  position: relative;
+  z-index: 1;
+}
+
+.quest-coach-screen {
+  padding-top: 40px;
+}
+.quest-coach-screen .quest-screen__sub {
+  max-width: 58ch;
+  margin-bottom: 24px;
+}
+.quest-coach-nav {
+  gap: 10px;
+  margin-bottom: 32px;
+}
+.quest-coach-nav a {
+  min-height: 44px;
+  padding: 8px 16px;
+  text-decoration: none;
+  transition: transform .18s var(--quest-ease), border-color .18s var(--quest-ease), background-color .18s var(--quest-ease), box-shadow .18s var(--quest-ease);
+}
+.quest-coach-nav a:hover {
+  transform: translateY(-2px);
+  border-color: var(--quest-mango);
+  box-shadow: 0 4px 0 rgba(0, 0, 0, .2);
+}
+.quest-coach-nav a:focus-visible {
+  outline: 3px solid var(--quest-lime);
+  outline-offset: 3px;
+}
+.quest-coach-nav a[aria-current="page"] {
+  box-shadow: 0 4px 0 var(--quest-lime-shadow);
+}
+
+.quest-coach-screen [data-coach-root] > .quest-card,
+.quest-coach-screen [data-coach-root] > .quest-coach-hero {
+  margin-top: 24px;
+}
+.quest-coach-screen [data-coach-root] > .quest-stats + .quest-card {
+  margin-top: 24px;
+}
+.quest-coach-screen .quest-card {
+  box-shadow: 0 8px 0 rgba(0, 0, 0, .14);
+}
+.quest-coach-kicker,
+.quest-turma-board__eyebrow,
+.quest-turma-hero__eyebrow {
+  color: var(--quest-mango);
+  font: 800 12px/1.2 var(--quest-font-label);
+  letter-spacing: .12em;
+  text-transform: uppercase;
+  margin: 0 0 6px;
+}
+.quest-coach-section-heading {
+  display: flex;
+  justify-content: space-between;
+  align-items: end;
+  gap: 24px;
+  margin-bottom: 20px;
+}
+.quest-coach-section-heading .quest-card__title {
+  margin-bottom: 0;
+}
+.quest-coach-section-heading > p {
+  color: var(--quest-muted);
+  font: 800 12px/1.3 var(--quest-font-label);
+  letter-spacing: .04em;
+  margin: 0;
+  text-align: right;
+}
+
+.quest-stats {
+  gap: 16px;
+  margin-bottom: 0;
+}
+.quest-stat-card {
+  min-height: 132px;
+  padding: 22px;
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  box-shadow: 0 6px 0 rgba(0, 0, 0, .16);
+}
+.quest-stat-card:nth-child(2) {
+  border-color: var(--quest-lime);
+}
+.quest-stat-card:nth-child(3) {
+  border-color: var(--quest-hibiscus);
+}
+.quest-stat-card__value {
+  font-size: 44px;
+  line-height: 1;
+}
+.quest-stat-card__label {
+  color: var(--quest-cream);
+  line-height: 1.35;
+}
+.quest-buckets {
+  min-height: 176px;
+  padding: 12px 8px 0;
+  gap: 14px;
+  border-bottom: 2px solid var(--quest-leaf-border);
+}
+.quest-buckets__col {
+  align-self: stretch;
+  grid-template-rows: 1fr auto auto;
+  align-items: end;
+}
+.quest-buckets__bar {
+  align-self: end;
+  box-shadow: inset 0 -4px 0 var(--quest-mango-shadow);
+}
+.quest-buckets__n {
+  margin-top: 4px;
+}
+.quest-buckets__label {
+  min-height: 28px;
+  color: var(--quest-cream);
+  text-align: center;
+}
+.quest-coach-checkins {
+  padding: 22px 24px;
+}
+.quest-quiet {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+  margin-top: 14px;
+}
+.quest-quiet li {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  border-radius: 999px;
+  background: var(--quest-palm-shadow);
+  overflow: hidden;
+}
+.quest-quiet a,
+.quest-quiet span {
+  padding: 10px 14px;
+}
+.quest-quiet a {
+  color: var(--quest-ink);
+  background: var(--quest-mango);
+  font-weight: 900;
+}
+.quest-quiet a:focus-visible,
+.quest-roster-link:focus-visible {
+  outline: 3px solid var(--quest-lime);
+  outline-offset: 3px;
+}
+.quest-quiet span {
+  color: var(--quest-cream);
+}
+
+.quest-card--table {
+  padding: 28px 24px 20px;
+}
+.quest-table--roster tbody tr {
+  transition: background-color .18s ease;
+}
+.quest-table--roster tbody tr:hover {
+  background: rgba(185, 242, 107, .06);
+}
+.quest-table--roster th,
+.quest-table--roster td {
+  vertical-align: middle;
+}
+.quest-table--roster th:nth-child(n + 3),
+.quest-table--roster td:nth-child(n + 3) {
+  text-align: right;
+}
+.quest-roster-link {
+  min-height: 44px;
+  text-underline-offset: 4px;
+  font-weight: 900;
+}
+.quest-roster-link:hover {
+  color: var(--quest-lime);
+}
+.quest-roster-ava svg {
+  filter: drop-shadow(0 3px 0 rgba(0, 0, 0, .28));
+}
+
+.quest-class-screen .quest-field.quest-card {
+  max-width: 680px;
+  padding: 20px 24px 4px;
+  margin-bottom: 24px;
+}
+.quest-players--class {
+  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
+  gap: 20px;
+}
+.quest-players--class .quest-player-card {
+  min-height: 236px;
+  padding: 28px 20px 22px;
+  box-shadow: 0 7px 0 rgba(0, 0, 0, .18);
+}
+.quest-class-card__cue,
+.quest-attendance-state {
+  color: var(--quest-muted);
+  font: 800 11px/1.2 var(--quest-font-label);
+  letter-spacing: .1em;
+  text-transform: uppercase;
+}
+.quest-player-card:hover .quest-class-card__cue,
+.quest-player-card:focus-visible .quest-class-card__cue {
