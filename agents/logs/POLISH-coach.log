export function fromAccountRow(r) {
  return {
    id: r._id || r.id,
    memberId: r.memberId,
    role: r.role || 'guardian',
    displayName: r.displayName || '',
    email: r.email || '',
    phone: r.phone || '',
    programs: r.programs || [],
    leaderboardOptIn: r.leaderboardOptIn !== false,
