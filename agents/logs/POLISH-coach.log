export function programsForAccount(account) {
  if (!account) return [];
  if (account.role === 'admin') return PROGRAMS.filter((p) => p.active);
  const keys = account.programs || [];
  if (!keys.length) return [];
  return keys.map(programByKey).filter(Boolean);
}

