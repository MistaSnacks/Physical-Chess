.quest-hub .quest-rail__item:not(.quest-rail__item--locked):hover,
.quest-lesson .quest-rail__item:not(.quest-rail__item--locked):hover,
.quest-rating button:not(:disabled):hover,
.quest-readaloud:hover {
  transform: translateY(-2px);
  border-color: var(--quest-lime);
  box-shadow: 0 4px 0 var(--quest-lime-shadow);
}

.quest-hub .quest-rail__item:not(.quest-rail__item--locked):active,
.quest-lesson .quest-rail__item:not(.quest-rail__item--locked):active,
.quest-rating button:not(:disabled):active,
.quest-readaloud:active,
.quest-quiz .quiz__choice:not(:disabled):active,
.quest-quiz .quiz__next:active {
  transform: translateY(2px);
  box-shadow: 0 1px 0 var(--quest-lime-shadow);
}

.quest-rail__item--locked {
  opacity: 1;
  background: color-mix(in srgb, var(--quest-deep-leaf) 82%, var(--quest-palm-shadow));
}

.quest-rail__item--locked .quest-rail__item-title {
  color: var(--quest-cream);
}

.quest-hub-gate[data-state='locked'] {
  opacity: 1;
}

.quest-lesson__stage {
  box-shadow: 0 8px 0 color-mix(in srgb, var(--quest-palm-shadow) 72%, transparent);
}

.quest-lesson__title {
  font-size: clamp(34px, 4vw, 42px);
  line-height: 1.05;
}

.quest-lesson__summary,
.quest-panel__summary {
  max-width: 65ch;
  line-height: 1.6;
}

.quest-reading__figure img,
.quest-hub-photo img {
  display: block;
}

.quest-reading__figure img {
  aspect-ratio: 16 / 8.5;
  object-fit: cover;
}

.quest-reading__toolbar {
  min-height: 44px;
}

.quest-reading p:last-child {
  margin-bottom: 0;
}

.quest-check {
  border: 3px solid var(--quest-leaf-border);
}

.quest-check__prompt {
  max-width: 34ch;
  line-height: 1.2;
}

.quest-check [data-check-feedback] {
  min-height: 24px;
  margin-bottom: 0;
}

.quiz__chrome {
  grid-template-columns: auto 1fr;
  align-items: center;
  column-gap: 16px;
}

.quiz__progress-label {
  justify-self: end;
  margin: 0;
  color: var(--quest-mango);
  font: 800 13px/1 var(--quest-font-label);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.quest-quiz-progress {
  grid-column: 1 / -1;
  width: 100%;
}

.quest-quiz .quiz__next {
  min-height: 48px;
}

.quest-instrument-card__blurb,
.quest-word-card__meaning,
.quest-hub-tile figcaption {
  font-size: 14px;
  line-height: 1.5;
}

.quest-word-card__word,
.quest-word-card__meaning,
.quest-instrument-card__blurb,
.quest-hub-tile figcaption {
  max-width: 65ch;
}

@media (max-width: 860px) {
  .quest-hub .quest-rail__back {
    position: sticky;
    left: 0;
    z-index: 3;
    margin-right: 2px;
    box-shadow: 12px 0 18px var(--quest-palm-shadow);
  }

  .quest-hub .quest-rail__group-title {
    max-width: 92px;
    font-size: 11px;
    line-height: 1.25;
  }

  .quest-hub .quest-rail__item,
  .quest-lesson .quest-rail__item {
    flex-basis: 204px;
  }

  .quest-lesson__stage {
    padding: 28px 24px;
    border-radius: 28px;
  }

  .quest-lesson__summary {
    font-size: 17px;
    line-height: 1.55;
  }

  .quest-reading {
    font-size: 17px;
    line-height: 1.65;
  }

  .quest-reading__figure img {
    aspect-ratio: 4 / 3;
  }

  .quest-check {
    padding: 18px 16px;
  }

  .quest-check__top {
    align-items: flex-start;
  }

  .quiz__progress-label {
    font-size: 12px;
  }

  .quest-instrument-card__blurb,
  .quest-word-card__meaning,
  .quest-hub-tile figcaption {
    font-size: 15px;
  }
}

@media (max-width: 430px) {
  .quest-hub .quest-detail {
    padding-inline: 16px;
  }

  .quest-hub .quest-rail {
    margin-inline: -16px;
    padding-inline: 16px;
  }

  .quest-lesson__stage {
    padding: 24px 20px;
  }

  .quest-lesson__title {
    font-size: 34px;
  }

  .quest-check__top {
    flex-direction: column;
  }

  .quest-check__top .quest-readaloud {
    width: 100%;
    justify-content: center;
  }

  .quest-watch__row .quest-btn {
    flex: 1 1 auto;
    padding-inline: 18px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .quest-hub .quest-rail__item,
  .quest-lesson .quest-rail__item,
  .quest-rating button,
  .quest-readaloud,
  .quest-quiz .quiz__choice,
  .quest-quiz .quiz__next,
  .quest-lesson__stage {
    transition: none;
  }
}

diff --git a//tmp/polish-lessons-shot.mjs b//tmp/polish-lessons-shot.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..5c47514d22fa5ecc3824c754e12c2a99ad9dcd3a
--- /dev/null
+++ b//tmp/polish-lessons-shot.mjs
@@ -0,0 +1,51 @@
+import { chromium } from '/Users/admin/pc-pol-lessons/node_modules/playwright/index.mjs';
+import { mkdirSync } from 'node:fs';
+
+const base = 'http://127.0.0.1:4412';
+const output = process.argv[2] || '/tmp/polish-lessons-baseline';
+mkdirSync(output, { recursive: true });
+
+const routes = [
+  ['hub-movements', '/learn/movements'],
+  ['hub-music', '/learn/music'],
+  ['hub-culture', '/learn/culture'],
+  ['hub-graduation', '/learn/graduation'],
+  ['lesson-video', '/learn/movements/ginga-basics'],
+  ['lesson-reading', '/learn/music/meet-the-berimbau'],
+  ['lesson-drill', '/learn/movements/esquiva-cocorinha'],
+  ['lesson-quiz', '/learn/music/music-quiz'],
+];
+
+const browser = await chromium.launch();
+const context = await browser.newContext({ viewport: { width: 1440, height: 900 } });
+const page = await context.newPage();
+const errors = [];
+page.on('pageerror', (error) => errors.push(error.message));
+page.on('console', (message) => {
+  if (message.type() === 'error' && !/compute-pressure/i.test(message.text())) errors.push(message.text());
+});
+
+await page.goto(`${base}/login?demo=1`, { waitUntil: 'domcontentloaded' });
+await page.waitForURL('**/who**');
+await page.locator('.quest-player-card:has-text("Gatinha")').click();
+await page.waitForURL('**/journey**');
+
+for (const [width, height, label] of [[1440, 900, '1440'], [390, 844, '390']]) {
+  await page.setViewportSize({ width, height });
+  for (const [name, route] of routes) {
+    await page.goto(`${base}${route}`, { waitUntil: 'domcontentloaded' });
+    await page.waitForSelector('[data-hub], [data-lesson-stage]:not([inert])');
+    await page.waitForTimeout(900);
+    const metrics = await page.evaluate(() => ({
+      path: location.pathname,
+      viewport: document.documentElement.clientWidth,
+      scrollWidth: document.documentElement.scrollWidth,
+      bodyScrollWidth: document.body.scrollWidth,
+    }));
+    console.log(JSON.stringify({ name, label, ...metrics }));
+    await page.screenshot({ path: `${output}/${name}-${label}.png`, fullPage: true });
+  }
+}
+
+if (errors.length) console.log(JSON.stringify({ errors }, null, 2));
+await browser.close();
