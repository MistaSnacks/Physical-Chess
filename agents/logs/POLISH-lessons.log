diff --git a//tmp/polish-lessons-shot.mjs b//tmp/polish-lessons-shot.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..5c47514d22fa5ecc3824c754e12c2a99ad9dcd3a
--- /dev/null
+++ b//tmp/polish-lessons-shot.mjs
@@ -0,0 +1,51 @@
+import { chromium } from '/Users/admin/pc-pol-lessons/node_modules/playwright/index.mjs';
+import { mkdirSync } from 'node:fs';
+
+const base = 'http://127.0.0.1:4412';
+const output = process.argv[2] || '/tmp/polish-lessons-baseline';
+mkdirSync(output, { recursive: true });
+
+const routes = [
+  ['hub-movements', '/learn/movements'],
+  ['hub-music', '/learn/music'],
+  ['hub-culture', '/learn/culture'],
+  ['hub-graduation', '/learn/graduation'],
+  ['lesson-video', '/learn/movements/ginga-basics'],
+  ['lesson-reading', '/learn/music/meet-the-berimbau'],
+  ['lesson-drill', '/learn/movements/esquiva-cocorinha'],
+  ['lesson-quiz', '/learn/music/music-quiz'],
+];
+
+const browser = await chromium.launch();
+const context = await browser.newContext({ viewport: { width: 1440, height: 900 } });
+const page = await context.newPage();
+const errors = [];
+page.on('pageerror', (error) => errors.push(error.message));
+page.on('console', (message) => {
+  if (message.type() === 'error' && !/compute-pressure/i.test(message.text())) errors.push(message.text());
+});
+
+await page.goto(`${base}/login?demo=1`, { waitUntil: 'domcontentloaded' });
+await page.waitForURL('**/who**');
+await page.locator('.quest-player-card:has-text("Gatinha")').click();
+await page.waitForURL('**/journey**');
+
+for (const [width, height, label] of [[1440, 900, '1440'], [390, 844, '390']]) {
+  await page.setViewportSize({ width, height });
+  for (const [name, route] of routes) {
+    await page.goto(`${base}${route}`, { waitUntil: 'domcontentloaded' });
+    await page.waitForSelector('[data-hub], [data-lesson-stage]:not([inert])');
+    await page.waitForTimeout(900);
+    const metrics = await page.evaluate(() => ({
+      path: location.pathname,
+      viewport: document.documentElement.clientWidth,
+      scrollWidth: document.documentElement.scrollWidth,
+      bodyScrollWidth: document.body.scrollWidth,
+    }));
+    console.log(JSON.stringify({ name, label, ...metrics }));
+    await page.screenshot({ path: `${output}/${name}-${label}.png`, fullPage: true });
+  }
+}
+
+if (errors.length) console.log(JSON.stringify({ errors }, null, 2));
+await browser.close();
