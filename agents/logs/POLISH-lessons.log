+}
+
+.quest-check__prompt {
+  max-width: 34ch;
+  line-height: 1.2;
+}
+
+.quest-check [data-check-feedback] {
+  min-height: 24px;
+  margin-bottom: 0;
+}
+
+.quiz__chrome {
+  grid-template-columns: auto 1fr;
+  align-items: center;
+  column-gap: 16px;
+}
+
+.quiz__progress-label {
+  justify-self: end;
+  margin: 0;
+  color: var(--quest-mango);
+  font: 800 13px/1 var(--quest-font-label);
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.quest-quiz-progress {
+  grid-column: 1 / -1;
+  width: 100%;
+}
+
+.quest-quiz .quiz__next {
+  min-height: 48px;
+}
+
+.quest-instrument-card__blurb,
+.quest-word-card__meaning,
+.quest-hub-tile figcaption {
+  font-size: 14px;
+  line-height: 1.5;
+}
+
+.quest-word-card__word,
+.quest-word-card__meaning,
+.quest-instrument-card__blurb,
+.quest-hub-tile figcaption {
+  max-width: 65ch;
+}
+
+@media (max-width: 860px) {
+  .quest-hub__mobile-back {
+    display: inline-flex;
+    align-items: center;
+    justify-self: start;
+    gap: 8px;
+    min-height: 44px;
+    padding: 0 18px 0 12px;
+    border-radius: 999px;
+    background: var(--quest-deep-leaf);
+    color: var(--quest-cream);
+    font-weight: 800;
+  }
+
+  .quest-hub .quest-rail__back {
+    display: none;
+  }
+
+  .quest-hub .quest-rail__group-title {
+    max-width: 92px;
+    font-size: 11px;
+    line-height: 1.25;
+  }
+
+  .quest-hub .quest-rail__item,
+  .quest-lesson .quest-rail__item {
+    flex-basis: 204px;
+  }
+
+  .quest-lesson__stage {
+    padding: 28px 24px;
+    border-radius: 28px;
+  }
+
+  .quest-lesson__summary {
+    font-size: 17px;
+    line-height: 1.55;
+  }
+
+  .quest-reading {
+    font-size: 17px;
+    line-height: 1.65;
+  }
+
+  .quest-reading__figure img {
+    aspect-ratio: 4 / 3;
+  }
+
+  .quest-check {
+    padding: 18px 16px;
+  }
+
+  .quest-check__top {
+    align-items: flex-start;
+  }
+
+  .quiz__progress-label {
+    font-size: 12px;
+  }
+
+  .quest-instrument-card__blurb,
+  .quest-word-card__meaning,
+  .quest-hub-tile figcaption {
+    font-size: 15px;
+  }
+}
+
+@media (max-width: 430px) {
+  .quest-hub .quest-detail {
+    padding-inline: 16px;
+  }
+
+  .quest-hub .quest-rail {
+    margin-inline: -16px;
+    padding-inline: 16px;
+  }
+
+  .quest-lesson__stage {
+    padding: 24px 20px;
+  }
+
+  .quest-lesson__title {
+    font-size: 34px;
+  }
+
+  .quest-check__top {
+    flex-direction: column;
+  }
+
+  .quest-check__top .quest-readaloud {
+    width: 100%;
+    justify-content: center;
+  }
+
+  .quest-watch__row .quest-btn {
+    flex: 1 1 auto;
+    padding-inline: 18px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .quest-hub .quest-rail__item,
+  .quest-lesson .quest-rail__item,
+  .quest-rating button,
+  .quest-readaloud,
+  .quest-quiz .quiz__choice,
+  .quest-quiz .quiz__next,
+  .quest-lesson__stage {
+    transition: none;
+  }
+}
