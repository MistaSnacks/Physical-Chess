+  display: block;
+}
+
+.quest-reading__figure img {
+  aspect-ratio: 16 / 8.5;
+  object-fit: cover;
+}
+
+.quest-reading__toolbar {
+  min-height: 44px;
+}
+
+.quest-reading p:last-child {
+  margin-bottom: 0;
+}
+
