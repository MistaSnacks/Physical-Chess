---
// learn/[module]/index.astro — module hub. Level rail grouped by
// module.groups, live snapshot state, progress ring, Next up. Music gets
// the instrument field guide + glossary teaser; culture gets maps,
// manifestations, and animals; graduation gets the gate.
import { ClientRouter } from 'astro:transitions';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../directions/quest/Nav.astro';
import Footer from '../../../directions/quest/Footer.astro';
import { MODULES, LESSONS, INSTRUMENTS, GLOSSARY } from '../../../content/index.js';
import { PHOTOS, wix } from '../../../data/media.js';
import '../../../directions/quest/tokens.css';
import '../../../directions/quest/theme.css';

export function getStaticPaths() {
  return MODULES.map((m) => ({ params: { module: m.id }, props: { mod: m } }));
}

const { mod } = Astro.props;
const lessons = LESSONS.filter((l) => l.moduleId === mod.id);
const grouped = mod.groups.map((g) => ({
  ...g,
  lessons: lessons.filter((l) => l.group === g.id),
})).filter((g) => g.lessons.length);
const leftover = lessons.filter((l) => !mod.groups.some((g) => g.id === l.group));
if (leftover.length) grouped.push({ id: 'more', title: 'More', lessons: leftover });
const numberFor = Object.fromEntries(lessons.map((l, i) => [l.id, i + 1]));

const photo = mod.photoKey && PHOTOS[mod.photoKey]
  ? { src: wix(mod.photoKey, 1200, 640), caption: PHOTOS[mod.photoKey].caption }
  : null;

const CULTURE_MAPS = ['mapAfrica', 'mapBrazil', 'mapSlaveTrade'];
const CULTURE_MANIFEST = ['sambaDeRoda', 'jongoDrum', 'puxadaDeRede'];
const CULTURE_ANIMALS = ['animalGiraffe', 'animalGorilla', 'animalLizard', 'animalFrog', 'animalSnake', 'animalArmadillo'];

function fig(key) {
  const p = PHOTOS[key];
  if (!p) return null;
  return { key, src: wix(key, 720, 480), caption: p.caption };
}

const navActive = mod.id === 'graduation' ? 'batizado' : mod.id === 'culture' ? 'music' : mod.id;
const glossaryTeaser = GLOSSARY.slice(0, 6);
---

<Base title={`${mod.title} — Physical Chess`} direction="quest">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <div class="quest-stagelight quest-stagelight--b" aria-hidden="true"></div>
    <Nav active={navActive} />

    <main class="quest-hub" data-hub data-module={mod.id} data-locked-reason={mod.lockedReason || ''}>
      <div class="quest-detail">
        <aside class="quest-rail" data-quest-enter>
          <a class="quest-rail__back" href="/journey">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="#FFF6E5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Back to map
          </a>
          <h1 class="quest-rail__title">{mod.title}</h1>
          <p class="quest-rail__eyebrow" data-hub-count>Lessons</p>

          {grouped.map((g) => (
            <div class="quest-rail__group">
              <p class="quest-rail__group-title">{g.title}</p>
              <div class="quest-rail__list">
                {g.lessons.map((l) => (
                  <a class="quest-rail__item" href={`/learn/${mod.id}/${l.id}`} data-rail-lesson={l.id} data-lesson-link data-summary={l.summary}>
                    <span class="quest-rail__item-icon" data-rail-icon>{l.type === 'quiz' ? '?' : numberFor[l.id]}</span>
                    <span class="quest-rail__item-body">
                      <span class="quest-rail__item-title">{l.title}</span>
                      <span class="quest-rail__item-meta">
                        {l.minutes} min · {l.type}
                        <span class="quest-rail__stars" data-rail-stars></span>
                      </span>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </aside>

        <section class="quest-panel" data-quest-enter>
          <div class="quest-hub-hero">
            <div class="quest-hub-ring-wrap" aria-hidden="true">
              <svg class="quest-hub-ring" viewBox="0 0 120 120">
                <circle cx="60" cy="60" r="52" class="quest-hub-ring__track" />
                <circle cx="60" cy="60" r="52" class="quest-hub-ring__fill" data-hub-ring />
              </svg>
              <span class="quest-hub-ring__label" data-hub-percent>0%</span>
            </div>
            <div class="quest-hub-hero__copy">
              <span class="quest-panel__eyebrow">{mod.title}</span>
              <h2 class="quest-panel__title" data-hub-heading>{mod.title}</h2>
              <p class="quest-panel__summary" data-hub-summary>
                {mod.lockedReason || 'Pick a lesson from the rail. Stars only go up.'}
              </p>
              <p class="quest-hub-stars" data-hub-stars hidden></p>
            </div>
          </div>

          {photo && (
            <figure class="quest-hub-photo">
              <img src={photo.src} alt={photo.caption} loading="lazy" width="1200" height="640" />
            </figure>
          )}

          <div class="quest-btn-row">
            <a class="quest-btn quest-btn--lime" data-hub-next hidden href="/journey">Next up</a>
          </div>
          <p class="quest-hub-lock" data-hub-lock hidden></p>

          {mod.id === 'graduation' && (
            <div class="quest-hub-gate" data-hub-gate data-state="locked">
              <svg class="quest-hub-gate__icon" width="48" height="48" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 11h16v10H4z" fill="none" stroke="currentColor" stroke-width="2"/>
                <path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              <p class="quest-hub-gate__title" data-gate-title>The golden gate</p>
              <p class="quest-hub-gate__sub" data-gate-sub>It opens when your coach records your corda at Batizado.</p>
            </div>
          )}
        </section>
      </div>

      {mod.id === 'music' && (
        <>
          <section class="quest-section quest-section--instruments">
            <p class="quest-section__eyebrow" data-quest-enter>Music · Field guide</p>
            <h2 class="quest-section__title" data-quest-enter>Meet the roda's rhythm section.</h2>
            <div class="quest-instruments">
              {INSTRUMENTS.map((inst) => (
                <article class="quest-instrument-card" data-quest-enter>
                  <div class="quest-instrument-card__photo">
                    <img src={wix(inst.photoKey, 480, 360)} alt={PHOTOS[inst.photoKey]?.caption || inst.name} loading="lazy" />
                    <span class="quest-instrument-card__level">Rhythm find</span>
                  </div>
                  <span class="quest-instrument-card__name">{inst.name}</span>
                  <p class="quest-instrument-card__blurb">{inst.blurb}</p>
                </article>
              ))}
            </div>
          </section>
          <section class="quest-section">
            <p class="quest-section__eyebrow" data-quest-enter>Culture · Portuguese for the roda</p>
            <h2 class="quest-section__title" data-quest-enter>Six words every student learns.</h2>
            <div class="quest-words">
              {glossaryTeaser.map((w, i) => (
                <article class="quest-word-card" data-quest-enter>
                  <span class="quest-word-card__number">{String(i + 1).padStart(2, '0')}</span>
                  <p class="quest-word-card__word">{w.word}</p>
                  <p class="quest-word-card__meaning">{w.meaning}</p>
                </article>
              ))}
            </div>
          </section>
        </>
      )}

      {mod.id === 'culture' && (
        <>
          <section class="quest-section">
            <p class="quest-section__eyebrow" data-quest-enter>History · Maps</p>
            <h2 class="quest-section__title" data-quest-enter>Africa to Brazil.</h2>
            <div class="quest-hub-gallery">
              {CULTURE_MAPS.map(fig).filter(Boolean).map((f) => (
                <figure class="quest-hub-tile" data-quest-enter>
                  <img src={f.src} alt={f.caption} loading="lazy" />
                  <figcaption>{f.caption}</figcaption>
                </figure>
              ))}
            </div>
          </section>
          <section class="quest-section">
            <p class="quest-section__eyebrow" data-quest-enter>Manifestations</p>
            <h2 class="quest-section__title" data-quest-enter>Cousins of the roda.</h2>
            <div class="quest-hub-gallery">
              {CULTURE_MANIFEST.map(fig).filter(Boolean).map((f) => (
                <figure class="quest-hub-tile" data-quest-enter>
                  <img src={f.src} alt={f.caption} loading="lazy" />
                  <figcaption>{f.caption}</figcaption>
                </figure>
              ))}
            </div>
          </section>
          <section class="quest-section">
            <p class="quest-section__eyebrow" data-quest-enter>Animals of the ginga</p>
            <h2 class="quest-section__title" data-quest-enter>The menagerie on the maps.</h2>
            <div class="quest-hub-gallery quest-hub-gallery--animals">
              {CULTURE_ANIMALS.map(fig).filter(Boolean).map((f) => (
                <figure class="quest-hub-tile" data-quest-enter>
                  <img src={f.src} alt={f.caption} loading="lazy" />
                  <figcaption>{f.caption}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        </>
      )}
    </main>

    <div class="quest-toast" data-toast role="status" aria-live="polite"></div>
    <Footer />
  </div>
</Base>

<script>
  import '../../../directions/quest/motion.js';
  import { requireSession } from '../../../lib/auth-guard.js';
  import { paintLessonRail, setHubRing, toast } from '../../../lib/lesson-ui.js';

  async function init() {
    const main = document.querySelector('[data-hub]');
    if (!main || main.dataset.init === '1') return;
    main.dataset.init = '1';
    const s = await requireSession({ player: true });
    if (!s) return;

    const moduleId = main.dataset.module;
    const snap = s.snapshot;
    const modState = snap.modules[moduleId];
    const locked = Boolean(modState?.locked);
    const nextUp = snap.nextUp;
    const firstOpen = Array.from(main.querySelectorAll('[data-rail-lesson]')).find((el) => snap.lessons[el.dataset.railLesson]?.status !== 'done');
    const currentId = locked ? null : (nextUp?.moduleId === moduleId ? nextUp.lessonId : firstOpen?.dataset.railLesson);

    paintLessonRail(snap, { currentId, moduleId, lockLinks: locked });
    setHubRing(modState?.percent || 0);
    document.querySelector('.quest-rail__item--current')?.scrollIntoView({ inline: 'center', block: 'nearest' });

    const count = main.querySelector('[data-hub-count]');
    if (count) count.textContent = `${modState?.completed || 0} of ${modState?.total || 0} cleared`;

    const summary = main.querySelector('[data-hub-summary]');
    const heading = main.querySelector('[data-hub-heading]');
    const starsEl = main.querySelector('[data-hub-stars]');
    const next = main.querySelector('[data-hub-next]');
    const lockMsg = main.querySelector('[data-hub-lock]');

    if (starsEl && modState) {
      starsEl.hidden = false;
      starsEl.textContent = `${modState.stars} / ${modState.maxStars} stars`;
    }

    if (locked) {
      if (heading) heading.textContent = 'Still locked';
      if (summary) summary.textContent = modState.lockedReason || main.dataset.lockedReason || 'Finish the module before this one.';
      if (lockMsg) {
        lockMsg.hidden = false;
        lockMsg.textContent = modState.lockedReason || 'This module is locked.';
      }
      if (next) next.hidden = true;
      main.querySelectorAll('[data-lesson-link]').forEach((a) => {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          toast(modState.lockedReason || 'This module is locked.');
        });
      });
    } else if (currentId && next) {
      const row = main.querySelector(`[data-rail-lesson="${currentId}"]`);
      const lessonTitle = row?.querySelector('.quest-rail__item-title')?.textContent?.trim();
      next.hidden = false;
      next.href = `/learn/${moduleId}/${currentId}`;
      next.textContent = lessonTitle ? `Next: ${lessonTitle}` : 'Next up';
      if (heading) heading.textContent = lessonTitle || heading.textContent;
      if (summary && row?.dataset.summary) summary.textContent = row.dataset.summary;
    } else if (next) {
      next.hidden = false;
      next.href = '/journey';
      next.textContent = 'Back to the map';
      if (heading) heading.textContent = 'Module cleared';
      if (summary) summary.textContent = 'Every lesson here is done. Stars only go up if you play again.';
    }

    const gate = main.querySelector('[data-hub-gate]');
    if (gate) {
      const ready = Boolean(snap.readiness?.ready);
      const state = locked ? 'locked' : ready ? 'glow' : 'closed';
      gate.dataset.state = state;
      const title = gate.querySelector('[data-gate-title]');
      const sub = gate.querySelector('[data-gate-sub]');
      if (state === 'locked') {
        if (title) title.textContent = 'Gate locked';
        if (sub) sub.textContent = modState.lockedReason || 'Finish Culture to reach the gate.';
      } else if (state === 'glow') {
        if (title) title.textContent = 'The gate is glowing';
        if (sub) sub.textContent = 'You are Roda Ready. Your coach opens it at Batizado.';
      } else {
        if (title) title.textContent = 'The golden gate';
        if (sub) sub.textContent = 'It glows when you are Roda Ready. A coach opens it at Batizado.';
      }
    }

    const params = new URLSearchParams(location.search);
    if (params.get('locked') === '1') {
      toast(modState?.lockedReason || 'That lesson is locked.');
    }
  }
  document.addEventListener('astro:page-load', init);
  init();
</script>
---
// learn/[module]/[lesson].astro — one route, four lesson types (SPEC §5.2).
// Completion writes ledger events through actions.js. Locked modules bounce
// back to the hub with a toast.
import { ClientRouter } from 'astro:transitions';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../directions/quest/Nav.astro';
import Footer from '../../../directions/quest/Footer.astro';
import YouTube from '../../../components/YouTube.astro';
import Quiz from '../../../components/Quiz.astro';
import LessonFrame from '../../../components/quest/LessonFrame.astro';
import Reading from '../../../components/quest/Reading.astro';
import Check from '../../../components/quest/Check.astro';
import DrillTimer from '../../../components/quest/DrillTimer.astro';
import { LESSONS, moduleById } from '../../../content/index.js';
import { yt, video as wixVideo } from '../../../data/media.js';
import '../../../directions/quest/tokens.css';
import '../../../directions/quest/theme.css';

export function getStaticPaths() {
  return LESSONS.map((l) => ({ params: { module: l.moduleId, lesson: l.id }, props: { lesson: l } }));
}

const { lesson } = Astro.props;
const mod = moduleById(lesson.moduleId);
const siblings = LESSONS.filter((l) => l.moduleId === lesson.moduleId);
const index = siblings.findIndex((l) => l.id === lesson.id);
const nextLesson = siblings[index + 1] || null;
const TYPE_LABEL = { video: 'Watch', reading: 'Read', drill: 'Practice', quiz: 'Boss Quiz' };
const navActive = lesson.moduleId === 'graduation' ? 'batizado' : lesson.moduleId === 'culture' ? 'music' : lesson.moduleId;
const ytId = lesson.videoKey ? yt(lesson.videoKey) : '';
const fileVideo = !lesson.videoKey && lesson.wixVideoKey ? wixVideo(lesson.wixVideoKey) : null;
const nextHref = nextLesson ? `/learn/${mod.id}/${nextLesson.id}` : '/journey';
const nextLabel = nextLesson ? `Next: ${nextLesson.title}` : 'Back to the map';
---

<Base title={`${lesson.title} — Physical Chess`} direction="quest">
  <ClientRouter slot="head" />
  <div class="quest-page">
    <div class="quest-stagelight quest-stagelight--a" aria-hidden="true"></div>
    <div class="quest-stagelight quest-stagelight--b" aria-hidden="true"></div>
    <Nav active={navActive} />
    <main
      class="quest-screen quest-lesson"
      data-lesson={lesson.id}
      data-module={lesson.moduleId}
      data-type={lesson.type}
      data-next-href={nextHref}
      data-next-label={nextLabel}
    >
      <LessonFrame
        moduleId={mod.id}
        moduleTitle={mod.title}
        lessons={siblings}
        currentId={lesson.id}
        index={index}
      >
        <span class="quest-lesson__type">{TYPE_LABEL[lesson.type]}</span>
        <h1 class="quest-lesson__title">{lesson.title}</h1>
        <p class="quest-lesson__summary">{lesson.summary}</p>
        <p class="quest-already" data-already hidden>You already cleared this. Play again to raise stars.</p>

        {lesson.type === 'video' && (
          <div class="quest-watch" data-watch>
            {ytId && <YouTube id={ytId} title={lesson.title} class="quest-video-frame" />}
            {fileVideo && (
              <div class="quest-video-frame">
                <video src={fileVideo.mp4} poster={fileVideo.poster} controls playsinline preload="metadata" data-wix-video></video>
              </div>
            )}
            {!ytId && fileVideo && (
              <p class="quest-video-credit">Video: SoChlo Productions</p>
            )}
            <div class="quest-watch__row">
              <span class="quest-watch-ring" aria-hidden="true">
                <svg viewBox="0 0 44 44">
                  <circle cx="22" cy="22" r="18" class="quest-watch-ring__track" />
                  <circle cx="22" cy="22" r="18" class="quest-watch-ring__fill" data-watch-ring />
                </svg>
              </span>
              <button class="quest-btn quest-btn--lime" type="button" data-complete disabled aria-disabled="true">
                I watched it
              </button>
              <span class="quest-watch__hint" data-watch-label>Watch 60s</span>
            </div>
          </div>
        )}

        {lesson.type === 'reading' && (
          <div>
            <Reading body={lesson.body} photoKey={lesson.photoKey} glossary={Boolean(lesson.glossary)} />
            {lesson.check && (
              <Check prompt={lesson.check.prompt} choices={lesson.check.choices} correctIndex={lesson.check.correctIndex} />
            )}
            {!lesson.check && (
              <button class="quest-btn quest-btn--lime" type="button" data-complete data-payload="{}">I read it</button>
            )}
          </div>
        )}

        {lesson.type === 'drill' && lesson.drill && (
          <div data-drill>
            <DrillTimer
              steps={lesson.drill.steps}
              seconds={lesson.drill.seconds}
              metronomeBpm={lesson.drill.metronomeBpm}
            />
            <div class="quest-practice" data-practice hidden>
              <p class="quest-practice__copy">Ask a grown-up to confirm if they watched you train.</p>
              <button class="quest-btn quest-btn--ghost" type="button" data-practice-confirm>I watched</button>
              <p class="quest-practice__thanks" data-practice-thanks hidden>Thanks. Practice logged.</p>
            </div>
          </div>
        )}

        {lesson.type === 'quiz' && lesson.quiz && (
          <div class="quest-boss-wrap">
            <Quiz questions={lesson.quiz} class="quest-quiz" />
          </div>
        )}

        <div class="quest-done quest-cleared" data-finished hidden tabindex="-1">
          <p class="quest-cleared__kicker" data-cleared-kicker>Lesson cleared</p>
          <p class="quest-done__title" data-cleared-title>Lesson cleared</p>
          <div class="quest-cleared__stars" data-earned-stars aria-hidden="true"></div>
          <p class="quest-cleared__xp" data-earned></p>
          <p class="quest-cleared__patch" data-patch-note hidden></p>
          <div class="quest-btn-row">
            <a class="quest-btn" data-next-link href={nextHref}>{nextLabel}</a>
            <a class="quest-btn quest-btn--ghost" href={`/learn/${mod.id}`}>Back to {mod.title}</a>
          </div>
        </div>
      </LessonFrame>
    </main>
    <div class="quest-toast" data-toast role="status" aria-live="polite"></div>
    <Footer />
  </div>

  <script>
    import '../../../directions/quest/motion.js';
    import { requireSession } from '../../../lib/auth-guard.js';
    import { recordEvent } from '../../../lib/actions.js';
    import { store } from '../../../lib/store.js';
    import { EVENT, starsFor } from '../../../lib/game/events.js';
    import { paintLessonRail, toast } from '../../../lib/lesson-ui.js';

    const DONE_TYPE = {
      video: EVENT.VIDEO_DONE,
      reading: EVENT.READING_DONE,
      drill: EVENT.DRILL_DONE,
      quiz: EVENT.QUIZ_DONE,
    };

    function reduced() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function starSvgs(n) {
      return [1, 2, 3].map((i) => (
        `<svg class="quest-star${i <= n ? ' is-on' : ''}" data-star="${i}" width="36" height="36" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.5 7 .8-5.2 4.8 1.5 7L12 17.5 5.7 21l1.5-7L2 9.3l7-.8z" fill="${i <= n ? '#FFB238' : 'none'}" stroke="#FFB238" stroke-width="2"/></svg>`
      )).join('');
    }

    function fillStars(container, n) {
      if (!container) return;
      container.innerHTML = starSvgs(n);
      if (reduced()) {
        container.querySelectorAll('.quest-star').forEach((el) => el.classList.add('is-filled'));
        return;
      }
      container.querySelectorAll('.quest-star').forEach((el, i) => {
        setTimeout(() => el.classList.add('is-filled'), 180 * i);
      });
    }

    function listenYoutubeEnded(iframe, onEnded) {
      if (!iframe) return;
      try {
        const url = new URL(iframe.src);
        url.searchParams.set('enablejsapi', '1');
        url.searchParams.set('origin', location.origin);
        iframe.src = url.toString();
      } catch { return; }
      const onMsg = (ev) => {
        let data = ev.data;
        if (typeof data === 'string') {
          try { data = JSON.parse(data); } catch { return; }
        }
        if (!data || data.event !== 'onStateChange') return;
        if (data.info === 0 || data.info === '0') onEnded();
      };
      window.addEventListener('message', onMsg);
      const ping = () => {
        try {
          iframe.contentWindow?.postMessage(JSON.stringify({ event: 'listening', id: 1 }), '*');
        } catch { /* ignore */ }
      };
      iframe.addEventListener('load', ping);
      ping();
    }

    function armWatch(main, alreadyDone) {
      const btn = main.querySelector('[data-complete]');
      const ring = main.querySelector('[data-watch-ring]');
      const label = main.querySelector('[data-watch-label]');
      if (!btn) return;
      const circ = 2 * Math.PI * 18;
      const enable = () => {
        btn.disabled = false;
        btn.removeAttribute('aria-disabled');
        if (label) label.textContent = 'Ready';
        if (ring) {
          ring.style.strokeDasharray = String(circ);
          ring.style.strokeDashoffset = '0';
        }
      };
      if (alreadyDone) { enable(); return; }
      btn.disabled = true;
      const started = Date.now();
      const WAIT = 60;
      const tick = () => {
        const left = Math.max(0, WAIT - (Date.now() - started) / 1000);
        if (label) label.textContent = left > 0 ? `Watch ${Math.ceil(left)}s` : 'Ready';
        if (ring) {
          ring.style.strokeDasharray = String(circ);
          ring.style.strokeDashoffset = String(circ * (left / WAIT));
        }
        if (left <= 0) { clearInterval(id); enable(); }
      };
      const id = setInterval(tick, 250);
      tick();
      const iframe = main.querySelector('[data-yt-embed] iframe');
      listenYoutubeEnded(iframe, () => { clearInterval(id); enable(); });
      const file = main.querySelector('[data-wix-video]');
      file?.addEventListener('ended', () => { clearInterval(id); enable(); }, { once: true });
    }

    async function finish(main, payload, opts = {}) {
      const type = DONE_TYPE[main.dataset.type];
      const before = store.get().snapshot;
      const xpBefore = opts.xpBefore ?? before?.xp ?? 0;
      const patchesBefore = new Set((before?.patches || []).map((p) => p.key));
      const after = await recordEvent(type, {
        moduleId: main.dataset.module,
        lessonId: main.dataset.lesson,
        payload,
      });
      const earned = after.xp - xpBefore;
      const stars = starsFor(type, payload);
      const done = main.querySelector('[data-finished]');
      const kicker = done.querySelector('[data-cleared-kicker]');
      const title = done.querySelector('[data-cleared-title]');
      const moduleCleared = after.modules[main.dataset.module]?.cleared && !before?.modules[main.dataset.module]?.cleared;
      if (moduleCleared) {
        kicker.textContent = 'Module cleared';
        title.textContent = 'Module cleared';
        done.classList.add('quest-cleared--module');
      } else {
        kicker.textContent = 'Lesson cleared';
        title.textContent = 'Lesson cleared';
      }
      fillStars(done.querySelector('[data-earned-stars]'), stars);
      done.querySelector('[data-earned]').textContent = earned > 0 ? `+${earned} XP` : 'Stars only go up.';
      const newPatch = after.patches.find((p) => !patchesBefore.has(p.key));
      const patchNote = done.querySelector('[data-patch-note]');
      if (newPatch && patchNote) {
        patchNote.hidden = false;
        patchNote.textContent = `New patch: ${newPatch.title}.`;
        toast(`New patch: ${newPatch.title}.`);
      } else {
        toast(earned > 0 ? `+${earned} XP` : 'Nice. Stars only go up.');
      }
      const next = after.nextUp;
      const link = done.querySelector('[data-next-link]');
      if (link) {
        if (next && next.lessonId !== main.dataset.lesson) {
          link.href = `/learn/${next.moduleId}/${next.lessonId}`;
          const titleEl = document.querySelector(`[data-rail-lesson="${next.lessonId}"] .quest-rail__item-title`);
          link.textContent = titleEl ? `Next: ${titleEl.textContent}` : 'Next lesson';
        } else {
          link.href = '/journey';
          link.textContent = 'Back to the map';
        }
      }
      paintLessonRail(after, { currentId: main.dataset.lesson, moduleId: main.dataset.module });
      done.hidden = false;
      done.focus();
      done.scrollIntoView({ behavior: reduced() ? 'auto' : 'smooth', block: 'nearest' });
    }

    async function init() {
      const main = document.querySelector('[data-lesson]');
      if (!main || main.dataset.init === '1') return;
      main.dataset.init = '1';
      const s = await requireSession({ player: true });
      if (!s) return;

      const modState = s.snapshot.modules[main.dataset.module];
      if (modState?.locked) {
        location.replace(`/learn/${main.dataset.module}?locked=1`);
        return;
      }

      const lessonState = s.snapshot.lessons[main.dataset.lesson];
      const already = lessonState?.status === 'done';
      paintLessonRail(s.snapshot, { currentId: main.dataset.lesson, moduleId: main.dataset.module });
      document.querySelector('.quest-rail__item--current')?.scrollIntoView({ inline: 'center', block: 'nearest' });
      if (already) {
        const banner = main.querySelector('[data-already]');
        if (banner) banner.hidden = false;
      }

      if (main.dataset.type === 'video') armWatch(main, already);

      main.querySelectorAll('[data-complete]').forEach((btn) => {
        btn.addEventListener('click', () => {
          btn.disabled = true;
          finish(main, JSON.parse(btn.dataset.payload || '{}'));
        });
      });

      main.addEventListener('check:pass', (e) => {
        finish(main, { checkFirstTry: Boolean(e.detail?.firstTry) });
      });

      main.addEventListener('drill:rated', (e) => {
        finish(main, { selfRating: Number(e.detail?.selfRating) || 1 });
        const practice = main.querySelector('[data-practice]');
        if (practice) practice.hidden = false;
      });

      main.querySelector('[data-practice-confirm]')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        btn.disabled = true;
        await recordEvent(EVENT.PRACTICE_CONFIRMED, {
          moduleId: main.dataset.module,
          lessonId: main.dataset.lesson,
          payload: { by: 'guardian' },
        });
        const thanks = main.querySelector('[data-practice-thanks]');
        if (thanks) thanks.hidden = false;
        toast('Practice logged.');
      });

      const quiz = main.querySelector('[data-quiz]');
      if (quiz) {
        const pending = [];
        quiz.addEventListener('quiz:correct', (e) => {
          pending.push({ questionId: e.detail.id, correct: true });
        });
        quiz.addEventListener('quiz:wrong', (e) => {
          pending.push({ questionId: e.detail.id, correct: false });
        });
        quiz.addEventListener('quiz:restart', () => { pending.length = 0; });
        quiz.addEventListener('quiz:done', async (e) => {
          const xpBefore = store.get().snapshot?.xp || 0;
          for (const a of pending) {
            await recordEvent(EVENT.QUIZ_ANSWERED, {
              moduleId: main.dataset.module,
              lessonId: main.dataset.lesson,
              payload: a,
            });
          }
          pending.length = 0;
          await finish(main, { score: e.detail.score, total: e.detail.total }, { xpBefore });
        });
      }

      const stage = main.querySelector('[data-lesson-stage]');
      if (stage) stage.removeAttribute('inert');
    }
    document.addEventListener('astro:page-load', init);
    init();
  </script>
</Base>

