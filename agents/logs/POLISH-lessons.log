/* =====================================================================
   === foundation (WP0): nav session chip, cards, forms, player cards,
   === lesson frame skeleton. Later WPs append their own sections below.
   ===================================================================== */
.quest-nav__session { display: flex; align-items: center; gap: 10px; }
.quest-nav__chip { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px 6px 6px; border-radius: 999px; background: var(--quest-deep-leaf); border: 3px solid var(--quest-leaf-border); color: var(--quest-cream); font: 800 14px/1 var(--quest-font-label); letter-spacing: .04em; transition: transform .18s var(--quest-ease); }
.quest-nav__chip:hover { transform: translateY(-2px); }
.quest-nav__chip-avatar svg { display: block; border-radius: 50%; }
.quest-nav__coach { padding: 8px 14px; border-radius: 999px; background: var(--quest-mango); color: var(--quest-ink); font: 800 13px/1 var(--quest-font-label); letter-spacing: .08em; text-transform: uppercase; }
[hidden] { display: none !important; }

.quest-screen { max-width: 1100px; margin: 0 auto; padding: 24px 24px 80px; }
.quest-screen--narrow { max-width: 560px; }
.quest-screen__eyebrow { color: var(--quest-mango); font: 800 13px/1.2 var(--quest-font-label); letter-spacing: .12em; text-transform: uppercase; margin: 0 0 8px; }
.quest-screen__title { font-family: var(--quest-font-display); font-size: clamp(34px, 5vw, 48px); color: var(--quest-cream); margin: 0 0 8px; line-height: 1.05; }
.quest-screen__sub { color: var(--quest-muted); font-size: 17px; margin: 0 0 28px; max-width: 60ch; }

.quest-card { background: var(--quest-deep-leaf); border: 3px solid var(--quest-leaf-border); border-radius: var(--quest-radius-lg); padding: 24px; color: var(--quest-cream); }
.quest-card + .quest-card { margin-top: 18px; }
.quest-card__title { font-family: var(--quest-font-display); font-size: 26px; margin: 0 0 6px; }
.quest-card__body { color: var(--quest-muted); margin: 0; }
.quest-card--note { border-style: dashed; color: var(--quest-muted); font-size: 14px; }

.quest-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 26px; border-radius: 999px; background: var(--quest-mango); color: var(--quest-ink); font: 800 16px/1 var(--quest-font-label); letter-spacing: .04em; box-shadow: 0 6px 0 var(--quest-mango-shadow); transition: transform .15s var(--quest-ease), box-shadow .15s var(--quest-ease); cursor: pointer; border: 0; }
.quest-btn:hover { transform: translateY(-2px); }
.quest-btn:active { transform: translateY(4px); box-shadow: 0 2px 0 var(--quest-mango-shadow); }
.quest-btn--lime { background: var(--quest-lime); box-shadow: 0 6px 0 var(--quest-lime-shadow); }
.quest-btn--lime:active { box-shadow: 0 2px 0 var(--quest-lime-shadow); }
.quest-btn--ghost { background: transparent; color: var(--quest-cream); border: 3px solid var(--quest-leaf-border); box-shadow: none; }
.quest-btn--ghost:active { transform: none; }
.quest-btn[disabled] { opacity: .5; cursor: not-allowed; transform: none; }
.quest-btn-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }

.quest-field { display: grid; gap: 6px; margin-bottom: 16px; }
.quest-field__label { color: var(--quest-cream); font: 800 13px/1.2 var(--quest-font-label); letter-spacing: .08em; text-transform: uppercase; }
.quest-field__input { min-height: 52px; padding: 0 16px; border-radius: 12px; background: var(--quest-palm-shadow); border: 3px solid var(--quest-leaf-border); color: var(--quest-cream); font: 600 17px/1 var(--quest-font-body); }
.quest-field__input:focus-visible { outline: 3px solid var(--quest-lime); outline-offset: 2px; }
.quest-field__hint { color: var(--quest-muted); font-size: 13px; }
.quest-form__error { background: var(--quest-hibiscus); color: var(--quest-cream); padding: 12px 16px; border-radius: 12px; font-weight: 700; margin-bottom: 16px; }

.quest-players { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 18px; }
.quest-player-card { display: grid; justify-items: center; gap: 10px; padding: 24px 16px; background: var(--quest-deep-leaf); border: 3px solid var(--quest-leaf-border); border-radius: var(--quest-radius-lg); color: var(--quest-cream); text-align: center; cursor: pointer; transition: transform .18s var(--quest-ease), border-color .18s; }
.quest-player-card:hover, .quest-player-card:focus-visible { transform: translateY(-4px); border-color: var(--quest-lime); outline: none; }
.quest-player-card__avatar svg { display: block; filter: drop-shadow(0 6px 0 rgba(0,0,0,.35)); }
.quest-player-card__name { font-family: var(--quest-font-display); font-size: 24px; }
.quest-player-card__meta { color: var(--quest-muted); font: 800 12px/1.2 var(--quest-font-label); letter-spacing: .1em; text-transform: uppercase; }
.quest-player-card--add { border-style: dashed; color: var(--quest-muted); }

.quest-avatar-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; }
.quest-avatar-grid label { display: grid; place-items: center; padding: 8px; border-radius: 16px; border: 3px solid transparent; cursor: pointer; }
.quest-avatar-grid input { position: absolute; opacity: 0; }
.quest-avatar-grid input:checked + span, .quest-avatar-grid input:focus-visible + span { outline: 3px solid var(--quest-lime); outline-offset: 3px; border-radius: 50%; }
.quest-swatches { display: flex; gap: 10px; }
.quest-swatches label { width: 36px; height: 36px; border-radius: 50%; border: 3px solid var(--quest-leaf-border); cursor: pointer; position: relative; }
.quest-swatches input { position: absolute; opacity: 0; }
.quest-swatches input:checked + span { position: absolute; inset: -6px; border-radius: 50%; border: 3px solid var(--quest-lime); }

.quest-lesson { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 28px; }
.quest-lesson__stage { background: var(--quest-deep-leaf); border: 3px solid var(--quest-leaf-border); border-radius: var(--quest-radius-lg); padding: 28px; color: var(--quest-cream); }
.quest-lesson__type { display: inline-block; background: var(--quest-hibiscus); color: var(--quest-cream); font: 800 12px/1 var(--quest-font-label); letter-spacing: .12em; text-transform: uppercase; padding: 8px 14px; border-radius: 999px; margin-bottom: 16px; }
.quest-lesson__title { font-family: var(--quest-font-display); font-size: 34px; margin: 0 0 10px; }
.quest-lesson__summary { color: var(--quest-muted); font-size: 17px; margin: 0 0 22px; }
.quest-reading { max-width: 62ch; font-size: 18px; line-height: 1.65; }
.quest-reading p { margin: 0 0 16px; }
.quest-reading strong { color: var(--quest-mango); }
.quest-steps { list-style: none; padding: 0; margin: 0 0 20px; display: grid; gap: 10px; counter-reset: step; }
.quest-steps li { display: flex; gap: 14px; align-items: flex-start; background: var(--quest-palm-shadow); border-radius: 16px; padding: 14px 16px; }
.quest-steps li::before { counter-increment: step; content: counter(step); flex: 0 0 34px; height: 34px; border-radius: 50%; background: var(--quest-lime); color: var(--quest-ink); display: grid; place-items: center; font: 800 15px/1 var(--quest-font-label); }
.quest-timer { font-family: var(--quest-font-display); font-size: 64px; color: var(--quest-lime); text-align: center; margin: 12px 0; font-variant-numeric: tabular-nums; }
.quest-stars { display: inline-flex; gap: 4px; }
.quest-stars svg { width: 22px; height: 22px; }
.quest-done { margin-top: 22px; display: grid; gap: 12px; padding: 20px; background: var(--quest-palm-shadow); border-radius: 20px; }
.quest-done__title { font-family: var(--quest-font-display); font-size: 24px; color: var(--quest-lime); margin: 0; }
.quest-rating { display: flex; gap: 10px; }
.quest-rating button { flex: 1; min-height: 48px; border-radius: 12px; background: var(--quest-deep-leaf); border: 3px solid var(--quest-leaf-border); color: var(--quest-cream); font: 800 14px/1.2 var(--quest-font-label); }
.quest-rating button[aria-pressed="true"] { background: var(--quest-lime); color: var(--quest-ink); border-color: var(--quest-lime); }
.quest-toast { position: fixed; left: 50%; bottom: 28px; transform: translate(-50%, 20px); background: var(--quest-lime); color: var(--quest-ink); padding: 14px 22px; border-radius: 999px; font: 800 15px/1 var(--quest-font-label); box-shadow: 0 6px 0 var(--quest-lime-shadow); opacity: 0; transition: opacity .25s, transform .25s var(--quest-ease); z-index: 50; pointer-events: none; }
.quest-toast[data-show="true"] { opacity: 1; transform: translate(-50%, 0); }
.quest-table { width: 100%; border-collapse: collapse; color: var(--quest-cream); font-variant-numeric: tabular-nums; }
.quest-table th { text-align: left; font: 800 12px/1.2 var(--quest-font-label); letter-spacing: .1em; text-transform: uppercase; color: var(--quest-muted); padding: 10px 12px; border-bottom: 3px solid var(--quest-leaf-border); }
.quest-table td { padding: 12px; border-bottom: 1px solid var(--quest-leaf-border); }
.quest-demo-badge { position: fixed; right: 14px; bottom: 14px; background: var(--quest-hibiscus); color: var(--quest-cream); font: 800 11px/1 var(--quest-font-label); letter-spacing: .12em; text-transform: uppercase; padding: 8px 12px; border-radius: 999px; z-index: 40; }
@media (max-width: 860px) {
  .quest-lesson { grid-template-columns: 1fr; }
  .quest-screen { padding: 16px 16px 80px; }
  .quest-avatar-grid { grid-template-columns: repeat(3, 1fr); }
}

/* === WP2: lesson engine === */
.quest-lesson {
  max-width: 1280px;
  align-items: start;
}
.quest-lesson .quest-rail__item { text-decoration: none; color: inherit; }
.quest-rail__stars {
  display: inline-flex;
  gap: 2px;
  margin-left: 8px;
  vertical-align: middle;
}
.quest-mini-star { display: block; }
.quest-already {
  margin: 0 0 18px;
  padding: 12px 16px;
  border-radius: 14px;
  background: var(--quest-palm-shadow);
  border: 2px dashed var(--quest-leaf-border);
  color: var(--quest-muted);
  font-weight: 700;
  font-size: 15px;
}

.quest-watch__row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px;
  margin-top: 16px;
}
.quest-watch__hint {
  color: var(--quest-muted);
  font: 800 13px/1 var(--quest-font-label);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.quest-watch-ring {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
}
.quest-watch-ring svg { display: block; width: 44px; height: 44px; }
.quest-watch-ring__track {
  fill: none;
  stroke: var(--quest-leaf-border);
  stroke-width: 4;
}
.quest-watch-ring__fill {
  fill: none;
  stroke: var(--quest-lime);
  stroke-width: 4;
  stroke-linecap: round;
  transform: rotate(-90deg);
  transform-origin: 22px 22px;
  stroke-dasharray: 113.1;
  stroke-dashoffset: 113.1;
}

.quest-readaloud {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  padding: 0 14px;
  border: 3px solid var(--quest-leaf-border);
  border-radius: 999px;
  background: var(--quest-palm-shadow);
  color: var(--quest-cream);
  font: 800 13px/1 var(--quest-font-label);
  letter-spacing: 0.06em;
  cursor: pointer;
}
.quest-readaloud:hover,
.quest-readaloud:focus-visible {
  border-color: var(--quest-lime);
  outline: none;
}
.quest-readaloud[aria-pressed='true'] {
  background: var(--quest-lime);
  color: var(--quest-ink);
  border-color: var(--quest-ink);
}
.quest-readaloud--icon {
  width: 44px;
  height: 44px;
  padding: 0;
  justify-content: center;
}

.quest-reading-wrap { display: grid; gap: 16px; }
.quest-reading__toolbar { display: flex; justify-content: flex-end; }
.quest-reading__figure {
  margin: 0 0 4px;
  border-radius: 20px;
  overflow: hidden;
  border: 4px solid var(--quest-ink);
}
.quest-reading__figure img { width: 100%; height: auto; }
.quest-reading { max-width: 65ch; }
.quest-reading__sent.is-reading {
  background: color-mix(in srgb, var(--quest-lime) 28%, transparent);
  border-radius: 4px;
  box-decoration-break: clone;
}

.quest-glossary {
  margin-top: 28px;
  padding: 22px;
  background: var(--quest-palm-shadow);
  border-radius: 20px;
  border: 3px solid var(--quest-leaf-border);
}
.quest-glossary__title {
  font-family: var(--quest-font-display);
  font-size: 26px;
  color: var(--quest-cream);
  margin: 0 0 8px;
}
.quest-glossary__lead { color: var(--quest-muted); margin: 0 0 18px; font-size: 16px; }
.quest-glossary__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 14px;
}
.quest-glossary__item {
  display: grid;
  gap: 8px;
  padding: 14px 16px;
  border-radius: 16px;
  background: var(--quest-deep-leaf);
  border: 3px solid var(--quest-leaf-border);
}
.quest-glossary__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.quest-glossary__word { margin: 0; font-size: 22px; color: var(--quest-mango); }
.quest-glossary__meaning { margin: 0; color: var(--quest-muted); font-size: 15px; }
.quest-glossary__master { min-height: 44px; justify-self: start; }
.quest-glossary__status { margin: 0; color: var(--quest-lime); font-weight: 800; }

.quest-check {
  margin-top: 22px;
  padding: 20px;
  background: var(--quest-palm-shadow);
  border-radius: 20px;
}
.quest-check__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 10px;
}
.quest-check__eyebrow {
  margin: 0;
  color: var(--quest-mango);
  font: 800 12px/1 var(--quest-font-label);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.quest-check__prompt {
  margin: 0 0 14px;
  font-family: var(--quest-font-display);
  font-size: 24px;
  color: var(--quest-cream);
}
.quest-check__choices { flex-wrap: wrap; }
.quest-check--shake { animation: quest-check-shake 0.45s var(--quest-ease); }
.quest-check--pulse { animation: quest-check-pulse 0.7s var(--quest-ease); }
@keyframes quest-check-shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-6px); }
  40% { transform: translateX(6px); }
  60% { transform: translateX(-4px); }
  80% { transform: translateX(4px); }
}
@keyframes quest-check-pulse {
  0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--quest-lime) 0%, transparent); }
  40% { box-shadow: 0 0 0 10px color-mix(in srgb, var(--quest-lime) 45%, transparent); }
  100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--quest-lime) 0%, transparent); }
}

.quest-drill-clock {
  position: relative;
  width: min(220px, 100%);
  margin: 8px auto 12px;
  aspect-ratio: 1;
}
.quest-drill-ring {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.quest-drill-ring__track {
  fill: none;
  stroke: var(--quest-leaf-border);
  stroke-width: 8;
}
.quest-drill-ring__fill {
  fill: none;
  stroke: var(--quest-lime);
  stroke-width: 8;
  stroke-linecap: round;
  transform: rotate(-90deg);
  transform-origin: 60px 60px;
}
.quest-drill-clock .quest-timer {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  margin: 0;
  font-size: clamp(36px, 8vw, 52px);
}
.quest-steps li.is-current {
  border: 3px solid var(--quest-lime);
  transform: translateX(4px);
}
.quest-practice {
  margin-top: 18px;
  padding: 18px;
  border-radius: 16px;
  background: var(--quest-palm-shadow);
  border: 2px dashed var(--quest-leaf-border);
}
.quest-practice__copy { margin: 0 0 12px; color: var(--quest-cream); font-weight: 700; }
.quest-practice__thanks { margin: 12px 0 0; color: var(--quest-lime); font-weight: 800; }

.quiz__chrome {
  display: grid;
  gap: 14px;
  margin-bottom: 18px;
}
.quiz__photo {
  width: 100%;
  height: auto;
  border-radius: 16px;
  border: 4px solid var(--quest-ink);
  margin-bottom: 14px;
}
.quiz__retry {
  display: grid;
  gap: 14px;
  padding: 18px;
  border-radius: 16px;
  background: var(--quest-palm-shadow);
}
.quiz__retry-msg { margin: 0; color: var(--quest-cream); font-weight: 700; font-size: 17px; }

.quest-cleared {
  outline: none;
}
.quest-cleared__kicker {
  margin: 0;
  color: var(--quest-mango);
  font: 800 12px/1 var(--quest-font-label);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.quest-cleared__stars {
  display: flex;
  gap: 8px;
}
.quest-star {
  transform: scale(0.7);
  opacity: 0.35;
  transform-origin: center;
}
.quest-star.is-on.is-filled {
  opacity: 1;
  transform: scale(1);
  transition: transform 0.28s var(--quest-ease), opacity 0.28s var(--quest-ease);
}
.quest-cleared__xp {
  margin: 0;
  font-family: var(--quest-font-display);
  font-size: 22px;
  color: var(--quest-lime);
}
.quest-cleared__patch {
  margin: 0;
  color: var(--quest-mango);
  font-weight: 800;
}
.quest-cleared--module {
  border: 3px solid var(--quest-lime);
  box-shadow: 0 0 0 6px color-mix(in srgb, var(--quest-lime) 25%, transparent);
}

.quest-hub { position: relative; z-index: 1; }
.quest-hub-hero {
  display: flex;
  align-items: center;
  gap: 22px;
}
.quest-hub-ring-wrap {
  position: relative;
  width: 120px;
  height: 120px;
  flex-shrink: 0;
}
.quest-hub-ring { width: 120px; height: 120px; display: block; }
.quest-hub-ring__track {
  fill: none;
  stroke: var(--quest-leaf-border);
  stroke-width: 10;
}
.quest-hub-ring__fill {
  fill: none;
  stroke: var(--quest-lime);
  stroke-width: 10;
  stroke-linecap: round;
  transform: rotate(-90deg);
  transform-origin: 60px 60px;
  stroke-dasharray: 326.73;
  stroke-dashoffset: 326.73;
  transition: stroke-dashoffset 0.6s var(--quest-ease);
}
.quest-hub-ring__label {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  font-family: var(--quest-font-display);
  font-size: 22px;
  color: var(--quest-cream);
}
.quest-hub-hero__copy { min-width: 0; }
.quest-hub-stars {
  margin: 8px 0 0;
  color: var(--quest-mango);
  font: 800 13px/1 var(--quest-font-label);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.quest-hub-photo {
  margin: 0;
  border-radius: 20px;
  overflow: hidden;
  border: 4px solid var(--quest-ink);
}
.quest-hub-photo img { width: 100%; height: auto; }
.quest-hub-lock {
  margin: 8px 0 0;
  color: var(--quest-mango);
  font-weight: 800;
}
.quest-rail__group { display: grid; gap: 10px; }
.quest-rail__group-title {
  margin: 8px 0 0;
  color: var(--quest-muted);
  font: 800 11px/1 var(--quest-font-label);
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.quest-hub-gallery {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}
.quest-hub-gallery--animals { grid-template-columns: repeat(6, minmax(0, 1fr)); }
.quest-hub-tile {
  margin: 0;
  background: var(--quest-deep-leaf);
  border: 3px solid var(--quest-leaf-border);
  border-radius: 20px;
  overflow: hidden;
}
.quest-hub-tile img { width: 100%; height: 160px; object-fit: cover; }
.quest-hub-tile figcaption {
  padding: 10px 12px 14px;
  color: var(--quest-muted);
  font-size: 13px;
  font-weight: 700;
}
.quest-hub-gate {
  margin-top: 8px;
  padding: 28px 22px;
  border-radius: 24px;
  text-align: center;
  background: var(--quest-palm-shadow);
  border: 3px solid var(--quest-leaf-border);
  color: var(--quest-muted);
}
.quest-hub-gate__icon { color: var(--quest-muted); margin-bottom: 8px; }
.quest-hub-gate__title {
  margin: 0 0 6px;
  font-family: var(--quest-font-display);
  font-size: 26px;
  color: var(--quest-cream);
}
.quest-hub-gate__sub { margin: 0; font-weight: 700; }
.quest-hub-gate[data-state='locked'] { opacity: 0.7; }
.quest-hub-gate[data-state='glow'] {
  border-color: var(--quest-mango);
  color: var(--quest-cream);
  animation: quest-hub-gate-glow 1.8s ease-in-out infinite;
}
.quest-hub-gate[data-state='glow'] .quest-hub-gate__icon { color: var(--quest-mango); }
@keyframes quest-hub-gate-glow {
  0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--quest-mango) 0%, transparent); }
  50% { box-shadow: 0 0 0 10px color-mix(in srgb, var(--quest-mango) 35%, transparent); }
}

@media (max-width: 860px) {
  .quest-lesson .quest-rail {
    width: 100%;
  }
  .quest-lesson .quest-rail__list {
    display: flex;
    flex-direction: row;
    gap: 10px;
    overflow-x: auto;
    margin-inline: -16px;
    padding: 0 16px 12px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .quest-lesson .quest-rail__list::-webkit-scrollbar { display: none; }
  .quest-lesson .quest-rail__item {
    flex: 0 0 210px;
    min-height: 72px;
    scroll-snap-align: start;
  }
  .quest-lesson .quest-rail__item-meta { display: none; }
  .quest-hub .quest-rail {
    width: 100%;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    overflow-x: auto;
    margin-inline: -20px;
    padding: 0 20px 12px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .quest-hub .quest-rail::-webkit-scrollbar { display: none; }
  .quest-hub .quest-rail__back { display: inline-flex; flex: 0 0 auto; align-self: center; }
  .quest-hub .quest-rail__title,
  .quest-hub .quest-rail__eyebrow { display: none; }
  .quest-hub .quest-rail__group { display: contents; }
  .quest-hub .quest-rail__group-title {
    flex: 0 0 auto;
    align-self: center;
    margin: 0;
    padding: 8px 10px;
    max-width: 72px;
    font-size: 10px;
  }
  .quest-hub .quest-rail__list { display: contents; }
  .quest-hub .quest-rail__item {
    flex: 0 0 210px;
    min-height: 72px;
    scroll-snap-align: start;
  }
  .quest-hub-hero { flex-direction: column; align-items: flex-start; }
  .quest-hub-gallery,
  .quest-hub-gallery--animals { grid-template-columns: 1fr 1fr; }
  .quest-hub .quest-section { padding: 32px 16px; }
  .quest-check__choices { flex-direction: column; }
  .quest-rating { flex-direction: column; }
  .quest-glossary__master { width: 100%; }
}

@media (prefers-reduced-motion: reduce) {
  .quest-check--shake,
  .quest-check--pulse,
  .quest-hub-gate[data-state='glow'],
  .quest-star.is-on.is-filled,
  .quest-hub-ring__fill,
  .quest-steps li.is-current {
    animation: none;
    transition: none;
  }
  .quest-star { opacity: 1; transform: none; }
  .quest-steps li.is-current { transform: none; }
}


  .quest-berimbau__svg circle:nth-of-type(2) { transition: none; }
  .quest-desafio-ticket { transition: none; }
}

/* === WP7: qa === */
.quest-hud__ticket[data-done="true"] { background: var(--quest-lime); }
.quest-player-card:focus-visible {
  outline: 3px solid var(--quest-lime);
  outline-offset: 3px;
}
.yt-with-credit { width: 100%; }
.yt-with-credit .quest-video-credit { margin: 8px 0 0; }
/* Home "latest" is a full-width lite YouTube, not the map's 112px chip. */
.quest-section--latest .quest-latest {
  display: block;
  grid-template-columns: none;
  padding: 0;
  border: 0;
  background: transparent;
}
.quest-video-credit,
.quest-video-card__credit,
.quest-footer__note {
  color: var(--quest-cream);
}
  width: 120px;
  height: 120px;
  background: var(--quest-hibiscus);
  box-shadow: 0 10px 0 var(--quest-hibiscus-shadow);
}
.quest-node--current .quest-node__photo {
  filter: brightness(0.72) saturate(0.9);
}
.quest-node--current .quest-node__icon {
  position: relative;
  z-index: 1;
}
.quest-node--current .quest-node__label {
  background: var(--quest-cream);
  color: var(--quest-ink);
  font-weight: 900;
}
.quest-node__flag {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.quest-node__flag-text {
  padding: 8px 16px;
  border-radius: 14px;
  background: var(--quest-cream);
  color: var(--quest-ink);
  font-family: var(--quest-font-display);
  font-size: 15px;
  letter-spacing: 0.04em;
  rotate: -4deg;
}
.quest-node__flag-tail {
  margin-top: -2px;
}

.quest-gate {
  position: absolute;
  left: 0;
  top: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  width: 200px;
  --quest-anchor-y: -60px;
  transform: translate(-50%, var(--quest-anchor-y)) scale(var(--quest-pop-scale, 0.62));
  transform-origin: 50% 60px;
}
.quest-gate__shape {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120px;
  height: 120px;
  border-radius: 30px;
  border: var(--quest-border-thick) solid var(--quest-ink);
  background: var(--quest-mango);
  box-shadow: 0 10px 0 var(--quest-mango-shadow);
  rotate: 6deg;
}
.quest-gate__label {
  padding: 6px 14px;
  border-radius: 999px;
  background: var(--quest-mango);
  color: var(--quest-ink);
  font-family: var(--quest-font-display);
  font-size: 14px;
  letter-spacing: 0.04em;
}

/* ---------------------------------------------------------------------
   Movements — map node detail with level rail
   --------------------------------------------------------------------- */
.quest-detail {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 40px;
  padding: 24px 48px 80px;
  align-items: flex-start;
}

.quest-rail {
  width: 320px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.quest-rail__list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.quest-rail__back {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px 10px 12px;
  border-radius: 999px;
  background: var(--quest-deep-leaf);
  font-weight: 800;
  font-size: 15px;
  transition: transform 0.16s var(--quest-ease);
}
.quest-rail__back:hover {
  transform: translateX(-3px);
}
.quest-rail__title {
  font-size: 34px;
  color: var(--quest-cream);
  margin-top: 8px;
}
.quest-rail__eyebrow {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--quest-mango);
}

.quest-rail__item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 16px;
  border-radius: 20px;
  background: var(--quest-deep-leaf);
  text-align: left;
  cursor: pointer;
  border: 4px solid transparent;
  transition: transform 0.16s var(--quest-ease);
}
.quest-rail__item:hover {
  transform: translateX(4px);
}
.quest-rail__item-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: 999px;
  background: var(--quest-palm-shadow);
  color: var(--quest-muted);
  font-family: var(--quest-font-display);
  font-size: 18px;
}
.quest-rail__item-body {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.quest-rail__item-title {
  font-size: 16px;
  font-weight: 800;
  color: var(--quest-cream);
}
.quest-rail__item-meta {
  font-size: 13px;
  font-weight: 600;
  color: var(--quest-muted);
}
.quest-rail__item--done .quest-rail__item-icon {
  background: var(--quest-lime);
  color: var(--quest-ink);
  border: 4px solid var(--quest-ink);
}
.quest-rail__item--current {
  border-color: var(--quest-ink);
  background: var(--quest-hibiscus);
  box-shadow: 0 6px 0 var(--quest-hibiscus-shadow);
}
.quest-rail__item--current .quest-rail__item-icon {
  background: var(--quest-ink);
  color: var(--quest-mango);
}
.quest-rail__item--current .quest-rail__item-title,
.quest-rail__item--current .quest-rail__item-meta {
  color: var(--quest-ink);
}
.quest-rail__item--locked {
  opacity: 0.65;
  cursor: default;
}
.quest-rail__item--locked:hover {
  transform: none;
}

.quest-panel {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 26px;
  padding: 34px;
  border-radius: var(--quest-radius-lg);
  background: var(--quest-deep-leaf);
  border: var(--quest-border-thin) solid var(--quest-leaf-border);
}
.quest-panel__eyebrow {
  display: inline-flex;
  align-self: flex-start;
  padding: 8px 14px;
  border-radius: 12px;
  background: var(--quest-hibiscus);
  color: var(--quest-ink);
  font-family: var(--quest-font-display);
  font-size: 15px;
  letter-spacing: 0.04em;
  rotate: -2deg;
}
.quest-panel__title {
  font-size: 30px;
  color: var(--quest-cream);
}
.quest-panel__summary {
  font-size: 16px;
  font-weight: 600;
  color: var(--quest-muted);
  line-height: 1.6;
}

.quest-video-frame {
  border-radius: 20px;
  overflow: hidden;
  border: 4px solid var(--quest-ink);
}
.quest-video-frame video {
  width: 100%;
  display: block;
}
.quest-video-credit {
  font-size: 12px;
  font-weight: 700;
  color: var(--quest-muted-2);
  margin-top: 8px;
}

.quest-drill-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 20px 24px;
  border-radius: 20px;
  background: var(--quest-palm-shadow);
  border: 3px solid var(--quest-leaf-border);
}
.quest-drill-card__text {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.quest-drill-card__title {
  font-weight: 900;
  font-size: 17px;
  color: var(--quest-cream);
}
.quest-drill-card__meta {
  font-size: 13px;
  font-weight: 700;
  color: var(--quest-muted);
}

[data-quest-complete-btn].is-complete {
  animation: quest-complete-pop 0.55s var(--quest-ease);
}
@keyframes quest-complete-pop {
  0%, 100% { transform: scale(1); }
  45% { transform: scale(1.12); }
}

.quest-complete-btn[data-done='true'] {
  background: var(--quest-lime);
  box-shadow: 0 8px 0 var(--quest-lime-shadow);
  color: var(--quest-ink);
}
.quest-complete-btn[data-done='true'] .quest-complete-btn__label::after {
  content: ' \2713';
}

/* ---------------------------------------------------------------------
   Music — boss quiz
   --------------------------------------------------------------------- */
.quest-quiz-layout {
  display: grid;
  grid-template-columns: 320px 1fr 260px;
  gap: 40px;
  align-items: start;
  padding: 24px 48px 80px;
  position: relative;
  z-index: 1;
}

.quest-boss-panel {
  padding: 34px;
  border-radius: var(--quest-radius-lg);
  background: var(--quest-deep-leaf);
  border: var(--quest-border-thin) solid var(--quest-leaf-border);
  display: flex;
  flex-direction: column;
  gap: 26px;
}
.quest-boss-panel__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}
.quest-boss-panel__badge-row {
  display: flex;
  align-items: center;
  gap: 12px;
}
.quest-boss-panel__badge {
  padding: 8px 14px;
  border-radius: 12px;
  background: var(--quest-hibiscus);
  color: var(--quest-ink);
  font-family: var(--quest-font-display);
  font-size: 15px;
  letter-spacing: 0.05em;
  rotate: -3deg;
}
.quest-boss-panel__of {
  font-size: 15px;
  font-weight: 800;
  color: var(--quest-muted);
}

.quest-hearts {
  display: flex;
  gap: 6px;
}
.quest-hearts svg {
  flex-shrink: 0;
}
.quest-hearts .heart-lost path {
  fill: var(--quest-palm-shadow);
  stroke: var(--quest-leaf-border);
}
.quest-hearts .heart-shake {
  animation: quest-heart-shake 0.5s var(--quest-ease);
}
@keyframes quest-heart-shake {
  0%,
  100% {
    transform: translateX(0) rotate(0deg);
  }
  20% {
    transform: translateX(-4px) rotate(-8deg);
  }
  40% {
    transform: translateX(4px) rotate(8deg);
  }
  60% {
    transform: translateX(-3px) rotate(-5deg);
  }
  80% {
    transform: translateX(3px) rotate(5deg);
  }
}

.quest-quiz-progress {
  display: flex;
  gap: 8px;
}
.quest-quiz-progress__seg {
  flex: 1;
  height: 14px;
  border-radius: 7px;
  background: var(--quest-palm-shadow);
}
.quest-quiz-progress__seg[data-state='answered'] {
  background: var(--quest-mango);
}
.quest-quiz-progress__seg[data-state='current'] {
  background: var(--quest-lime);
}

/* Quiz.astro class hooks */
/* Safety net: several rules below set `display` on elements that Quiz.astro
   also toggles via the [hidden] attribute (quiz__next, quiz__done,
   quiz__question). An author-styled `display` always beats the UA default
   [hidden] rule on specificity, so re-assert it here first. */
.quest-quiz [hidden] {
  display: none !important;
}

.quest-quiz .quiz__title {
  display: none;
}
.quest-quiz .quiz__question {
  border: 0;
  margin: 0;
  padding: 0;
  min-width: 0;
}
.quest-quiz .quiz__prompt {
  font-family: var(--quest-font-display);
  font-size: clamp(26px, 3vw, 38px);
  line-height: 1.15;
  color: var(--quest-cream);
  padding: 0;
  margin: 0 0 4px;
  display: block;
}
.quest-quiz .quiz__choices {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-top: 22px;
}
.quest-quiz .quiz__choice {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 20px;
  border-radius: 20px;
  background: var(--quest-palm-shadow);
  border: 4px solid var(--quest-leaf-border);
  font-size: 20px;
  font-weight: 800;
  color: var(--quest-cream);
  text-align: left;
  transition: transform 0.14s var(--quest-ease);
}
.quest-quiz .quiz__choice::before {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: var(--quest-deep-leaf);
  font-family: var(--quest-font-display);
  font-size: 20px;
  color: var(--quest-cream);
}
.quest-quiz .quiz__choice:nth-of-type(1)::before {
  content: 'A';
}
.quest-quiz .quiz__choice:nth-of-type(2)::before {
  content: 'B';
}
.quest-quiz .quiz__choice:nth-of-type(3)::before {
  content: 'C';
}
.quest-quiz .quiz__choice:nth-of-type(4)::before {
  content: 'D';
}
.quest-quiz .quiz__choice[data-selected='true'][data-correct='true']::before {
  background: var(--quest-ink);
  color: var(--quest-lime);
}
.quest-quiz .quiz__choice[data-selected='true'][data-correct='false']::before {
  background: var(--quest-ink);
  color: var(--quest-hibiscus);
}
.quest-quiz .quiz__choice:not(:disabled):hover {
  transform: translateX(4px);
  border-color: var(--quest-mango);
}
.quest-quiz .quiz__choice[data-selected='true'][data-correct='true'] {
  background: var(--quest-lime);
  border-color: var(--quest-ink);
  color: var(--quest-ink);
  box-shadow: 0 8px 0 var(--quest-lime-shadow);
}
.quest-quiz .quiz__choice.quest-correct-bounce {
  animation: quest-correct-bounce 0.6s var(--quest-ease);
}
@keyframes quest-correct-bounce {
  0%, 100% { transform: scale(1); }
  45% { transform: scale(1.035) translateY(-4px); }
}
.quest-quiz .quiz__choice[data-selected='true'][data-correct='false'] {
  background: var(--quest-hibiscus);
  border-color: var(--quest-ink);
  color: var(--quest-ink);
}
.quest-quiz .quiz__choice[data-correct='true']:not([data-selected='true']) {
  border-color: var(--quest-lime);
}
.quest-quiz .quiz__feedback:empty {
  display: none;
}
.quest-quiz .quiz__feedback {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 16px 22px;
  margin-top: 20px;
  border-radius: 20px;
  background: var(--quest-mango);
  color: var(--quest-ink);
  font-weight: 900;
  font-size: 16px;
}
.quest-quiz[data-state='wrong'] .quiz__feedback {
  background: var(--quest-hibiscus);
}
.quest-quiz .quiz__next {
  margin-top: 16px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 22px;
  border-radius: 999px;
  background: var(--quest-ink);
  color: var(--quest-mango);
  font-weight: 900;
  font-size: 15px;
  transition: transform 0.16s var(--quest-ease);
}
.quest-quiz .quiz__next:hover {
  transform: translateX(3px);
}
.quest-quiz .quiz__done {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  padding: 40px 20px;
  text-align: center;
}
.quest-quiz .quiz__done-message {
  font-family: var(--quest-font-display);
  font-size: 32px;
  color: var(--quest-lime);
}

.quest-choice-letter {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: var(--quest-deep-leaf);
  font-family: var(--quest-font-display);
  font-size: 20px;
}
.quest-quiz .quiz__choice[data-selected='true'][data-correct='true'] .quest-choice-letter {
  background: var(--quest-ink);
  color: var(--quest-lime);
}

.quest-xp-chip {
  position: fixed;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;

