index 0000000000000000000000000000000000000000..04950628b36c42a8dac141c14a9b8a90a162d9ab
--- /dev/null
+++ b//tmp/polish-lessons-audit.mjs
@@ -0,0 +1,66 @@
+import { chromium } from '/Users/admin/pc-pol-lessons/node_modules/playwright/index.mjs';
+
+const base = 'http://127.0.0.1:4412';
+const routes = [
+  '/learn/movements',
+  '/learn/music',
+  '/learn/culture',
+  '/learn/graduation',
+  '/learn/movements/ginga-basics',
+  '/learn/music/meet-the-berimbau',
+  '/learn/movements/esquiva-cocorinha',
+  '/learn/music/music-quiz',
+];
+
+const browser = await chromium.launch();
+const context = await browser.newContext({
+  viewport: { width: 390, height: 844 },
+  reducedMotion: 'reduce',
+});
+const page = await context.newPage();
+const errors = [];
+page.on('pageerror', (error) => errors.push(`pageerror: ${error.message}`));
+page.on('console', (message) => {
+  if (message.type() === 'error' && !/compute-pressure/i.test(message.text())) errors.push(`console: ${message.text()}`);
+});
+
+await page.goto(`${base}/login?demo=1`);
+await page.waitForURL('**/who**');
+await page.locator('.quest-player-card:has-text("Gatinha")').click();
+await page.waitForURL('**/journey**');
+
+let failed = false;
+for (const route of routes) {
+  await page.goto(`${base}${route}`, { waitUntil: 'domcontentloaded' });
+  await page.waitForSelector('[data-hub], [data-lesson-stage]:not([inert])');
+  const audit = await page.evaluate(() => {
+    const smallTargets = [...document.querySelectorAll('main a[href], main button:not([disabled])')]
+      .filter((el) => {
+        const style = getComputedStyle(el);
+        const rect = el.getBoundingClientRect();
+        return style.display !== 'none' && style.visibility !== 'hidden' && rect.width > 0 && rect.height > 0 && (rect.width < 44 || rect.height < 44);
+      })
+      .map((el) => {
+        const rect = el.getBoundingClientRect();
+        return { text: el.textContent.trim().replace(/\s+/g, ' '), width: Math.round(rect.width), height: Math.round(rect.height) };
+      });
+    const unfinishedEntrances = [...document.querySelectorAll('[data-quest-enter]')]
+      .filter((el) => Number(getComputedStyle(el).opacity) < 1).length;
+    return {
+      scrollWidth: document.documentElement.scrollWidth,
+      viewport: document.documentElement.clientWidth,
+      mainTarget: Boolean(document.querySelector('#main')),
+      smallTargets,
+      unfinishedEntrances,
+    };
+  });
+  console.log(JSON.stringify({ route, ...audit }));
+  if (audit.scrollWidth > audit.viewport || !audit.mainTarget || audit.smallTargets.length || audit.unfinishedEntrances) failed = true;
+}
+
+await browser.close();
+if (errors.length) {
+  console.error(errors.join('\n'));
+  failed = true;
+}
+if (failed) process.exit(1);
diff --git a//tmp/polish-lessons-shot.mjs b//tmp/polish-lessons-shot.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..5c47514d22fa5ecc3824c754e12c2a99ad9dcd3a
--- /dev/null
+++ b//tmp/polish-lessons-shot.mjs
@@ -0,0 +1,51 @@
+import { chromium } from '/Users/admin/pc-pol-lessons/node_modules/playwright/index.mjs';
+import { mkdirSync } from 'node:fs';
+
+const base = 'http://127.0.0.1:4412';
+const output = process.argv[2] || '/tmp/polish-lessons-baseline';
+mkdirSync(output, { recursive: true });
+
+const routes = [
+  ['hub-movements', '/learn/movements'],
+  ['hub-music', '/learn/music'],
+  ['hub-culture', '/learn/culture'],
+  ['hub-graduation', '/learn/graduation'],
+  ['lesson-video', '/learn/movements/ginga-basics'],
+  ['lesson-reading', '/learn/music/meet-the-berimbau'],
+  ['lesson-drill', '/learn/movements/esquiva-cocorinha'],
+  ['lesson-quiz', '/learn/music/music-quiz'],
+];
+
+const browser = await chromium.launch();
+const context = await browser.newContext({ viewport: { width: 1440, height: 900 } });
+const page = await context.newPage();
+const errors = [];
+page.on('pageerror', (error) => errors.push(error.message));
+page.on('console', (message) => {
+  if (message.type() === 'error' && !/compute-pressure/i.test(message.text())) errors.push(message.text());
+});
+
+await page.goto(`${base}/login?demo=1`, { waitUntil: 'domcontentloaded' });
+await page.waitForURL('**/who**');
+await page.locator('.quest-player-card:has-text("Gatinha")').click();
+await page.waitForURL('**/journey**');
+
+for (const [width, height, label] of [[1440, 900, '1440'], [390, 844, '390']]) {
+  await page.setViewportSize({ width, height });
+  for (const [name, route] of routes) {
+    await page.goto(`${base}${route}`, { waitUntil: 'domcontentloaded' });
+    await page.waitForSelector('[data-hub], [data-lesson-stage]:not([inert])');
+    await page.waitForTimeout(900);
+    const metrics = await page.evaluate(() => ({
+      path: location.pathname,
+      viewport: document.documentElement.clientWidth,
+      scrollWidth: document.documentElement.scrollWidth,
+      bodyScrollWidth: document.body.scrollWidth,
+    }));
+    console.log(JSON.stringify({ name, label, ...metrics }));
+    await page.screenshot({ path: `${output}/${name}-${label}.png`, fullPage: true });
+  }
+}
+
+if (errors.length) console.log(JSON.stringify({ errors }, null, 2));
+await browser.close();
diff --git a/agents/reports/POLISH-lessons.md b/agents/reports/POLISH-lessons.md
new file mode 100644
index 0000000000000000000000000000000000000000..e167babbf690ae120820c2011bded84510deef4c
--- /dev/null
+++ b/agents/reports/POLISH-lessons.md
@@ -0,0 +1,9 @@
+- Polished all four `/learn/*` module hubs and the shared player for video, reading, drill, and quiz lessons.
+- Kept the mobile “Back to map” action visible above the horizontally scrolling lesson rail.
+- Restored full contrast to locked lesson rows and the Graduation gate without changing unlock behavior.
+- Tightened stage spacing, reading measure, media crops, check-card rhythm, and supporting card type at 390 and 1440.
+- Added clear Quest hover/press states while preserving the reduced-motion fallback and existing event flow.
+- Added a visible quiz question count, accessible rail/stage labels, and working `#main` skip-link targets.
+- Captured 16 final screenshots in `screenshots/polish/lessons/`; no new dependencies were added.
+- Verification passed: build, 20 unit tests, mobile target/overflow audit, and demo smoke (`SMOKE OK`) on port 4412.
+- Left for Camren: the existing curriculum-copy review and replacement teaching-video shot list remain unchanged.
