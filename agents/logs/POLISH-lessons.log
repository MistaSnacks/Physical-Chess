+  max-width: 34ch;
+  line-height: 1.2;
+}
+
+.quest-check [data-check-feedback] {
+  min-height: 24px;
+  margin-bottom: 0;
+}
+
+.quiz__chrome {
+  grid-template-columns: auto 1fr;
+  align-items: center;
+  column-gap: 16px;
+}
+
+.quiz__progress-label {
