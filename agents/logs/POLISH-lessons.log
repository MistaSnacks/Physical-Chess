+  }
+
+  .quest-hub .quest-rail__back {
+    display: none;
+  }
+
+  .quest-hub .quest-rail__group-title {
+    max-width: 92px;
+    font-size: 11px;
+    line-height: 1.25;
+  }
+
+  .quest-hub .quest-rail__item,
+  .quest-lesson .quest-rail__item {
+    flex-basis: 204px;
+  }
+
+  .quest-lesson__stage {
+    padding: 28px 24px;
+    border-radius: 28px;
+  }
+
+  .quest-lesson__summary {
+    font-size: 17px;
+    line-height: 1.55;
+  }
+
+  .quest-reading {
+    font-size: 17px;
+    line-height: 1.65;
+  }
+
+  .quest-reading__figure img {
+    aspect-ratio: 4 / 3;
+  }
+
+  .quest-check {
+    padding: 18px 16px;
+  }
+
+  .quest-check__top {
+    align-items: flex-start;
+  }
+
+  .quiz__progress-label {
+    font-size: 12px;
+  }
+
+  .quest-instrument-card__blurb,
+  .quest-word-card__meaning,
+  .quest-hub-tile figcaption {
+    font-size: 15px;
+  }
+}
+
+@media (max-width: 430px) {
+  .quest-hub .quest-detail {
+    padding-inline: 16px;
+  }
+
+  .quest-hub .quest-rail {
+    margin-inline: -16px;
+    padding-inline: 16px;
+  }
+
+  .quest-lesson__stage {
+    padding: 24px 20px;
+  }
+
+  .quest-lesson__title {
+    font-size: 34px;
+  }
+
