+}
+
+.quest-check__prompt {
+  max-width: 34ch;
+  line-height: 1.2;
+}
+
+.quest-check [data-check-feedback] {
+  min-height: 24px;
+  margin-bottom: 0;
+}
+
+.quiz__chrome {
