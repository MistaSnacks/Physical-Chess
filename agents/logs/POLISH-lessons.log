// LessonFrame.astro — rail + stage layout shared by every lesson type.
// Rail state (done / current / locked / stars) is painted from the snapshot
// by src/lib/lesson-ui.js after requireSession.
interface LessonRow {
  id: string;
  title: string;
  minutes: number;
  type: string;
}

interface Props {
  moduleId: string;
  moduleTitle: string;
  lessons: LessonRow[];
  currentId: string;
  index: number;
}

const { moduleId, moduleTitle, lessons, currentId, index } = Astro.props;
---

<aside class="quest-rail" data-quest-enter>
  <a class="quest-rail__back" href={`/learn/${moduleId}`}>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="#FFF6E5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {moduleTitle}
  </a>
  <p class="quest-rail__eyebrow">Lesson {index + 1} of {lessons.length}</p>
  <div class="quest-rail__list">
    {lessons.map((l, i) => (
      <a
        class:list={['quest-rail__item', l.id === currentId && 'quest-rail__item--current']}
        href={`/learn/${moduleId}/${l.id}`}
        data-rail-lesson={l.id}
        aria-current={l.id === currentId ? 'page' : undefined}
      >
        <span class="quest-rail__item-icon" data-rail-icon>{l.type === 'quiz' ? '?' : i + 1}</span>
        <span class="quest-rail__item-body">
          <span class="quest-rail__item-title">{l.title}</span>
          <span class="quest-rail__item-meta">
            {l.minutes} min · {l.type}
            <span class="quest-rail__stars" data-rail-stars></span>
          </span>
        </span>
      </a>
    ))}
  </div>
</aside>
<section class="quest-lesson__stage" data-quest-enter data-lesson-stage inert>
  <slot />
</section>
---
// DrillTimer.astro — big countdown, optional metronome (off by default),
// step list that highlights on a per-step cadence, pause/resume, then
// a 3-button self rating. Dispatches `drill:rated` with { selfRating }.
interface Step { text: string; photoKey?: string }

interface Props {
  steps: Step[];
  seconds: number;
  metronomeBpm?: number;
}

const { steps, seconds, metronomeBpm } = Astro.props;
const mm = Math.floor(seconds / 60);
const ss = String(seconds % 60).padStart(2, '0');
const circ = (2 * Math.PI * 54).toFixed(2);
---

<div
  class="quest-drill"
  data-drill-timer
  data-seconds={seconds}
  data-bpm={metronomeBpm || ''}
>
  <ol class="quest-steps">
    {steps.map((s) => (
      <li data-drill-step>{s.text}</li>
    ))}
  </ol>

  <div class="quest-drill-clock" aria-live="polite">
    <svg class="quest-drill-ring" viewBox="0 0 120 120" aria-hidden="true">
      <circle cx="60" cy="60" r="54" class="quest-drill-ring__track" />
      <circle cx="60" cy="60" r="54" class="quest-drill-ring__fill" data-drill-ring
        style={`stroke-dasharray:${circ};stroke-dashoffset:0`} />
    </svg>
    <div class="quest-timer" data-timer>{mm}:{ss}</div>
  </div>

  <div class="quest-btn-row">
    <button class="quest-btn quest-btn--lime" type="button" data-drill-toggle>Start the timer</button>
    {metronomeBpm ? (
      <button class="quest-btn quest-btn--ghost" type="button" data-drill-mute aria-pressed="false">
        Metronome off
      </button>
    ) : null}
  </div>

  <div class="quest-done" data-rating hidden>
    <p class="quest-done__title">Time. How did it feel?</p>
    <div class="quest-rating" role="group" aria-label="How the drill felt">
      <button type="button" data-rate="1">Still learning</button>
      <button type="button" data-rate="2">Getting it</button>
      <button type="button" data-rate="3">Nailed it</button>
    </div>
  </div>
</div>

<script>
  function reduced() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function format(left) {
    const s = Math.max(0, Math.ceil(left));
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  }

  function makeMetronome(bpm) {
    let ctx = null;
    let timer = null;
    let muted = true;
    const interval = 60000 / Math.max(40, Number(bpm) || 72);

    function click() {
      if (muted) return;
      if (!ctx) ctx = new AudioContext();
      if (ctx.state === 'suspended') ctx.resume();
      const t = ctx.currentTime;
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'square';
      osc.frequency.value = 880;
      g.gain.setValueAtTime(0.06, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.04);
      osc.connect(g);
      g.connect(ctx.destination);
      osc.start(t);
      osc.stop(t + 0.04);
    }
    return {
      get muted() { return muted; },
      setMuted(v) {
        muted = v;
        if (muted && timer) { clearInterval(timer); timer = null; }
      },
      start() {
        if (muted || timer) return;
        click();
        timer = setInterval(click, interval);
      },
      stop() {
        if (timer) { clearInterval(timer); timer = null; }
      },
    };
  }

  function initDrill(root) {
    if (root.dataset.drillInit === '1') return;
    root.dataset.drillInit = '1';

    const total = Number(root.dataset.seconds) || 0;
    const bpm = Number(root.dataset.bpm) || 0;
    const out = root.querySelector('[data-timer]');
    const ring = root.querySelector('[data-drill-ring]');
    const toggle = root.querySelector('[data-drill-toggle]');
    const muteBtn = root.querySelector('[data-drill-mute]');
    const rating = root.querySelector('[data-rating]');
    const steps = Array.from(root.querySelectorAll('[data-drill-step]'));
    const circ = 2 * Math.PI * 54;
    const metro = bpm ? makeMetronome(bpm) : null;

    let running = false;
    let finished = false;
    let left = total;
    let startedAt = 0;
    let pausedMs = 0;
    let tickId = 0;

    function elapsedSec() {
      if (!running) return pausedMs / 1000;
      return (pausedMs + (Date.now() - startedAt)) / 1000;
    }

    function paintSteps(elapsed) {
      if (!steps.length) return;
      const cadence = total / steps.length;
      const idx = Math.min(steps.length - 1, Math.floor(elapsed / cadence));
      steps.forEach((el, i) => el.classList.toggle('is-current', i === idx && running));
    }

    function paint() {
      if (out) out.textContent = format(left);
      if (ring) {
        const spent = (total - left) / total;
        ring.style.strokeDasharray = String(circ);
        ring.style.strokeDashoffset = String(circ * spent);
      }
      paintSteps(total - left);
    }

    function end() {
      running = false;
      finished = true;
      left = 0;
      if (tickId) clearInterval(tickId);
      tickId = 0;
      paint();
      steps.forEach((el) => el.classList.remove('is-current'));
      steps[steps.length - 1]?.classList.add('is-current');
      metro?.stop();
      if (toggle) { toggle.disabled = true; toggle.textContent = 'Time'; }
      if (rating) {
        rating.hidden = false;
        const first = rating.querySelector('[data-rate]');
        first?.focus();
      }
    }

    function tick() {
      if (!running) return;
      left = total - elapsedSec();
      if (left <= 0) { end(); return; }
      paint();
    }

    toggle?.addEventListener('click', () => {
      if (finished) return;
      if (!running) {
        running = true;
        startedAt = Date.now();
        toggle.textContent = 'Pause';
        metro?.start();
        tick();
        tickId = setInterval(tick, 100);
      } else {
        running = false;
        pausedMs += Date.now() - startedAt;
        if (tickId) clearInterval(tickId);
        tickId = 0;
        metro?.stop();
        toggle.textContent = 'Resume';
        steps.forEach((el) => el.classList.remove('is-current'));
      }
    });

    muteBtn?.addEventListener('click', () => {
      if (!metro) return;
      const next = !metro.muted;
      metro.setMuted(next);
      muteBtn.setAttribute('aria-pressed', next ? 'false' : 'true');
      muteBtn.textContent = next ? 'Metronome off' : 'Metronome on';
      if (!next && running) metro.start();
      if (next) metro.stop();
    });

    root.querySelectorAll('[data-rate]').forEach((b) => {
      b.addEventListener('click', () => {
        if (root.dataset.rated === 'true') return;
        root.dataset.rated = 'true';
        root.querySelectorAll('[data-rate]').forEach((x) => {
          x.disabled = true;
          x.setAttribute('aria-pressed', x === b ? 'true' : 'false');
        });
        root.dispatchEvent(new CustomEvent('drill:rated', {
          detail: { selfRating: Number(b.dataset.rate) },
          bubbles: true,
        }));
      });
    });

    paint();
    if (reduced() && ring) ring.style.transition = 'none';
  }

  function init() {
    document.querySelectorAll('[data-drill-timer]').forEach(initDrill);
  }
  document.addEventListener('astro:page-load', init);
  init();
</script>
---
// Reading.astro — chapter typesetting for reading lessons. Optional photo,
// sentence spans for read-aloud highlight, and the 12-word glossary when
// `glossary` is set on the lesson.
import ReadAloud from './ReadAloud.astro';
import { GLOSSARY } from '../../content/glossary.js';
import { PHOTOS, wix } from '../../data/media.js';

interface Props {
  body?: string;
  photoKey?: string;
  glossary?: boolean;
}

const { body = '', photoKey, glossary = false } = Astro.props;

function mdSentences(s = '') {
  return s.split(/\n\s*\n/).map((block) => {
    const html = block.trim().replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    const parts = html.split(/(?<=[.!?])\s+/).filter((p) => p.trim());
    const inner = (parts.length ? parts : [html])
      .map((sent) => `<span class="quest-reading__sent" data-sent>${sent}</span>`)
      .join(' ');
    return `<p>${inner}</p>`;
  }).join('');
}

const photo = photoKey && PHOTOS[photoKey] ? { src: wix(photoKey, 1200, 640), caption: PHOTOS[photoKey].caption } : null;
---

<div class="quest-reading-wrap" data-readaloud-root data-reading>
  {photo && (
    <figure class="quest-reading__figure">
      <img src={photo.src} alt={photo.caption} loading="lazy" width="1200" height="640" />
    </figure>
  )}
  <div class="quest-reading__toolbar">
    <ReadAloud selector="[data-reading-body]" label="Listen to this" />
  </div>
  <div class="quest-reading" data-reading-body set:html={mdSentences(body)} />

  {glossary && (
    <section class="quest-glossary" data-glossary aria-labelledby="quest-glossary-title">
      <h2 class="quest-glossary__title" id="quest-glossary-title">Twelve words for the roda</h2>
      <p class="quest-glossary__lead">Tap the speaker to hear Portuguese. Then tap “I can say it” if you can say it back.</p>
      <ul class="quest-glossary__list">
        {GLOSSARY.map((g) => (
          <li class="quest-glossary__item" data-glossary-word={g.word}>
            <div class="quest-glossary__head">
              <p class="quest-glossary__word"><strong>{g.word}</strong></p>
              <button
                type="button"
                class="quest-readaloud quest-readaloud--icon"
                data-glossary-speak
                data-say={g.say}
                aria-label={`Hear ${g.word}`}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M3 10v4h3.2L12 19V5L6.2 10H3z" fill="currentColor"/>
                  <path d="M16.2 8.2a5 5 0 0 1 0 7.6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                </svg>
              </button>
            </div>
            <p class="quest-glossary__meaning">{g.meaning}</p>
            <button type="button" class="quest-btn quest-btn--ghost quest-glossary__master" data-glossary-master disabled>
              I can say it
            </button>
            <p class="quest-glossary__status" data-glossary-status hidden>You can say this one.</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</div>

<script>
  import { speak, bindStopOnNavigate } from '../../lib/speech.js';
  import { recordEvent } from '../../lib/actions.js';
  import { store } from '../../lib/store.js';
  import { EVENT } from '../../lib/game/events.js';

  bindStopOnNavigate();

  function masteredWords() {
    const words = new Set();
    for (const e of store.get().events || []) {
      if (e.type === EVENT.GLOSSARY_MASTERED && e.payload?.word) words.add(e.payload.word);
    }
    return words;
  }

  function paintMastered(root) {
    const have = masteredWords();
    root.querySelectorAll('[data-glossary-word]').forEach((item) => {
      const word = item.dataset.glossaryWord;
      if (!have.has(word)) return;
      const btn = item.querySelector('[data-glossary-master]');
      const status = item.querySelector('[data-glossary-status]');
      if (btn) { btn.hidden = true; btn.disabled = true; }
      if (status) status.hidden = false;
      item.dataset.mastered = 'true';
    });
  }

  function initGlossary(root) {
    if (!root || root.dataset.glossaryInit === '1') return;
    root.dataset.glossaryInit = '1';
    paintMastered(root);

    root.querySelectorAll('[data-glossary-speak]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = btn.closest('[data-glossary-word]');
        const say = btn.dataset.say || item?.dataset.glossaryWord || '';
        speak(say, { lang: 'pt-BR', rate: 0.85 });
        const master = item?.querySelector('[data-glossary-master]');
        if (master && item?.dataset.mastered !== 'true') master.disabled = false;
      });
    });

    root.querySelectorAll('[data-glossary-master]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (btn.disabled || !store.get().player) return;
        const item = btn.closest('[data-glossary-word]');
        const word = item?.dataset.glossaryWord;
        if (!word) return;
        btn.disabled = true;
        await recordEvent(EVENT.GLOSSARY_MASTERED, { payload: { word } });
        paintMastered(root);
      });
    });
  }

  function init() {
    document.querySelectorAll('[data-glossary]').forEach(initGlossary);
  }
  document.addEventListener('astro:page-load', init);
  init();
</script>
---
// Check.astro — one question at the end of a reading. Wrong answers shake;
// a right answer pulses lime. Dispatches `check:pass` with { firstTry }.
import ReadAloud from './ReadAloud.astro';

interface Props {
  prompt: string;
  choices: string[];
  correctIndex: number;
}

const { prompt, choices, correctIndex } = Astro.props;
---

<div class="quest-check" data-check data-readaloud-root>
  <div class="quest-check__top">
    <p class="quest-check__eyebrow">Check</p>
    <ReadAloud selector="[data-check-prompt]" label="Listen to the question" />
  </div>
  <p class="quest-check__prompt" data-check-prompt><span data-sent>{prompt}</span></p>
  <div class="quest-rating quest-check__choices" data-check-choices role="group" aria-label="Answer choices">
    {choices.map((c, i) => (
      <button type="button" data-check-choice={i} data-correct={i === correctIndex}>{c}</button>
    ))}
  </div>
  <p class="quest-field__hint" data-check-feedback aria-live="polite"></p>
</div>

<script>
  function reduced() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function initCheck(root) {
    if (root.dataset.checkInit === '1') return;
    root.dataset.checkInit = '1';
    let tries = 0;
    const feedback = root.querySelector('[data-check-feedback]');
    const choices = Array.from(root.querySelectorAll('[data-check-choice]'));

    choices.forEach((b) => {
      b.addEventListener('click', () => {
        if (root.dataset.solved === 'true') return;
        tries += 1;
        const ok = b.dataset.correct === 'true';
        b.setAttribute('aria-pressed', ok ? 'true' : 'false');
        if (!ok) {
          if (feedback) feedback.textContent = 'Not that one. Try again.';
          if (!reduced()) {
            root.classList.remove('quest-check--shake');
            void root.offsetWidth;
            root.classList.add('quest-check--shake');
          }
          return;
        }
        if (feedback) feedback.textContent = 'Boa. That is it.';
        root.dataset.solved = 'true';
        choices.forEach((x) => { x.disabled = true; });
        b.setAttribute('aria-pressed', 'true');
        if (!reduced()) {
          root.classList.add('quest-check--pulse');
        }
        root.dispatchEvent(new CustomEvent('check:pass', {
          detail: { firstTry: tries === 1 },
          bubbles: true,
        }));
      });
    });
  }

  function init() {
    document.querySelectorAll('[data-check]').forEach(initCheck);
  }
  document.addEventListener('astro:page-load', init);
  init();
</script>
---
// Quiz.astro — unstyled quiz markup + logic. One question shown at a time.
//
// Dispatches CustomEvents on the root `[data-quiz]` element (bubbles: true):
//   'quiz:correct' — detail: { id, index }
//   'quiz:wrong'   — detail: { id, index }
//   'quiz:done'    — detail: { score, total }   (finished with hearts left)
//   'quiz:restart' — detail: {}                 (0 hearts; try again, no XP)
//
// State is exposed via data attributes so each direction's theme.css /
// motion.js can react without owning the logic:
//   [data-quiz]                     data-state="active|correct|wrong|done|retry"
//                                    data-index, data-total, data-score, data-hearts
//   [data-quiz-question]            one per question; only the current one
//                                    is visible (others get [hidden])
//   [data-quiz-choice]               data-selected="true" once picked
//                                    data-correct="true|false" after answering
//   [data-quiz-next]                 advances to the next question / finish
//
// Class hooks: .quiz, .quiz__question, .quiz__prompt, .quiz__photo,
// .quiz__choices, .quiz__choice, .quiz__feedback, .quiz__next, .quiz__done,
// .quiz__hearts, .quiz__progress.
//
// Props:
//   questions — [{ id, prompt, choices: string[], correctIndex, photoKey? }]
//   title     — optional heading
import { PHOTOS, wix } from '../data/media.js';

interface QuizQuestion {
  id: string;
  prompt: string;
  choices: string[];
  correctIndex: number;
  photoKey?: string;
}

interface Props {
  questions: QuizQuestion[];
  title?: string;
  class?: string;
}

const { questions, title, class: className } = Astro.props;
const HEARTS = 3;

function photoFor(key?: string) {
  if (!key || !PHOTOS[key]) return null;
  return { src: wix(key, 960, 540), caption: PHOTOS[key].caption };
}
---

<div
  class:list={['quiz', className]}
  data-quiz
  data-state="active"
  data-index="0"
  data-total={questions.length}
  data-score="0"
  data-hearts={HEARTS}
>
  {title && <h3 class="quiz__title">{title}</h3>}

  <div class="quiz__chrome">
    <div class="quest-hearts quiz__hearts" data-quiz-hearts aria-label={`${HEARTS} hearts`}>
      {Array.from({ length: HEARTS }).map(() => (
        <svg data-quiz-heart width="30" height="30" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 21s-8-5.3-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 5.7-8 11-8 11z" fill="#FF4F7A" stroke="#0B2E24" stroke-width="2"/>
        </svg>
      ))}
    </div>
    <div class="quest-quiz-progress quiz__progress" aria-hidden="true">
      {questions.map((_, i) => (
        <span class="quest-quiz-progress__seg" data-quiz-progress-seg data-state={i === 0 ? 'current' : 'upcoming'} />
      ))}
    </div>
  </div>

  {
    questions.map((q, qIndex) => {
      const photo = photoFor(q.photoKey);
      return (
        <fieldset
          class="quiz__question"
          data-quiz-question
          data-question-id={q.id}
          data-question-index={qIndex}
          hidden={qIndex !== 0}
        >
          {photo && (
            <img class="quiz__photo" src={photo.src} alt={photo.caption} loading="lazy" width="960" height="540" />
          )}
          <legend class="quiz__prompt">{q.prompt}</legend>
          <div class="quiz__choices" role="radiogroup">
            {q.choices.map((choice, cIndex) => (
              <button
                type="button"
                class="quiz__choice"
                data-quiz-choice
                data-choice-index={cIndex}
                data-is-correct={cIndex === q.correctIndex}
                role="radio"
                aria-checked="false"
              >
                {choice}
              </button>
            ))}
          </div>
          <p class="quiz__feedback" data-quiz-feedback aria-live="polite"></p>
          <button type="button" class="quiz__next" data-quiz-next hidden>
            {qIndex === questions.length - 1 ? 'Finish' : 'Next question'}
          </button>
        </fieldset>
      );
    })
  }

  <div class="quiz__retry" data-quiz-retry hidden>
    <p class="quiz__retry-msg">Those hearts are gone. Try the quiz again. This try will not add XP.</p>
    <button type="button" class="quiz__next" data-quiz-retry-btn>Try again</button>
  </div>

  <div class="quiz__done" data-quiz-done hidden>
    <p class="quiz__done-message" data-quiz-score></p>
  </div>
</div>

<script>
  const HEARTS = 3;

  function reduced() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function initQuiz(root) {
    if (root.dataset.quizInit === 'true') return;
    root.dataset.quizInit = 'true';

    const questionEls = Array.from(root.querySelectorAll('[data-quiz-question]'));
    const doneEl = root.querySelector('[data-quiz-done]');
    const scoreEl = root.querySelector('[data-quiz-score]');
    const retryEl = root.querySelector('[data-quiz-retry]');
    const heartEls = Array.from(root.querySelectorAll('[data-quiz-heart]'));
    const segs = Array.from(root.querySelectorAll('[data-quiz-progress-seg]'));
    const total = questionEls.length;
    let score = 0;
    let hearts = HEARTS;

    function paintHearts() {
      heartEls.forEach((h, i) => {
        const lost = i >= hearts;
        h.classList.toggle('heart-lost', lost);
      });
      const wrap = root.querySelector('[data-quiz-hearts]');
      if (wrap) wrap.setAttribute('aria-label', `${hearts} ${hearts === 1 ? 'heart' : 'hearts'} left`);
      root.dataset.hearts = String(hearts);
    }

    function paintSegs(index, state) {
      segs.forEach((seg, i) => {
        if (i < index) seg.setAttribute('data-state', 'answered');
        else if (i === index) seg.setAttribute('data-state', state || 'current');
        else seg.setAttribute('data-state', 'upcoming');
      });
    }

    function showQuestion(index) {
      questionEls.forEach((el, i) => { el.hidden = i !== index; });
      root.dataset.index = String(index);
      root.dataset.state = 'active';
      paintSegs(index, 'current');
      const first = questionEls[index]?.querySelector('[data-quiz-choice]');
      first?.focus();
    }

    function resetQuestion(questionEl) {
      const choices = Array.from(questionEl.querySelectorAll('[data-quiz-choice]'));
      choices.forEach((c) => {
        c.disabled = false;
        c.removeAttribute('data-selected');
        c.removeAttribute('data-correct');
        c.setAttribute('aria-checked', 'false');
      });
      const feedbackEl = questionEl.querySelector('[data-quiz-feedback]');
      if (feedbackEl) feedbackEl.textContent = '';
      const nextEl = questionEl.querySelector('[data-quiz-next]');
      if (nextEl) nextEl.hidden = true;
      questionEl.dataset.answered = 'false';
    }

    function finish() {
      questionEls.forEach((el) => (el.hidden = true));
      if (retryEl) retryEl.hidden = true;
      if (doneEl) doneEl.hidden = false;
      if (scoreEl) scoreEl.textContent = `${score} / ${total} correct`;
      root.dataset.state = 'done';
      paintSegs(total, 'answered');
      root.dispatchEvent(
        new CustomEvent('quiz:done', { detail: { score, total }, bubbles: true })
      );
    }

    function restart() {
      score = 0;
      hearts = HEARTS;
      root.dataset.score = '0';
      questionEls.forEach(resetQuestion);
      if (doneEl) doneEl.hidden = true;
      if (retryEl) retryEl.hidden = true;
      paintHearts();
      showQuestion(0);
      root.dispatchEvent(new CustomEvent('quiz:restart', { detail: {}, bubbles: true }));
    }

    function loseHeart() {
      hearts = Math.max(0, hearts - 1);
      const lost = heartEls[hearts];
      if (lost && !reduced()) {
        lost.classList.add('heart-shake');
        setTimeout(() => lost.classList.remove('heart-shake'), 550);
      }
      paintHearts();
      return hearts;
    }

    questionEls.forEach((questionEl, qIndex) => {
      const id = questionEl.getAttribute('data-question-id') || '';
      const choices = Array.from(questionEl.querySelectorAll('[data-quiz-choice]'));
      const feedbackEl = questionEl.querySelector('[data-quiz-feedback]');
      const nextEl = questionEl.querySelector('[data-quiz-next]');

      choices.forEach((choiceEl) => {
        choiceEl.addEventListener('click', () => {
          if (questionEl.dataset.answered === 'true') return;
          questionEl.dataset.answered = 'true';

          const isCorrect = choiceEl.getAttribute('data-is-correct') === 'true';
          choices.forEach((c) => {
            c.setAttribute('aria-checked', c === choiceEl ? 'true' : 'false');
            c.dataset.selected = c === choiceEl ? 'true' : 'false';
            c.dataset.correct = c.getAttribute('data-is-correct') === 'true' ? 'true' : 'false';
            c.disabled = true;
          });

          if (isCorrect) {
            score += 1;
            root.dataset.score = String(score);
            root.dataset.state = 'correct';
            if (feedbackEl) feedbackEl.textContent = 'Boa.';
            paintSegs(qIndex, 'answered');
            root.dispatchEvent(
              new CustomEvent('quiz:correct', { detail: { id, index: qIndex }, bubbles: true })
            );
            if (nextEl) nextEl.hidden = false;
          } else {
            root.dataset.state = 'wrong';
            if (feedbackEl) feedbackEl.textContent = 'Not that one.';
            const left = loseHeart();
            paintSegs(qIndex, 'answered');
            root.dispatchEvent(
              new CustomEvent('quiz:wrong', { detail: { id, index: qIndex }, bubbles: true })
            );
            if (left <= 0) {
              if (nextEl) nextEl.hidden = true;
              if (retryEl) retryEl.hidden = false;
              root.dataset.state = 'retry';
              retryEl?.querySelector('[data-quiz-retry-btn]')?.focus();
            } else if (nextEl) {
              nextEl.hidden = false;
            }
          }
        });
      });

      if (nextEl) {
        nextEl.addEventListener('click', () => {
          const isLast = qIndex === total - 1;
          if (isLast) finish();
          else showQuestion(qIndex + 1);
        });
      }
    });

    root.querySelector('[data-quiz-retry-btn]')?.addEventListener('click', restart);

    paintHearts();
    showQuestion(0);
  }

  function init() {
    document.querySelectorAll('[data-quiz]').forEach((root) => initQuiz(root));
  }

  document.addEventListener('astro:page-load', init);
  init();
</script>

