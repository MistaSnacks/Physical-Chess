+
+/* === POLISH: journey === */
+.quest-map-header__title strong {
+  color: inherit;
+  font-weight: inherit;
+}
+.quest-map-header__sub {
+  max-width: 62ch;
+  line-height: 1.55;
+}
+.quest-map-header__sub strong {
+  color: var(--quest-cream);
+  font-weight: 800;
+}
+.quest-map-body {
+  gap: 48px;
+}
+.quest-hud {
+  gap: 20px;
+  padding: 24px;
+}
+.quest-hud__id {
+  min-width: 0;
+}
+.quest-hud__avatar {
+  transition: transform 0.18s var(--quest-ease), box-shadow 0.18s var(--quest-ease);
+}
+.quest-hud__avatar:hover,
+.quest-hud__avatar:focus-visible {
+  transform: translateY(-3px);
+  box-shadow: 0 6px 0 var(--quest-hibiscus-shadow);
+}
+.quest-hud__xp-row {
+  gap: 12px;
+}
+.quest-hud__xp-value {
+  flex: 0 0 auto;
+  font-size: 18px;
+  white-space: nowrap;
+}
+.quest-hud__stat {
+  min-height: 96px;
+  justify-content: center;
+}
+.quest-hud__ticket {
+  transition: transform 0.18s var(--quest-ease), box-shadow 0.18s var(--quest-ease), background 0.18s ease;
+}
+.quest-hud__ticket:hover,
+.quest-hud__ticket:focus-visible {
+  transform: translateY(-3px);
+  box-shadow: 0 6px 0 var(--quest-mango-shadow);
+}
+.quest-hud__ticket:active {
+  transform: translateY(1px);
+  box-shadow: 0 2px 0 var(--quest-mango-shadow);
+}
+.quest-hud__batizado strong {
+  font-weight: 900;
+}
+.quest-map-left .quest-latest {
+  display: grid;
+  grid-template-columns: 1fr;
+  gap: 12px;
+  padding: 16px;
+}
+.quest-map-left .quest-latest__copy {
+  gap: 4px;
+}
+.quest-map-left .quest-latest__eyebrow {
+  font-size: 10px;
+  line-height: 1.3;
+}
+.quest-map-left .quest-latest__title {
+  font-size: 21px;
+}
+.quest-map-left .quest-latest .yt-with-credit {
+  min-width: 0;
+  width: 100%;
+}
+.quest-map-left .quest-latest .yt-embed {
+  border-width: 3px;
+  border-radius: 14px;
+}
+.quest-map-left .quest-latest .quest-video-credit {
+  color: var(--quest-cream);
+  font-size: 11px;
+  line-height: 1.35;
+}
+.quest-node__flag,
+.quest-map-mobile__flag,
+.quest-gate--glow .quest-gate__shape,
+.quest-gate--glow .quest-map-mobile__gate-shape {
+  animation: none;
+}
+.quest-node:focus-visible,
+.quest-map-mobile__node:focus-visible {
+  outline: none;
+}
+.quest-node:focus-visible .quest-node__circle,
+.quest-map-mobile__node:focus-visible .quest-map-mobile__circle {
+  outline: 4px solid var(--quest-cream);
+  outline-offset: 5px;
+  transform: translateY(-3px);
+}
+.quest-map-mobile__node {
+  min-height: 104px;
+}
+.quest-levelup,
+.quest-patch-unlock {
+  transition: opacity 0.28s var(--quest-ease), transform 0.28s var(--quest-ease);
+}
+.quest-levelup__panel:focus-visible {
+  outline-color: var(--quest-cream);
+}
+
+@media (max-width: 900px) {
+  .quest-map-header {
+    padding-bottom: 20px;
+  }
+  .quest-map-header__sub {
+    font-size: 16px;
+  }
+  .quest-map-body {
+    gap: 0;
+  }
+  .quest-map-left {
+    gap: 20px;
+  }
+  .quest-hud {
+    padding: 20px;
+    border-radius: 24px;
+  }
+  .quest-hud__stat {
+    min-height: 0;
+  }
+  .quest-map-mobile {
+    order: 3;
+  }
+  .quest-nextup {
+    order: 2;
+  }
+  .quest-map-left .quest-latest {
+    order: 4;
+  }
+}
+
+@media (max-width: 600px) {
+  .quest-hud__avatar {
+    width: 72px;
+    height: 72px;
+  }
+  .quest-hud__stats {
+    gap: 8px;
+  }
+  .quest-hud__stat {
+    padding: 12px 6px;
+  }
+  .quest-hud__row {
+    grid-template-columns: 96px minmax(0, 1fr);
+  }
+  .quest-hud__ticket {
+    min-height: 88px;
+  }
+  .quest-map-left .quest-latest {
+    padding: 14px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .quest-node--current[data-quest-node='true'] .quest-node__halo,
+  .quest-map-mobile__node--current .quest-map-mobile__halo,
+  .quest-gate--glow .quest-gate__shape,
+  .quest-gate--glow .quest-map-mobile__gate-shape,
+  .quest-node__flag,
+  .quest-map-mobile__flag,
+  .quest-levelup,
+  .quest-patch-unlock,
+  .quest-star-burst__star,
+  .quest-hud__avatar,
+  .quest-hud__ticket,
+  .quest-hud__xp-fill,
+  .quest-ring__fill,
+  [data-quest-enter],
+  [data-quest-node] {
+    animation: none;
+    transition: none;
+  }
+  .quest-hud__avatar:hover,
+  .quest-hud__avatar:focus-visible,
+  .quest-hud__ticket:hover,
+  .quest-hud__ticket:focus-visible,
+  .quest-node:focus-visible .quest-node__circle,
+  .quest-map-mobile__node:focus-visible .quest-map-mobile__circle {
+    transform: none;
+  }
+}
 /* Home "latest" is a full-width lite YouTube, not the map's 112px chip. */
 .quest-section--latest .quest-latest {
   display: block;
