}
.quest-map-body {
  gap: 48px;
}
.quest-hud {
  gap: 20px;
  padding: 24px;
}
.quest-hud__id {
  min-width: 0;
}
.quest-hud__avatar {
  transition: transform 0.18s var(--quest-ease), box-shadow 0.18s var(--quest-ease);
}
.quest-hud__avatar:hover,
.quest-hud__avatar:focus-visible {
  transform: translateY(-3px);
  box-shadow: 0 6px 0 var(--quest-hibiscus-shadow);
}
