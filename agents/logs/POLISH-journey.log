.quest-footer__brand {
  font-family: var(--quest-font-display);
  font-size: 20px;
  color: var(--quest-cream);
}
.quest-footer__contact {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 14px;
  font-weight: 700;
  color: var(--quest-muted);
}
.quest-footer__contact a:hover {
  color: var(--quest-cream);
}
.quest-footer__note {
  font-size: 12px;
  color: var(--quest-muted-2);
}

/* ---------------------------------------------------------------------
   Dashboard = the map
   --------------------------------------------------------------------- */
.quest-map-wrap {
  position: relative;
  flex: 1;
  padding: 0 48px 32px;
}

.quest-map-header {
  position: relative;
  z-index: 2;
  max-width: 640px;
  margin-left: 392px;
  padding: 8px 0 24px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.quest-map-header__eyebrow {
  font-weight: 800;
  font-size: 14px;
  letter-spacing: 0.14em;
  color: var(--quest-mango);
}
.quest-map-header__title {
  font-size: clamp(32px, 4.5vw, var(--quest-text-display-lg));
  color: var(--quest-cream);
}
.quest-map-header__sub {
  font-size: 17px;
  font-weight: 600;
  color: var(--quest-muted);
}

.quest-map-body {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  gap: 56px;
}

.quest-map-left {
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 340px;
  flex-shrink: 0;
}

/* HUD */
.quest-hud {
  position: relative;
  z-index: 2;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 22px;
  padding: 28px;
  background: var(--quest-deep-leaf);
  border: var(--quest-border-thin) solid var(--quest-leaf-border);
  border-radius: 32px;
}

.quest-hud__top {
  display: flex;
  align-items: center;
  gap: 16px;
}
.quest-hud__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 80px;
  height: 80px;
  border-radius: 999px;
  background: var(--quest-mango);
  border: 5px solid var(--quest-hibiscus);
  overflow: hidden;
}
.quest-hud__avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.quest-hud__id {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.quest-hud__name {
  font-family: var(--quest-font-display);
  font-size: 34px;
  line-height: 1;
  color: var(--quest-cream);
}
.quest-hud__corda {
  display: flex;
  align-items: center;
  gap: 8px;
}
.quest-hud__corda-swatch {
  width: 32px;
  height: 10px;
  border-radius: 5px;
  flex-shrink: 0;
}
.quest-hud__corda-label {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: var(--quest-mango);
}

.quest-hud__xp {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.quest-hud__xp-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.quest-hud__xp-caption {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: var(--quest-cream);
}
.quest-hud__xp-value {
  font-family: var(--quest-font-display);
  font-size: 19px;
  color: var(--quest-mango);
}
.quest-hud__xp-track {
  height: 20px;
  padding: 4px;
  border-radius: 11px;
  background: var(--quest-palm-shadow);
}
.quest-hud__xp-fill {
  height: 100%;
  width: 100%;
  border-radius: 7px;
  background: var(--quest-mango);
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 0.8s var(--quest-ease);
}
.quest-hud__xp-fill[data-ready='true'] {
  transform: scaleX(var(--quest-xp-scale, 0));
}

.quest-hud__stats {
  display: flex;
  gap: 10px;
}
.quest-hud__stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 13px 8px;
  border-radius: 18px;
  background: var(--quest-palm-shadow);
}
.quest-hud__stat-value {
  font-family: var(--quest-font-display);
  font-size: 28px;
  color: var(--quest-lime);
}
.quest-hud__stat--pink .quest-hud__stat-value {
  color: var(--quest-hibiscus);
}
.quest-hud__stat--mango .quest-hud__stat-value {
  color: var(--quest-mango);
}
.quest-hud__stat-label {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: var(--quest-cream);
}

.quest-hud__batizado {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  border-radius: 18px;
  background: var(--quest-hibiscus);
  color: var(--quest-palm-shadow);
  font-size: 14px;
  font-weight: 700;
  line-height: 1.4;
}
.quest-hud__batizado svg {
  flex-shrink: 0;
}

.quest-nextup {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 16px;
  width: 100%;
  padding: 16px 26px 16px 20px;
  border-radius: 999px;
  background: var(--quest-mango);
  color: var(--quest-palm-shadow);
  border: 4px solid var(--quest-ink);
  box-shadow: 0 8px 0 var(--quest-mango-shadow);
  transition: transform 0.18s var(--quest-ease);
}
.quest-nextup:hover {
  transform: translateY(-3px);
  box-shadow: 0 11px 0 var(--quest-mango-shadow);
}
.quest-nextup:active {
  transform: translateY(1px);
  box-shadow: 0 5px 0 var(--quest-mango-shadow);
}
.quest-nextup__play {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border-radius: 999px;
  background: var(--quest-ink);
}
.quest-nextup__text {
  display: flex;
  flex-direction: column;
}
.quest-nextup__eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: #5a3600;
}
.quest-nextup__title {
  font-family: var(--quest-font-display);
  font-size: 22px;
  line-height: 1.1;
}

.quest-latest {
  display: grid;
  grid-template-columns: 112px 1fr;
  align-items: center;
  gap: 10px 14px;
  padding: 12px;
  border: 3px solid var(--quest-leaf-border);
  border-radius: 20px;
  background: var(--quest-deep-leaf);
}
.quest-latest .yt-embed {
  grid-row: 1 / 3;
  border-radius: 12px;
  overflow: hidden;
  border: 3px solid var(--quest-ink);
}
.quest-latest__copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.quest-latest__eyebrow {
  color: var(--quest-mango);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.1em;
}
.quest-latest__title {
  color: var(--quest-cream);
  font-family: var(--quest-font-display);
  font-size: 17px;
  line-height: 1.05;
}
.quest-latest__credit {
  color: var(--quest-muted-2);
  font-size: 9px;
  font-weight: 800;
}

/* Trail */
.quest-trail-area {
  position: relative;
  z-index: 1;
  width: 960px;
  height: 720px;
  flex: 1;
  min-width: 0;
  margin-top: -142px;
  margin-right: -48px;
}
.quest-trail-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
}
.quest-trail-path {
  fill: none;
  stroke: var(--quest-lime);
  stroke-width: 14;
  stroke-linecap: round;
  vector-effect: non-scaling-stroke;
}
.quest-trail-path--dashed {
  stroke: var(--quest-cream);
  stroke-width: 10;
  stroke-dasharray: 4 26;
  opacity: 0.55;
}
.quest-trail-path--glow {
  stroke-width: 30;
  opacity: 0.16;
}
.quest-trail-path--cleared {
  stroke: var(--quest-lime);
  stroke-width: 14;
}
.quest-trail-guide {
  fill: none;
  stroke: transparent;
}
.quest-lesson-dots {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
}
.quest-lesson-dot {
  position: absolute;
  left: 0;
  top: 0;
  width: 28px;
  height: 28px;
  border: 4px solid var(--quest-ink);
  border-radius: var(--quest-radius-pill);
  background: var(--quest-cream);
  transform: translate(-50%, -50%) scale(0);
  transition: transform 0.45s var(--quest-ease);
}
.quest-lesson-dot[data-ready='true'] {
  transform: translate(-50%, -50%) scale(1);
}
.quest-lesson-dot--done {
  background: var(--quest-lime);
}
.quest-lesson-dot--open {
  background: var(--quest-cream);
}
.quest-lesson-dot--locked {
  border-color: rgba(255, 246, 229, 0.45);
  background: var(--quest-palm-shadow);
  opacity: 0.9;
}

.quest-node {
  position: absolute;
  left: 0;
  top: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  width: 150px;
  text-align: center;
  --quest-anchor-y: -48px;
  transform: translate(-50%, var(--quest-anchor-y)) scale(var(--quest-pop-scale, 0.62));
  transform-origin: 50% 48px;
}
.quest-node__circle {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96px;
  height: 96px;
  border-radius: 999px;
  border: var(--quest-border-thick) solid var(--quest-ink);
  overflow: hidden;
  flex-shrink: 0;
  transition: transform 0.18s var(--quest-ease);
}
.quest-node a.quest-node__circle:hover {
  transform: scale(1.06);
}
.quest-node a.quest-node__circle:active {
  transform: scale(0.98);
}
.quest-node__photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.quest-node__label {
  padding: 6px 14px;
  border-radius: 999px;
  font-size: 14px;
  font-weight: 800;
}

.quest-node--done .quest-node__circle {
  background: var(--quest-lime);
  box-shadow: 0 8px 0 var(--quest-lime-shadow);
}
.quest-node--done .quest-node__photo {
  filter: brightness(0.45) saturate(0.7);
}
.quest-node--done .quest-node__check {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.quest-node--done .quest-node__label {
  background: var(--quest-ink);
  color: var(--quest-lime);
}

.quest-node--locked .quest-node__circle {
  background: var(--quest-deep-leaf);
  border-color: var(--quest-leaf-border);
}
.quest-node--locked .quest-node__label {
  background: var(--quest-deep-leaf);
  color: var(--quest-muted-2);
}
.quest-node--locked {
  opacity: 0.9;
}

.quest-node--open .quest-node__circle {
  background: var(--quest-deep-leaf);
  border-color: var(--quest-lime);
}
.quest-node--open .quest-node__photo {
  filter: brightness(0.55) saturate(0.8);
}
.quest-node--open .quest-node__label {
  background: var(--quest-deep-leaf);
  color: var(--quest-lime);
}
.quest-node__badge {
  position: absolute;
  bottom: -4px;
  right: -4px;
  padding: 2px 8px;
  border-radius: 999px;
  background: var(--quest-lime);
  color: var(--quest-ink);
  font-size: 11px;
  font-weight: 900;
  border: 2px solid var(--quest-ink);
}

.quest-node--current {
  width: 240px;
  z-index: 3;
  --quest-anchor-y: -121px;
  transform-origin: 50% 121px;
}
.quest-node--current .quest-node__halo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150px;
  height: 150px;
  border: 4px dashed var(--quest-hibiscus);
  border-radius: 999px;
  flex-shrink: 0;
}
.quest-node--current .quest-node__circle {
  width: 120px;
  height: 120px;
  background: var(--quest-hibiscus);
  box-shadow: 0 10px 0 var(--quest-hibiscus-shadow);
}
.quest-node--current .quest-node__photo {
  filter: brightness(0.72) saturate(0.9);
}
.quest-node--current .quest-node__icon {
  position: relative;
  z-index: 1;
}
.quest-node--current .quest-node__label {
  background: var(--quest-cream);
  color: var(--quest-ink);
  font-weight: 900;
}
.quest-node__flag {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.quest-node__flag-text {
  padding: 8px 16px;
  border-radius: 14px;
  background: var(--quest-cream);
  color: var(--quest-ink);
  font-family: var(--quest-font-display);
  font-size: 15px;
  letter-spacing: 0.04em;
  rotate: -4deg;
}
.quest-node__flag-tail {
  margin-top: -2px;
}

.quest-gate {
  position: absolute;
  left: 0;
  top: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  width: 200px;
  --quest-anchor-y: -60px;
  transform: translate(-50%, var(--quest-anchor-y)) scale(var(--quest-pop-scale, 0.62));
  transform-origin: 50% 60px;
}
.quest-gate__shape {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120px;
  height: 120px;
  border-radius: 30px;
  border: var(--quest-border-thick) solid var(--quest-ink);
  background: var(--quest-mango);
  box-shadow: 0 10px 0 var(--quest-mango-shadow);
  rotate: 6deg;
}
.quest-gate__label {
  padding: 6px 14px;
  border-radius: 999px;
  background: var(--quest-mango);
  color: var(--quest-ink);
  font-family: var(--quest-font-display);
  font-size: 14px;
  letter-spacing: 0.04em;
}

/* ---------------------------------------------------------------------
   Movements — map node detail with level rail
   --------------------------------------------------------------------- */
.quest-detail {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 40px;
  padding: 24px 48px 80px;
  align-items: flex-start;
}

.quest-rail {
  width: 320px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.quest-rail__list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.quest-rail__back {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px 10px 12px;
}
.quest-word-card__number {
  position: absolute;
  right: 14px;
  top: 10px;
  color: var(--quest-leaf-border);
  font-family: var(--quest-font-display);
  font-size: 28px;
}
.quest-word-card__word {
  font-family: var(--quest-font-display);
  font-size: 20px;
  color: var(--quest-lime);
}
.quest-word-card__meaning {
  font-size: 13px;
  font-weight: 600;
  color: var(--quest-muted);
  margin-top: 4px;
  line-height: 1.5;
}

/* ---------------------------------------------------------------------
   Entrance animation hooks (motion.js toggles [data-enter="true"])
   --------------------------------------------------------------------- */
[data-quest-enter] {
  opacity: 0;
  transform: translateY(18px);
}
[data-quest-enter='true'] {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.5s var(--quest-ease), transform 0.5s var(--quest-ease);
}

[data-quest-node] {
  opacity: 0;
  --quest-pop-scale: 0.62;
}
[data-quest-node='true'] {
  opacity: 1;
  --quest-pop-scale: 1;
  transition: opacity 0.4s var(--quest-ease), transform 0.4s var(--quest-ease);
}

.quest-node--current[data-quest-node='true'] .quest-node__halo {
  animation: quest-halo-pulse 2.4s ease-in-out infinite;
}
@keyframes quest-halo-pulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.08);
  }
}
.quest-node__flag {
  animation: quest-flag-bob 2.2s ease-in-out 0.75s infinite both;
}
@keyframes quest-flag-bob {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-6px);
  }
}

/* ---------------------------------------------------------------------
   Responsive
   --------------------------------------------------------------------- */
@media (max-width: 900px) {
  /* Safety net: flex items default to min-width:auto, which lets an
     unbreakable word/token force its flex row (and therefore the page)
     wider than the viewport. Reset it broadly for this narrow layout. */
  .quest-page * {
    min-width: 0;
  }

  .quest-nav {
    padding: 18px 20px;
  }
  .quest-nav__links {
    order: 3;
    width: 100%;
    justify-content: flex-start;
    overflow-x: auto;
  }
  .quest-hero {
    padding: 24px 20px 56px;
    min-height: 520px;
  }
  .quest-section {
    padding: 44px 20px;
  }
  .quest-screens {
    grid-template-columns: 1fr 1fr;
  }
  .quest-footer {
    padding: 32px 20px 40px;
  }

  .quest-map-wrap {
    padding: 0 20px 56px;
  }
  .quest-map-header {
    margin-left: 0;
    padding-top: 0;
  }
  .quest-map-body {
    flex-direction: column;
  }
  .quest-map-left {
    width: 100%;
    min-width: 0;
  }
  .quest-hud {
    min-width: 0;
  }
  .quest-hud__top,
  .quest-hud__xp-row {
    min-width: 0;
  }
  .quest-hud__name {
    font-size: 28px;
  }
  .quest-hud__stats {
    flex-direction: column;
    gap: 8px;
  }
  .quest-hud__stat {
    flex-direction: row;
    justify-content: space-between;
    padding: 10px 16px;
  }
  .quest-nextup {
    flex-wrap: wrap;
    min-width: 0;
  }
  .quest-nextup__text {
    min-width: 0;
  }
  .quest-trail-area {
    display: none;
  }
  .quest-map-mobile {
    display: block !important;
  }

  .quest-detail {
    flex-direction: column;
    padding: 16px 20px 56px;
    gap: 24px;
  }
  .quest-rail {
    width: 100%;
  }

  .quest-quiz-layout {
    grid-template-columns: 1fr;
    padding: 16px 20px 56px;
  }
  .quest-mascot {
    position: static;
    margin-top: 8px;
  }

  .quest-batizado-hero {
    padding: 16px 20px 0;
  }
  .quest-countdown.countdown {
    flex-wrap: wrap;
    justify-content: center;
  }
  .quest-gate-reveal {
    padding: 0 20px 32px;
  }
  .quest-gate-panel {
    padding: 40px 20px;
  }
  .quest-moments {
    grid-template-columns: 1fr;
  }
  .quest-cordas-track {
    flex-direction: column;
  }
  .quest-gallery.gallery {
    grid-template-columns: repeat(2, 1fr);
  }
  .quest-videos {
    grid-template-columns: 1fr;
  }
  .quest-instruments {
    grid-template-columns: repeat(2, 1fr);
  }
  .quest-words {
    grid-template-columns: 1fr;
  }
}

.quest-map-mobile {
  display: none;
  position: relative;
  z-index: 1;
  width: 100%;
  height: 1080px;
  overflow: hidden;
}
.quest-map-mobile__svg,
.quest-map-mobile__dots {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.quest-map-mobile__dots {
  z-index: 2;
  pointer-events: none;
}
.quest-map-mobile__node {
  position: absolute;
  left: 0;
  top: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7px;
  width: 118px;
  color: var(--quest-cream);
  text-align: center;
  z-index: 4;
  --quest-anchor-y: -36px;
  transform: translate(-50%, var(--quest-anchor-y)) scale(var(--quest-pop-scale, 0.62));
  transform-origin: 50% 36px;
}
.quest-map-mobile__halo {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82px;
  height: 82px;
  border: 3px solid transparent;
  border-radius: 999px;
  flex-shrink: 0;
}
.quest-map-mobile__circle {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72px;
  height: 72px;
  border-radius: 999px;
  border: 5px solid var(--quest-ink);
  overflow: hidden;
  flex-shrink: 0;
  z-index: 1;
  background: var(--quest-deep-leaf);
}
.quest-map-mobile__photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.quest-map-mobile__node--done .quest-map-mobile__circle {
  background: var(--quest-lime);
}
.quest-map-mobile__node--done .quest-map-mobile__photo {
  filter: brightness(0.45) saturate(0.7);
}
.quest-map-mobile__check {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.quest-map-mobile__node--current .quest-map-mobile__halo {
  border-color: var(--quest-hibiscus);
  border-style: dashed;
  animation: quest-halo-pulse 2.4s ease-in-out infinite;
}
.quest-map-mobile__node--current .quest-map-mobile__circle {
  border-color: var(--quest-ink);
  box-shadow: 0 6px 0 var(--quest-hibiscus-shadow);
}
.quest-map-mobile__node--locked .quest-map-mobile__circle {
  background: var(--quest-deep-leaf);
  border-color: var(--quest-leaf-border);
}
.quest-map-mobile__node--open .quest-map-mobile__circle {
  border-color: var(--quest-lime);
  box-shadow: 0 5px 0 var(--quest-lime-shadow);
}
.quest-map-mobile__copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 5px 10px;
  border-radius: 14px;
  background: var(--quest-palm-shadow);
}
.quest-map-mobile__label {
  font-size: 15px;
  font-weight: 800;
  color: var(--quest-cream);
}
.quest-map-mobile__tag {
  color: var(--quest-mango);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.06em;
}
.quest-map-mobile__flag {
  position: absolute;
  left: 50%;
  bottom: calc(100% + 3px);
  padding: 5px 9px;
  border-radius: 10px;
  background: var(--quest-cream);
  color: var(--quest-ink);
  font-family: var(--quest-font-display);
  font-size: 11px;
  letter-spacing: 0.04em;
  white-space: nowrap;
  animation: quest-flag-bob 2.2s ease-in-out 0.75s infinite both;
}
.quest-map-mobile__gate {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7px;
  width: 128px;
  --quest-anchor-y: -44px;
  transform: translate(-50%, var(--quest-anchor-y)) scale(var(--quest-pop-scale, 0.62));
  transform-origin: 50% 44px;
}
.quest-map-mobile__gate-shape {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88px;
  height: 88px;
  border: 5px solid var(--quest-ink);
  border-radius: 24px;
  background: var(--quest-mango);
  box-shadow: 0 7px 0 var(--quest-mango-shadow);
  rotate: 6deg;
}
.quest-map-mobile__gate-label {
  padding: 5px 10px;
  border-radius: 999px;
  background: var(--quest-mango);
  color: var(--quest-ink);
  font-family: var(--quest-font-display);
  font-size: 11px;
  letter-spacing: 0.03em;
  white-space: nowrap;
}
.quest-lesson-dot--mobile {
  width: 20px;
  height: 20px;
  border-width: 3px;
}

/* Phone composition: keep the map and boss encounter visible early, while
   preserving every destination in a compact horizontal nav. */
@media (max-width: 600px) {
  .quest-nav {
    gap: 10px;
    padding: 14px 16px 10px;
  }
  .quest-nav__brand {
    gap: 10px;
  }
  .quest-nav__mark {
    width: 40px;
    height: 40px;
    border-radius: 12px;
  }
  .quest-nav__wordmark {
  }
  .quest-lesson .quest-rail__item-meta { display: none; }
  .quest-hub .quest-rail {
    width: 100%;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    overflow-x: auto;
    margin-inline: -20px;
    padding: 0 20px 12px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .quest-hub .quest-rail::-webkit-scrollbar { display: none; }
  .quest-hub .quest-rail__back { display: inline-flex; flex: 0 0 auto; align-self: center; }
  .quest-hub .quest-rail__title,
  .quest-hub .quest-rail__eyebrow { display: none; }
  .quest-hub .quest-rail__group { display: contents; }
  .quest-hub .quest-rail__group-title {
    flex: 0 0 auto;
    align-self: center;
    margin: 0;
    padding: 8px 10px;
    max-width: 72px;
    font-size: 10px;
  }
  .quest-hub .quest-rail__list { display: contents; }
  .quest-hub .quest-rail__item {
    flex: 0 0 210px;
    min-height: 72px;
    scroll-snap-align: start;
  }
  .quest-hub-hero { flex-direction: column; align-items: flex-start; }
  .quest-hub-gallery,
  .quest-hub-gallery--animals { grid-template-columns: 1fr 1fr; }
  .quest-hub .quest-section { padding: 32px 16px; }
  .quest-check__choices { flex-direction: column; }
  .quest-rating { flex-direction: column; }
  .quest-glossary__master { width: 100%; }
}

@media (prefers-reduced-motion: reduce) {
  .quest-check--shake,
  .quest-check--pulse,
  .quest-hub-gate[data-state='glow'],
  .quest-star.is-on.is-filled,
  .quest-hub-ring__fill,
  .quest-steps li.is-current {
    animation: none;
    transition: none;
  }
  .quest-star { opacity: 1; transform: none; }
  .quest-steps li.is-current { transform: none; }
}


/* === WP3: gamification === */
.quest-map-wrap { overflow-x: clip; }
.quest-hud__name { text-transform: uppercase; }
.quest-hud__xp-caption { text-transform: uppercase; }
.quest-hud__avatar svg { width: 100%; height: 100%; }
.quest-hud__stat-label { display: inline-flex; align-items: center; gap: 4px; }
.quest-hud__flame { display: block; }
.quest-hud__stat.is-pop .quest-hud__stat-value,
.quest-hud__stat.is-pop .quest-hud__flame,
.quest-hud__stat--pink.is-pop .quest-hud__stat-value {
  animation: quest-flame-pop 0.55s var(--quest-ease);
}
@keyframes quest-flame-pop {
  0% { transform: scale(1); }
  40% { transform: scale(1.32); }
  100% { transform: scale(1); }
}

.quest-hud__row {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 12px;
  align-items: center;
}
.quest-hud__ticket {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 88px;
  padding: 12px 14px;
  border-radius: 18px;
  background: var(--quest-mango);
  color: var(--quest-ink);
}
.quest-hud__ticket-eye {
  display: block;
  font: 800 12px/1.2 var(--quest-font-label);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.quest-hud__ticket-sub {
  display: block;
  font-family: var(--quest-font-display);
  font-size: 18px;
  line-height: 1.1;
}

.quest-ring {
  display: grid;
  grid-template-columns: 88px;
  grid-template-rows: 88px auto;
  justify-items: center;
  justify-content: center;
  gap: 4px;
  min-width: 96px;
}
.quest-ring__svg {
  width: 88px;
  height: 88px;
  grid-column: 1;
  grid-row: 1;
}
.quest-ring__track { stroke: var(--quest-palm-shadow); }
.quest-ring__fill {
  stroke: var(--quest-lime);
  stroke-linecap: round;
  transition: stroke-dashoffset 0.8s var(--quest-ease);
}
.quest-ring__value {
  grid-column: 1;
  grid-row: 1;
  align-self: center;
  font-family: var(--quest-font-display);
  font-size: 16px;
  color: var(--quest-lime);
}
.quest-ring__label {
  grid-column: 1;
  grid-row: 2;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-align: center;
  color: var(--quest-cream);
  max-width: 12ch;
  line-height: 1.2;
}

.quest-lesson-dot__pips {
  position: absolute;
  left: 50%;
  top: calc(100% + 3px);
  display: flex;
  gap: 2px;
  transform: translateX(-50%);
}
.quest-lesson-dot__pips span {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: rgba(255, 246, 229, 0.35);
}
.quest-lesson-dot__pips span.is-lit { background: var(--quest-mango); }
.quest-lesson-dot--locked .quest-lesson-dot__pips { display: none; }

.quest-node__flag { display: none; }
.quest-node--current .quest-node__flag { display: flex; }
.quest-map-mobile__flag { display: none; }
.quest-map-mobile__node--current .quest-map-mobile__flag { display: block; }

.quest-node__check,
.quest-node__lock,
.quest-map-mobile__check {
  display: none;
  position: absolute;
  inset: 0;
  align-items: center;
  justify-content: center;
}
.quest-node--done .quest-node__check,
.quest-map-mobile__node--done .quest-map-mobile__check { display: flex; }
.quest-node--locked .quest-node__lock,
.quest-map-mobile__node--locked .quest-node__lock { display: flex; }
.quest-node--locked .quest-node__photo,
.quest-map-mobile__node--locked .quest-map-mobile__photo,
.quest-node--current .quest-node__badge,
.quest-node--done .quest-node__badge,
.quest-node--locked .quest-node__badge,
.quest-map-mobile__node--current .quest-node__badge,
.quest-map-mobile__node--done .quest-node__badge,
.quest-map-mobile__node--locked .quest-node__badge { display: none; }

.quest-node:hover .quest-node__circle { transform: scale(1.06); }
.quest-node--locked { cursor: default; }
.quest-node--locked:hover .quest-node__circle { transform: none; }

.quest-gate--dim { opacity: 0.45; }
.quest-gate--glow .quest-gate__shape,
.quest-gate--glow .quest-map-mobile__gate-shape {
  animation: quest-wp3-gate-glow 1.8s ease-in-out infinite;
}
@keyframes quest-wp3-gate-glow {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.06); }
}
.quest-gate--open .quest-gate__shape,
.quest-gate--open .quest-map-mobile__gate-shape {
  background: var(--quest-lime);
  box-shadow: 0 10px 0 var(--quest-lime-shadow);
}

.quest-mascot--inline {
  position: static;
  flex-direction: row;
  align-items: center;
  gap: 16px;
  margin: 0 0 24px;
}
.quest-mascot--inline .quest-mascot__figure {
  width: 96px;
  height: 96px;
}
.quest-mascot--inline .quest-mascot__figure svg {
  width: 56px;
  height: 56px;
}
.quest-mascot--compact .quest-mascot__name { display: none; }

.quest-levelup {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: grid;
  place-items: center;
  padding: 24px;
  background: rgba(11, 46, 36, 0.84);
  opacity: 0;
  pointer-events: none;
}
.quest-levelup.is-visible {
  opacity: 1;
  pointer-events: auto;
  transition: opacity 0.35s var(--quest-ease);
}
.quest-levelup__panel {
  width: min(440px, calc(100vw - 32px));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 28px 24px 24px;
  border-radius: 32px;
  background: var(--quest-deep-leaf);
  border: 4px solid var(--quest-lime);
  color: var(--quest-cream);
  text-align: center;
  cursor: pointer;
}
.quest-levelup__panel .quest-mascot--inline {
  flex-direction: column;
  margin: 0 0 8px;
}
.quest-levelup__eyebrow {
  font: 800 12px/1.2 var(--quest-font-label);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--quest-mango);
}
.quest-levelup__title {
  font-family: var(--quest-font-display);
  font-size: clamp(36px, 8vw, 56px);
  line-height: 1;
  color: var(--quest-lime);
}
.quest-levelup.is-visible .quest-levelup__title {
  animation: quest-stamp 0.7s var(--quest-ease) both;
}
@keyframes quest-stamp {
  0% { transform: scale(1.35); opacity: 0; }
  60% { transform: scale(0.96); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}
.quest-levelup__bira { font-weight: 800; color: var(--quest-cream); }
.quest-levelup__panel:has([data-bira-line]) .quest-levelup__bira { display: none; }
.quest-levelup__hint { color: var(--quest-muted); font-size: 14px; }

.quest-patch-unlock {
  position: fixed;
  right: 16px;
  bottom: 64px;
  z-index: 70;
  transform: translateX(120%);
  opacity: 0;
  pointer-events: none;
}
.quest-patch-unlock.is-visible {
  transform: translateX(0);
  opacity: 1;
  transition: transform 0.45s var(--quest-ease), opacity 0.45s var(--quest-ease);
}
.quest-patch-unlock__card {
  display: flex;
  align-items: center;
  gap: 14px;
  width: min(320px, calc(100vw - 32px));
  padding: 14px 16px;
  border-radius: 24px;
  background: var(--quest-deep-leaf);
  border: 3px solid var(--quest-mango);
  color: var(--quest-cream);
}
.quest-patch-unlock__eyebrow {
  font: 800 11px/1.2 var(--quest-font-label);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--quest-mango);
}
.quest-patch-unlock__title {
  font-family: var(--quest-font-display);
  font-size: 24px;
  line-height: 1.05;
}
.quest-patch-unlock__sub { color: var(--quest-muted); font-size: 14px; font-weight: 700; }

.quest-patch { display: block; overflow: visible; }
.quest-patch.is-stitching .quest-patch__stitch {
  animation: quest-stitch 1.2s ease forwards;
}
@keyframes quest-stitch {
  to { stroke-dashoffset: 0; }
}

.quest-star-burst {
  position: fixed;
  z-index: 75;
  display: flex;
  gap: 6px;
  pointer-events: none;
  transform: translate(-50%, -130%);
}
.quest-star-burst__star {
  width: 28px;
  height: 28px;
  opacity: 0.22;
  transform: scale(0.7);
}
.quest-star-burst__star svg { width: 100%; height: 100%; fill: #ffb238; }
.quest-star-burst__star.is-lit {
  opacity: 1;
  transform: scale(1);
  transition: opacity 0.2s var(--quest-ease), transform 0.2s var(--quest-ease);
}

.quest-me .quest-hud { margin: 0 0 22px; }
.quest-me__card { margin-top: 18px; }
.quest-me__level-eye {
  font: 800 12px/1.2 var(--quest-font-label);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--quest-mango);
  margin: 0 0 4px;
}
.quest-me__bira {
  font-weight: 800;
  color: var(--quest-cream);
  margin: 0 0 10px;
}
.quest-me__stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: var(--quest-palm-shadow);
  overflow: hidden;
}
.quest-ready-list__fill {
  display: block;
  height: 100%;
  width: 100%;
  border-radius: 999px;
  background: var(--quest-lime);
  transform: scaleX(0);
  transform-origin: left center;
}

.quest-corda-log { display: grid; gap: 10px; margin-top: 12px; }
.quest-corda-log li {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 800;
  color: var(--quest-cream);
}
.quest-corda-log__swatch {
  width: 28px;
  height: 10px;
  border-radius: 5px;
  flex-shrink: 0;
}

@media (max-width: 600px) {
  .quest-hud__row { grid-template-columns: 1fr; }
  .quest-hud__ticket { min-height: 64px; }
  .quest-patch-wall { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .quest-patch-wall__title { font-size: 13px; }
  .quest-me__stats { grid-template-columns: 1fr; }
  .quest-patch-unlock { left: 16px; right: 16px; bottom: 58px; }
  .quest-patch-unlock.is-visible { transform: translateY(0); }
  .quest-patch-unlock { transform: translateY(120%); }
  .quest-mascot--inline { flex-wrap: wrap; justify-content: center; }
}

@media (prefers-reduced-motion: reduce) {
  .quest-gate--glow .quest-gate__shape,
  .quest-gate--glow .quest-map-mobile__gate-shape,
  .quest-levelup.is-visible .quest-levelup__title,
  .quest-patch.is-stitching .quest-patch__stitch,
  .quest-hud__stat.is-pop .quest-hud__stat-value,
  .quest-hud__stat.is-pop .quest-hud__flame {
    animation: none;
  }
  .quest-patch__stitch { stroke-dashoffset: 0; }
}

/* === WP4: accounts === */
.quest-form__ok {
  background: var(--quest-lime);
  color: var(--quest-ink);
  padding: 12px 16px;
  border-radius: 12px;
  font-weight: 700;
  margin-bottom: 16px;
}
.quest-btn--danger {
  background: var(--quest-hibiscus);
  color: var(--quest-cream);
  box-shadow: 0 6px 0 #c4335c;
}
.quest-btn--danger:active { box-shadow: 0 2px 0 #c4335c; }
.quest-card--danger { border-color: var(--quest-hibiscus); }
.quest-toggle {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  margin: 8px 0 16px;
  color: var(--quest-cream);
  font-size: 16px;
  line-height: 1.4;
  color: var(--quest-muted);
  font-size: 16px;
  line-height: 1.5;
}
.quest-faq__a strong {
  color: var(--quest-mango);
}

.quest-field__input--area {
  min-height: 140px;
  padding: 14px 16px;
  resize: vertical;
  line-height: 1.45;
}
select.quest-field__input {
  appearance: none;
  background-image: linear-gradient(45deg, transparent 50%, var(--quest-lime) 50%),
    linear-gradient(135deg, var(--quest-lime) 50%, transparent 50%);
  background-position: calc(100% - 22px) 50%, calc(100% - 16px) 50%;
  background-size: 6px 6px, 6px 6px;
  background-repeat: no-repeat;
  padding-right: 40px;
}
.quest-form__ok {
  background: var(--quest-lime);
  color: var(--quest-ink);
  padding: 12px 16px;
  border-radius: 12px;
  font-weight: 700;
  margin-bottom: 16px;
}

.quest-card__body a {
  color: var(--quest-lime);
}
.quest-card__body a:hover {
  color: var(--quest-cream);
}

.quest-media-year {
  margin-bottom: 40px;
}
.quest-media-year__title {
  font-size: 28px;
  color: var(--quest-mango);
  margin: 0 0 16px;
}

.quest-cordas-track--page {
  flex-wrap: wrap;
  margin-top: 8px;
}

.quest-latest {
  max-width: 860px;
}
.quest-latest .yt-embed {
  border-radius: 20px;
  overflow: hidden;
  border: 4px solid var(--quest-ink);
}
.quest-yt-lite {
  position: relative;
  display: block;
  width: 100%;
  padding: 0;
  border: 4px solid var(--quest-ink);
  border-radius: 20px;
  overflow: hidden;
  cursor: pointer;
  background: var(--quest-deep-leaf);
  color: var(--quest-cream);
}
.quest-yt-lite img {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
}
.quest-yt-lite__play {
  position: absolute;
  inset: 50% auto auto 50%;
  transform: translate(-50%, -50%);
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: var(--quest-mango);
  color: var(--quest-ink);
  display: grid;
  place-items: center;
  box-shadow: 0 6px 0 var(--quest-mango-shadow);
}
.quest-yt-lite:hover .quest-yt-lite__play {
  background: var(--quest-lime);
}
.quest-latest .quest-video-card__credit {
  margin-top: 10px;
}

.quest-shop-price {
  margin-bottom: 18px;
}

@media (max-width: 900px) {
  .quest-public-stops--four {
    grid-template-columns: 1fr 1fr;
  }
  .quest-nav__more {
    margin-left: auto;
  }
}

@media (max-width: 600px) {
  .quest-public-stops,
  .quest-public-stops--four {
    grid-template-columns: 1fr;
  }
  .quest-more-backdrop:not([hidden]) {
    display: block;
  }
  .quest-more-panel {
    position: fixed;
    top: unset;
    right: 0;
    left: 0;
    bottom: 0;
    min-width: 0;
    max-height: 80vh;
    overflow: auto;
    border-radius: 24px 24px 0 0;
    padding: 22px 20px 28px;
  }
  .quest-more-panel__close {
    display: block;
    width: 100%;
  }
  .quest-hero__actions {
    grid-template-columns: 1fr;
  }
  .quest-videos {
    grid-template-columns: 1fr;
  }
  .quest-gallery.gallery {
    grid-template-columns: 1fr 1fr;
  }
  .quest-nav__more-btn {
    padding: 8px 12px;
    font-size: 12px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .quest-nav__more-caret,
  .quest-stop-card,
  .quest-gallery .gallery__img {
    transition: none;
  }
  .quest-stop-card:hover {
    transform: none;
  }
}

/* === WP6: coach === */
.quest-screen--wide { max-width: 1180px; }
.quest-coach-nav { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 28px; }
.quest-coach-nav a { min-height: 40px; padding: 8px 14px; border-radius: 999px; border: 3px solid var(--quest-leaf-border); color: var(--quest-cream); font: 800 12px/1 var(--quest-font-label); letter-spacing: .08em; text-transform: uppercase; display: inline-flex; align-items: center; }
.quest-coach-nav a[aria-current="page"] { background: var(--quest-lime); color: var(--quest-ink); border-color: var(--quest-lime); }
.quest-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 18px; }
.quest-stat-card { background: var(--quest-deep-leaf); border: 3px solid var(--quest-mango); border-radius: var(--quest-radius-lg); padding: 18px; }
.quest-stat-card__value { font-family: var(--quest-font-display); font-size: 36px; color: var(--quest-lime); margin: 0; }
.quest-stat-card__label { color: var(--quest-muted); font: 800 12px/1.3 var(--quest-font-label); letter-spacing: .08em; text-transform: uppercase; margin: 6px 0 0; }
.quest-buckets { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; align-items: end; min-height: 140px; margin-top: 12px; }
.quest-buckets__col { display: grid; justify-items: center; gap: 6px; }
.quest-buckets__bar { display: block; width: 100%; min-height: 8px; background: var(--quest-mango); border-radius: 8px 8px 0 0; }
.quest-buckets__n { color: var(--quest-cream); font: 800 14px/1 var(--quest-font-label); }
.quest-buckets__label { color: var(--quest-muted); font-size: 11px; }
.quest-quiet { margin: 8px 0 0; padding: 0; list-style: none; display: grid; gap: 6px; }
.quest-quiet a { color: var(--quest-mango); }
.quest-table-wrap { overflow: visible; }
.quest-roster-link { display: inline-flex; align-items: center; gap: 10px; color: var(--quest-cream); }
.quest-roster-ava { display: inline-flex; }
.quest-roster-ava svg { display: block; }
.quest-coach-hero { display: flex; gap: 18px; align-items: center; margin-bottom: 18px; }
.quest-coach-hero__apelido { font-family: var(--quest-font-display); font-size: 36px; color: var(--quest-cream); margin: 0; }
.quest-checks { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 8px; }
.quest-checks__item { display: flex; gap: 10px; align-items: flex-start; color: var(--quest-muted); }
.quest-check__mark { width: 18px; height: 18px; border-radius: 50%; border: 3px solid var(--quest-leaf-border); flex: 0 0 18px; margin-top: 2px; }
.quest-checks__item.is-met { color: var(--quest-cream); }
.quest-checks__item.is-met .quest-check__mark { background: var(--quest-lime); border-color: var(--quest-lime); }
.quest-xp-form, .quest-note-form { margin-top: 18px; }
.quest-xp-row { display: grid; grid-template-columns: 100px 1fr auto; gap: 10px; align-items: center; }
.quest-timeline { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 10px; }
.quest-timeline li { display: grid; gap: 2px; padding-bottom: 10px; border-bottom: 1px solid var(--quest-leaf-border); }
.quest-timeline__when { color: var(--quest-muted); font: 800 11px/1 var(--quest-font-label); letter-spacing: .08em; text-transform: uppercase; }
.quest-dialog { border: 0; padding: 0; background: transparent; max-width: 480px; width: calc(100% - 32px); }
.quest-dialog::backdrop { background: rgba(11, 46, 36, .72); }
.quest-dialog__card { background: var(--quest-deep-leaf); border: 3px solid var(--quest-leaf-border); border-radius: var(--quest-radius-lg); padding: 24px; color: var(--quest-cream); }
.quest-attend-bar { display: grid; grid-template-columns: 1fr 1fr auto; gap: 16px; align-items: end; }
.quest-player-card.is-stamped { border-color: var(--quest-lime); box-shadow: inset 0 0 0 3px var(--quest-lime); }
.quest-player-card.is-stamped .quest-player-card__meta { color: var(--quest-lime); }
.quest-class-bar { position: sticky; top: 0; z-index: 60; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 16px; background: var(--quest-mango); color: var(--quest-ink); font: 800 13px/1.2 var(--quest-font-label); letter-spacing: .04em; }
.quest-class-bar__end { min-height: 36px; padding: 0 14px; border-radius: 999px; border: 0; background: var(--quest-ink); color: var(--quest-cream); font: 800 12px/1 var(--quest-font-label); cursor: pointer; }
body.has-class-mode .quest-page { padding-top: 0; }
.quest-desafio-ticket { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 14px; padding: 12px 14px; border-radius: 16px; background: var(--quest-mango); color: var(--quest-ink); text-decoration: none; }
.quest-desafio-ticket[data-done="true"] { background: var(--quest-lime); }
.quest-desafio-ticket__label { font: 800 12px/1 var(--quest-font-label); letter-spacing: .08em; text-transform: uppercase; }
.quest-desafio-ticket__state { font-family: var(--quest-font-display); font-size: 18px; }
.quest-desafio-photo { width: 100%; height: auto; border-radius: 16px; margin: 12px 0; display: block; }
.quest-quiz-choices { display: grid; gap: 10px; margin-top: 12px; }
.quest-desafio-meaning { margin: 12px 0; color: var(--quest-cream); }
.quest-order-pool { display: grid; gap: 8px; margin-top: 12px; }
.quest-order-picked { margin: 12px 0 0; padding-left: 20px; color: var(--quest-lime); }
.quest-berimbau { text-align: center; }
.quest-berimbau__svg { width: 180px; height: 180px; margin: 12px auto; display: block; }
.quest-berimbau__n { font: 800 14px/1 var(--quest-font-label); letter-spacing: .06em; text-transform: uppercase; color: var(--quest-mango); }
.quest-lb { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 8px; }
.quest-lb__row { display: grid; grid-template-columns: 28px 40px 1fr auto; gap: 10px; align-items: center; padding: 8px 10px; border-radius: 12px; }
.quest-lb__row.is-you { background: var(--quest-palm-shadow); outline: 2px solid var(--quest-lime); }
.quest-lb__rank { font: 800 14px/1 var(--quest-font-label); color: var(--quest-muted); }
.quest-lb__name { color: var(--quest-cream); font-weight: 800; }
.quest-lb__xp { font-variant-numeric: tabular-nums; color: var(--quest-mango); }
.quest-role-card + .quest-role-card { margin-top: 14px; }
.quest-role-card__name { font-family: var(--quest-font-display); font-size: 24px; margin: 0 0 4px; }
.quest-programs { border: 0; padding: 0; margin: 0 0 12px; display: grid; gap: 8px; }
.quest-programs label { color: var(--quest-cream); display: flex; gap: 8px; align-items: center; }
@media (max-width: 860px) {
  .quest-stats { grid-template-columns: 1fr 1fr; }
  .quest-attend-bar { grid-template-columns: 1fr; }
  .quest-xp-row { grid-template-columns: 1fr; }
  .quest-table--roster thead { display: none; }
  .quest-table--roster tr { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 12px; padding: 12px 0; border-bottom: 1px solid var(--quest-leaf-border); }
  .quest-table--roster td { border: 0; padding: 2px 0; }
  .quest-table--roster td::before { content: attr(data-label) " · "; color: var(--quest-muted); font: 800 11px/1 var(--quest-font-label); letter-spacing: .08em; text-transform: uppercase; }
  .quest-table--roster td:first-child { grid-column: 1 / -1; }
}
@media (prefers-reduced-motion: reduce) {
  .quest-berimbau__svg circle:nth-of-type(2) { transition: none; }
  .quest-desafio-ticket { transition: none; }
}

/* === WP7: qa === */
.quest-hud__ticket[data-done="true"] { background: var(--quest-lime); }
.quest-player-card:focus-visible {
  outline: 3px solid var(--quest-lime);
  outline-offset: 3px;
}
.yt-with-credit { width: 100%; }
.yt-with-credit .quest-video-credit { margin: 8px 0 0; }
/* Home "latest" is a full-width lite YouTube, not the map's 112px chip. */
.quest-section--latest .quest-latest {
  display: block;
  grid-template-columns: none;
  padding: 0;
  border: 0;
  background: transparent;
}
.quest-video-credit,
.quest-video-card__credit,
.quest-footer__note {
  color: var(--quest-cream);
}

