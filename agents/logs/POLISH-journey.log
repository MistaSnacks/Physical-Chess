/* ---------------------------------------------------------------------
   theme.css — Roda Quest. All visual styling for the /quest route lives
   here. tokens.css supplies the palette/type/radii variables.
   --------------------------------------------------------------------- */

body.direction-quest {
  background: var(--quest-palm-shadow);
  color: var(--quest-cream);
  font-family: var(--quest-font-body);
  overflow-x: hidden;
}

body.direction-quest h1,
body.direction-quest h2,
body.direction-quest h3 {
  font-family: var(--quest-font-display);
  font-weight: 400;
  margin: 0;
}

body.direction-quest .wrap {
  max-width: 1360px;
}

body.direction-quest img {
  display: block;
}

/* ---------------------------------------------------------------------
   View transitions — "fade through palm shadow"
   --------------------------------------------------------------------- */
html:has(body.direction-quest) {
  background: var(--quest-palm-shadow);
}

::view-transition-old(root) {
  animation: quest-vt-out 0.32s ease-in both;
}
::view-transition-new(root) {
  animation: quest-vt-in 0.38s ease-out 0.28s both;
}
@keyframes quest-vt-out {
  to {
    opacity: 0;
    transform: scale(0.99);
  }
}
@keyframes quest-vt-in {
  from {
    opacity: 0;
    transform: scale(1.01);
  }
}

/* ---------------------------------------------------------------------
   Layout scaffolding
   --------------------------------------------------------------------- */
.quest-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: clip;
}

.quest-stars {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.quest-stagelight {
  position: absolute;
  border-radius: 999px;
  opacity: 0.9;
  pointer-events: none;
  z-index: 0;
}
.quest-stagelight--a {
  width: 900px;
  height: 900px;
  background: var(--quest-deep-leaf);
  top: -420px;
  right: -300px;
}
.quest-stagelight--b {
  width: 620px;
  height: 620px;
  background: #123a2e;
  bottom: -280px;
  left: -220px;
}

/* ---------------------------------------------------------------------
   Nav
   --------------------------------------------------------------------- */
.quest-nav {
  position: relative;
  z-index: 5;
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  z-index: 41;
  min-width: 220px;
  padding: 14px;
  background: var(--quest-deep-leaf);
  border: 3px solid var(--quest-leaf-border);
  border-radius: 20px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.quest-more-panel__title {
  font: 800 11px/1 var(--quest-font-label);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--quest-mango);
  margin: 0 8px 8px;
}
.quest-more-panel__link {
  display: block;
  padding: 12px 14px;
  border-radius: 12px;
  color: var(--quest-cream);
  font-weight: 800;
  font-size: 15px;
}
.quest-more-panel__link:hover,
.quest-more-panel__link[aria-current='page'] {
  background: var(--quest-palm-shadow);
  color: var(--quest-lime);
}
.quest-more-panel__close {
  display: none;
  margin-top: 10px;
  min-height: 48px;
  border: 3px solid var(--quest-leaf-border);
  border-radius: 999px;
  background: transparent;
  color: var(--quest-cream);
  font: 800 14px/1 var(--quest-font-label);
  cursor: pointer;
}
body.quest-more-open {
  overflow: hidden;
}

.quest-hero__poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.quest-hero__video {
  opacity: 0;
}
.quest-hero__video[src] {
  opacity: 0.55;
}
.quest-hero__contact {
  font-weight: 700;
  font-size: 14px;
