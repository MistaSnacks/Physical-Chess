# --- Public (shipped to the browser) ---
# OAuth app Client ID from Wix dashboard → Settings → Headless settings.
# Leave empty to run in demo mode.
PUBLIC_WIX_CLIENT_ID=
# Force demo mode even with a client ID (1 = demo).
PUBLIC_DEMO=1
PUBLIC_RECAPTCHA_SITE_KEY=

# --- Server only (Vercel env; never in the browser) ---
WIX_SITE_ID=93f9dffd-79fb-4bea-94fa-810eef3397fe
WIX_CLIENT_SECRET=
SESSION_COOKIE_SECRET=
RECAPTCHA_SECRET=
RESEND_API_KEY=
EXPORT_SECRET=
APP_ORIGIN=http://localhost:4321
